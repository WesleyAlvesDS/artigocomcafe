# Artigocomcafe.com - htaccess para Astro (estático)
# Site estático gerado pelo Astro + React

# Página inicial
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Se o arquivo/diretório existe, serve direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [L]

# Páginas HTML do Astro (sem extensão)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/?$ /$1.html [L]

# Redirecionar /index para /
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# Página 404 customizada
ErrorDocument 404 /404.html

# Cache de assets estáticos (1 ano)
<FilesMatch "\.(js|css|svg|webp|png|jpg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache de HTML (0s - sempre fresco)
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Compressão
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml image/x-icon
</IfModule>

# Segurança
<FilesMatch "^.*\.(htaccess|htpasswd|ini|log|sh|inc|bak|sql)$">
Require all denied
</FilesMatch>
Options -Indexes

# Segurança de headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
