---
import NewsletterForm from './NewsletterForm'
---

<section class="hero" transition:name="hero-section" transition:animate="none" data-hero>
  <!-- Camadas de fundo (parallax em velocidades diferentes) -->
  <div class="hero-bg" aria-hidden="true">
    <!-- Imagem imersiva: cobre a lateral direita, ancorada ao topo (paralela ao texto) -->
    <img
      src="/images/artigo-com-cafe-hero-background.webp"
      alt=""
      width="1200"
      height="1072"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-bg-img"
    />
    <!-- Scrim de legibilidade (transição do fundo para a imagem) -->
    <div class="hero-bg-scrim"></div>
    <div class="hero-aurora aurora-1"></div>
    <div class="hero-aurora aurora-2"></div>
      <div class="hero-beans" data-parallax="0.06" data-hero-parallax>
        <span class="bean" style="--bean-x: 6%; --bean-y: 18%; --s: 26px;"></span>
        <span class="bean" style="--bean-x: 14%; --bean-y: 68%; --s: 18px;"></span>
        <span class="bean" style="--bean-x: 22%; --bean-y: 42%; --s: 14px;"></span>
        <span class="bean" style="--bean-x: 44%; --bean-y: 22%; --s: 20px;"></span>
        <span class="bean" style="--bean-x: 88%; --bean-y: 14%; --s: 24px;"></span>
        <span class="bean" style="--bean-x: 93%; --bean-y: 62%; --s: 16px;"></span>
        <span class="bean" style="--bean-x: 78%; --bean-y: 86%; --s: 14px;"></span>
        <span class="bean" style="--bean-x: 34%; --bean-y: 84%; --s: 18px;"></span>
        <span class="bean" style="--bean-x: 8%; --bean-y: 8%; --s: 16px;"></span>
      </div>
    </div>

    <div class="hero-content container">
      <div class="hero-text" data-parallax="0.1" data-hero-parallax>
      <div class="hero-eyebrow">
        <span class="eyebrow-rule" aria-hidden="true"></span>
        <span>SUA DOSE DIÁRIA DE CONHECIMENTO</span>
      </div>

      <h1 class="hero-title">
        ARTIGO<br /><span class="hero-title-accent">COM CAFÉ</span>
      </h1>

      <p class="hero-subtitle">
        Aqui, boas ideias ganham sabor.
        Leia, aprenda, inspire-se e compartilhe.
        Tudo isso com uma boa xícara de café.
      </p>

      <div class="hero-actions">
        <a href="#home-experience" class="btn-primary ripple magnetic" data-magnetic-strength="0.2">
          Explore
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href="/blog" class="btn-ghost ripple magnetic" data-magnetic-strength="0.16">Explorar artigos</a>
      </div>

      <div class="hero-newsletter">
        <p class="hero-newsletter-label">Receba os melhores conteúdos no seu email:</p>
        <NewsletterForm variant="hero" client:visible />
      </div>
    </div>
  </div>

  <a href="#home-experience" class="hero-scroll-indicator" aria-label="Explorar conteúdo da página">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M19 12l-7 7-7-7" />
    </svg>
    <span>Explore</span>
  </a>
</section>

<style>
  /* ── Hero editorial (modelonovo.md) ─────────────────────── */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    padding-top: 5.5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    will-change: transform, opacity, filter;
  }

  /* Imagem imersiva: ancorada ao topo, cobrindo a lateral direita */
  .hero-bg-img {
    position: absolute;
    top: 0;
    right: 0;
    width: min(66%, 960px);
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
  }

  /* Scrim de legibilidade: fundo sólido à esquerda → transparente à direita */
  .hero-bg-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-bg-primary) 0%,
      color-mix(in srgb, var(--color-bg-primary) 72%, transparent) 36%,
      transparent 66%
    );
  }

  /* Auroras suaves na paleta café */
  .hero-aurora {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    z-index: 1;
  }

  .aurora-1 {
    width: 46vw;
    height: 46vw;
    top: -18%;
    right: -8%;
    background: radial-gradient(circle, color-mix(in srgb, var(--coffee-latte) 60%, transparent), transparent 70%);
  }

  .aurora-2 {
    width: 40vw;
    height: 40vw;
    bottom: -22%;
    left: -12%;
    background: radial-gradient(circle, color-mix(in srgb, var(--coffee-gold) 32%, transparent), transparent 70%);
  }

  /* Grãos de café flutuando (elemento de marca) */
  .hero-beans {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bean {
    position: absolute;
    left: var(--bean-x);
    top: var(--bean-y);
    width: var(--s);
    height: calc(var(--s) * 1.35);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: linear-gradient(135deg, var(--coffee-gold), var(--coffee-primary));
    box-shadow: 0 4px 14px color-mix(in srgb, var(--coffee-primary) 30%, transparent);
    opacity: 0.16;
    transform: rotate(24deg);
    animation: bean-float 9s ease-in-out infinite;
    animation-delay: calc(var(--s) * -0.2s);
  }

  .bean::after {
    content: '';
    position: absolute;
    inset: 18% 40%;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--coffee-dark) 25%, transparent);
  }

  @keyframes bean-float {
    0%, 100% { transform: rotate(24deg) translateY(0); }
    50% { transform: rotate(24deg) translateY(-18px); }
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    align-items: center;
    padding-top: 2rem;
    padding-bottom: 6rem;
  }

  /* ── Coluna de texto ── */
  .hero-text {
    max-width: 640px;
    width: 100%;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.75rem;
    animation: slide-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.05s both;
  }

  .eyebrow-rule {
    display: inline-block;
    width: 44px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
    border-radius: 2px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.2vw, 6.4rem);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    margin-bottom: 1.9rem;
    animation: slide-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s both;
  }

  .hero-title-accent {
    color: var(--color-accent);
    position: relative;
    display: inline-block;
  }

  .hero-title-accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.12em;
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-accent) 35%, transparent), transparent);
    border-radius: 2px;
    z-index: -1;
  }

  .hero-subtitle {
    font-size: 1.12rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 2.4rem;
    max-width: 480px;
    animation: slide-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.25s both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    animation: slide-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
  }

  .hero-actions .btn-primary {
    padding: 0.95rem 2rem;
    border-radius: 100px;
  }

  .hero-actions .btn-ghost {
    padding: 0.95rem 2rem;
    border-radius: 100px;
    background: transparent;
  }

  .hero-newsletter {
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-bg-card-border);
    animation: slide-up 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) 0.45s both;
  }

  .hero-newsletter-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    z-index: 10;
    text-decoration: none;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    transition: color 0.25s, background 0.25s, transform 0.25s;
    cursor: pointer;
  }

  .hero-scroll-indicator:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    transform: translateX(-50%) translateY(-3px);
  }

  .hero-scroll-indicator svg {
    animation: arrow-bounce 1.6s ease-in-out infinite;
  }

  @keyframes arrow-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  .ripple {
    position: relative;
    overflow: hidden;
  }

  .ripple::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .ripple:active::after {
    opacity: 1;
    transition: opacity 0s;
  }

  /* ── Notebook / tablet (<= 1280) ── */
  @media (max-width: 1280px) {
    .hero-bg-img {
      width: min(72%, 900px);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
    }
    .hero-bg-scrim {
      background: linear-gradient(
        90deg,
        var(--color-bg-primary) 0%,
        color-mix(in srgb, var(--color-bg-primary) 78%, transparent) 44%,
        transparent 72%
      );
    }
  }

  /* ── Tablet (<= 1024): imagem vira fundo suave de tela cheia ── */
  @media (max-width: 1024px) {
    .hero-content {
      justify-content: center;
      padding-bottom: 5rem;
    }
    .hero-text {
      justify-self: center;
      text-align: center;
      max-width: 640px;
    }
    .hero-eyebrow { justify-content: center; }
    .hero-actions { justify-content: center; }
    .hero-subtitle { margin-left: auto; margin-right: auto; }

    .hero-bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      opacity: 0.4;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-bg-scrim {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-primary) 82%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-primary) 55%, transparent) 55%,
        var(--color-bg-primary) 100%
      );
    }
  }

  /* ── Mobile (<= 768) ── */
  @media (max-width: 768px) {
    .hero { padding-top: 4.5rem; }
    .hero-content { padding-bottom: 4.5rem; gap: 2rem; }
    .hero-title { font-size: clamp(2.6rem, 11vw, 3.6rem); }
    .hero-subtitle { font-size: 1rem; }
    .hero-bg-img { opacity: 0.32; }
    .hero-scroll-indicator { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bean,
    .hero-scroll-indicator svg,
    .hero-text,
    .hero-eyebrow,
    .hero-title,
    .hero-subtitle,
    .hero-actions,
    .hero-newsletter,
    .hero-bg-img,
    .hero-bg {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .bean { display: none; }
    .hero-scroll-indicator:hover {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  // ── Imersão no scroll: parallax de camadas no hero ──
  // Elementos com [data-parallax] movem em velocidades diferentes ao rolar,
  // criando profundidade e a sensação de mergulhar na página.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    if (!window.matchMedia('(pointer: fine)').matches) return

    const hero = document.querySelector('[data-hero]')
    if (!hero) return

    const layers = Array.from(hero.querySelectorAll('[data-parallax]'))
    if (layers.length === 0) return

    let ticking = false

    function update() {
      const rect = hero.getBoundingClientRect()
      const viewportH = window.innerHeight
      // Progresso de 0 (hero no topo) a 1 (hero saiu da tela)
      const progress = Math.max(0, Math.min(1, (viewportH - rect.top) / (rect.height + viewportH)))

      layers.forEach((layer) => {
        const speed = parseFloat(layer.dataset.parallax) || 0.1
        const shift = (progress - 0.15) * speed * 260
        layer.style.transform = 'translateY(' + shift.toFixed(1) + 'px)'
      })

      ticking = false
    }

    function request() {
      if (!ticking) {
        requestAnimationFrame(update)
        ticking = true
      }
    }

    window.addEventListener('scroll', request, { passive: true })
    window.addEventListener('resize', request, { passive: true })

    // Em navegação SPA o hero é recriado; o listener global continua válido
    // porque consultamos o DOM a cada frame.
    update()
  })()
</script>
