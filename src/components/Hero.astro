---
import NewsletterForm from './NewsletterForm'
---

<section class="hero" transition:name="hero-section" transition:animate="none">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient-sphere sphere-1"></div>
    <div class="hero-gradient-sphere sphere-2"></div>
    <div class="hero-gradient-sphere sphere-3"></div>
    <div class="hero-mesh-gradient"></div>
    <div class="hero-particles">
      <div class="particle" style="--x: 10%; --y: 20%; --delay: 0s; --duration: 6s;"></div>
      <div class="particle" style="--x: 25%; --y: 60%; --delay: 0.5s; --duration: 7s;"></div>
      <div class="particle" style="--x: 45%; --y: 30%; --delay: 1s; --duration: 5.5s;"></div>
      <div class="particle" style="--x: 60%; --y: 70%; --delay: 0.3s; --duration: 6.5s;"></div>
      <div class="particle" style="--x: 75%; --y: 25%; --delay: 0.8s; --duration: 7.5s;"></div>
      <div class="particle" style="--x: 85%; --y: 65%; --delay: 1.5s; --duration: 5s;"></div>
      <div class="particle" style="--x: 35%; --y: 80%; --delay: 0.2s; --duration: 6.8s;"></div>
      <div class="particle" style="--x: 55%; --y: 15%; --delay: 1.2s; --duration: 7.2s;"></div>
      <div class="particle" style="--x: 15%; --y: 45%; --delay: 0.7s; --duration: 5.8s;"></div>
      <div class="particle" style="--x: 90%; --y: 50%; --delay: 0.4s; --duration: 6.2s;"></div>
    </div>
    <div class="hero-scanlines" aria-hidden="true"></div>
  </div>
  
  <div class="hero-content container" transition:name="hero-content">
    <div class="hero-text" transition:name="hero-text">
      <div class="hero-availability" transition:name="hero-badge" transition:animate="slide">
        <span class="pulse-dot"></span>
        <span>Novos artigos toda semana</span>
      </div>
      <h1 class="hero-title" transition:name="hero-title">
        Aprenda algo novo a cada <span class="gradient-text animate-gradient">xícara de café</span>
      </h1>
      <p class="hero-subtitle" transition:name="hero-subtitle">
        Artigos profundos sobre café, cultura e tecnologia, curados para a sua pausa.
        Leia no seu ritmo, monte trilhas, ganhe grãos e acompanhe a sua evolução em cada página.
      </p>
      <div class="hero-actions" transition:name="hero-actions">
        <a href="/blog" class="btn-primary ripple magnetic" data-magnetic-strength="0.22" transition:name="hero-cta-primary">
          Explorar Artigos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a href="/sobre" class="btn-ghost ripple magnetic" data-magnetic-strength="0.18" transition:name="hero-cta-secondary">Sobre o Projeto</a>
      </div>
      <div class="hero-newsletter" transition:name="hero-newsletter">
        <p class="hero-newsletter-label">Receba os melhores conteúdos no seu email:</p>
        <NewsletterForm variant="hero" client:load />
      </div>
    </div>
    
    <div class="hero-scroll-indicator" transition:name="hero-scroll" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7" />
      </svg>
      <span>Explore</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(var(--color-accent-rgb), 0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 20%, rgba(var(--color-accent-dark-rgb), 0.1) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 80%, rgba(var(--color-accent-rgb), 0.06) 0%, transparent 55%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-mesh-gradient {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(135deg, 
        rgba(var(--color-accent-rgb), 0.03) 0%, 
        transparent 40%, 
        rgba(var(--color-accent-secondary-rgb), 0.03) 100%);
    opacity: 0;
    animation: mesh-fade-in 3s ease-out 0.5s forwards;
  }

  @keyframes mesh-fade-in {
    to { opacity: 1; }
  }

  .hero-gradient-sphere {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0;
    animation: float-gentle 12s ease-in-out infinite;
    animation-fill-mode: backwards;
    will-change: transform, opacity;
  }

  .hero-gradient-sphere.sphere-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle at 30% 30%, rgba(var(--color-accent-rgb), 0.18), transparent 70%);
    top: -15%;
    left: -10%;
    animation-delay: 0s;
  }

  .hero-gradient-sphere.sphere-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle at 70% 70%, rgba(var(--color-accent-secondary-rgb), 0.16), transparent 70%);
    bottom: -10%;
    right: 15%;
    animation-delay: -4s;
  }

  .hero-gradient-sphere.sphere-3 {
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.1), transparent 70%);
    top: 35%;
    left: 65%;
    animation-delay: -8s;
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
    left: var(--x);
    top: var(--y);
    animation: float-particle var(--duration, 6s) ease-in-out infinite;
    animation-delay: var(--delay);
    will-change: transform, opacity;
  }

  .particle::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border-radius: 50%;
    background: inherit;
    filter: blur(1.5px);
    opacity: 0.4;
  }

  @keyframes float-particle {
    0%, 100% { 
      transform: translateY(0) translateX(0) scale(1); 
      opacity: 0; 
    }
    8% { opacity: 0.6; }
    15% { opacity: 1; }
    50% { 
      transform: translateY(-50px) translateX(20px) scale(1.2); 
      opacity: 0.8; 
    }
    85% { opacity: 1; }
    92% { opacity: 0.6; }
  }

  .hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.02) 2px,
      rgba(0,0,0,0.02) 4px
    );
    pointer-events: none;
    opacity: 0.3;
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding-top: 7rem;
    padding-bottom: 5rem;
  }

  .hero-text {
    max-width: 720px;
  }

  .hero-availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    background: var(--color-glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-glass-border);
    box-shadow: var(--shadow-glow);
    animation: slide-up 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s both;
  }

  .hero-title {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin-bottom: 1.75rem;
    letter-spacing: -0.03em;
    font-family: var(--font-serif);
    animation: text-reveal 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s both;
  }

  .hero-title .gradient-text {
    background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to), var(--gradient-from));
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    max-width: 580px;
    animation: text-reveal 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
    animation: text-reveal 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s both;
  }

  .hero-newsletter {
    padding-top: 2rem;
    border-top: 1px solid var(--color-bg-card-border);
    animation: text-reveal 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.65s both;
  }

  .hero-newsletter-label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    animation: bounce 2.5s ease-in-out infinite;
    animation-delay: 1.2s;
  }

  .hero-scroll-indicator svg {
    animation: arrow-bounce 1.5s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
    40% { transform: translateX(-50%) translateY(-8px); }
    60% { transform: translateX(-50%) translateY(-4px); }
  }

  @keyframes arrow-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  .ripple {
    position: relative;
    overflow: hidden;
  }

  .ripple::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .ripple:active::after {
    opacity: 1;
    transition: opacity 0s;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100dvh;
      padding-bottom: 4rem;
    }
    .hero-content {
      padding-top: 5rem;
      padding-bottom: 3rem;
    }
    .hero-title {
      font-size: clamp(2.2rem, 8vw, 3.5rem);
    }
    .hero-subtitle {
      font-size: 1.05rem;
    }
    .hero-gradient-sphere.sphere-1 { width: 300px; height: 300px; }
    .hero-gradient-sphere.sphere-2 { width: 250px; height: 250px; }
    .hero-gradient-sphere.sphere-3 { width: 180px; height: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-gradient-sphere,
    .particle,
    .hero-scroll-indicator,
    .hero-title,
    .hero-subtitle,
    .hero-availability,
    .hero-actions,
    .hero-newsletter {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-gradient-sphere { opacity: 0.3; }
  }
</style>