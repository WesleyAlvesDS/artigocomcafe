<div id="lazy-related-container" class="lazy-related-container">
  <div class="related-skeleton" aria-hidden="true">
    <div class="related-skeleton-item"></div>
    <div class="related-skeleton-item"></div>
    <div class="related-skeleton-item"></div>
    <div class="related-skeleton-item"></div>
  </div>
</div>

<script is:inline>
  // Lazy Related Articles Loader
  (function() {
    const container = document.getElementById('lazy-related-container');
    if (!container) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          if (el.dataset.loaded === 'true') return;
          el.dataset.loaded = 'true';

          // Remove skeleton
          const skeleton = el.querySelector('.related-skeleton');
          if (skeleton) skeleton.remove();

          // Trigger load event for parent page to handle
          el.dispatchEvent(new CustomEvent('lazy-related:load', {
            bubbles: true,
            detail: { container: el }
          }));

          observer.unobserve(el);
        }
      });
    }, {
      rootMargin: '200px 0px',
      threshold: 0.01
    });

    observer.observe(container);

    // Also listen for manual trigger from sidebar
    const relatedPlaceholder = document.getElementById('related-content');
    if (relatedPlaceholder) {
      relatedPlaceholder.addEventListener('load-related', () => {
        container.dispatchEvent(new CustomEvent('lazy-related:load', {
          bubbles: true,
          detail: { container }
        }));
      });
    }
  })();
</script>

<style is:global>
  .lazy-related-container {
    min-height: 200px;
  }

  .related-skeleton {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .related-skeleton-item {
    border-radius: var(--radius-card);
    background: linear-gradient(
      90deg,
      var(--color-bg-card) 25%,
      var(--color-bg-card-hover) 50%,
      var(--color-bg-card) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
    min-height: 320px;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .lazy-related-loaded {
    animation: fade-in-up 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>