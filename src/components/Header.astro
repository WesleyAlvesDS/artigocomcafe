---
import ThemeToggle from './ThemeToggle'
import UserMenu from './UserMenu'
import { getRecipeCategories } from '../lib/laravel'

type RecipeCat = { slug: string; name: string; icon: string | null; color: string | null; recipes_count: number }
// Cache no escopo do módulo: evita 1 request por página no build SSG (432+ páginas)
if (!globalThis.__recipeCats) {
  globalThis.__recipeCats = getRecipeCategories().catch(() => [])
}
const recipeCategories = ((await globalThis.__recipeCats) as RecipeCat[]).slice(0, 8)
---

<header class="header" transition:name="site-header" transition:animate="none">
  <div class="header-inner container">
    <a href="/" class="header-logo" aria-label="Artigo com Café - Home" transition:name="site-logo" transition:persist="site-logo">
      <span class="header-logo-icon" aria-hidden="true">&#9749;</span>
      <span class="header-logo-text">
        Artigo com <span class="gradient-text">Café</span>
      </span>
    </a>

    <nav class="header-nav" aria-label="Navegação principal" transition:name="site-nav" transition:persist="site-nav">
      <a href="/" class="nav-link" data-page="home">Início</a>
      <a href="/blog" class="nav-link" data-page="blog">Blog</a>
      <div class="nav-dropdown" data-dropdown="receitas">
        <a href="/receitas" class="nav-link" data-page="receitas" aria-haspopup="true" aria-expanded="false">
          Receitas
          <svg class="nav-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
        </a>
        <div class="dropdown-panel glass-card" role="menu">
          <div class="dropdown-head">
            <span class="dropdown-title">Explore receitas</span>
            <a href="/receitas" class="dropdown-all">Ver todas →</a>
          </div>
          <div class="dropdown-grid">
            {recipeCategories.length > 0 ? recipeCategories.map(cat => (
              <a href={`/receitas?categoria=${cat.slug}`} class="dropdown-item" role="menuitem" style={cat.color ? `--cat-color:${cat.color}` : ''}>
                <span class="dropdown-item-icon" aria-hidden="true">{cat.icon || '🍽️'}</span>
                <span class="dropdown-item-text">
                  <span class="dropdown-item-name">{cat.name}</span>
                  <span class="dropdown-item-count">{cat.recipes_count} receitas</span>
                </span>
              </a>
            )) : (
              <a href="/receitas" class="dropdown-item" role="menuitem">
                <span class="dropdown-item-icon" aria-hidden="true">🍽️</span>
                <span class="dropdown-item-text">
                  <span class="dropdown-item-name">Todas as receitas</span>
                  <span class="dropdown-item-count">Explore o acervo completo</span>
                </span>
              </a>
            )}
          </div>
          <div class="dropdown-foot">
            <a href="/receitas" class="dropdown-foot-link">🕐 Receita do Dia</a>
            <a href="/receitas" class="dropdown-foot-link">🍳 Receitas para o café</a>
          </div>
        </div>
      </div>
      <a href="/mapa" class="nav-link" data-page="mapa">Mapa</a>
      <a href="/jornada" class="nav-link" data-page="jornada">Jornada</a>
      <a href="/sobre" class="nav-link" data-page="sobre">Sobre</a>
      <a href="/contato" class="nav-link" data-page="contato">Contato</a>
    </nav>

    <div class="header-actions">
      <button class="nav-icon-btn" id="search-toggle" data-testid="search-toggle" aria-label="Buscar artigos (Ctrl+K)" title="Buscar (Ctrl+K)" type="button" transition:name="search-btn" transition:persist="search-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
      <ThemeToggle client:idle transition:name="theme-toggle" transition:persist="theme-toggle" />
      <UserMenu client:load transition:name="user-menu" transition:persist="user-menu" />
      <a href="/newsletter" class="nav-cta btn-primary" transition:name="newsletter-cta" transition:persist="newsletter-cta">Newsletter</a>
    </div>

    <button class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false" transition:name="hamburger" transition:persist="hamburger">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-hidden="true" transition:name="mobile-menu" transition:persist="mobile-menu">
    <div class="mobile-menu-head">
      <button class="mobile-icon-btn" id="search-toggle-mobile" data-testid="search-toggle-mobile" aria-label="Buscar artigos" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>Buscar</span>
      </button>
      <div class="mobile-theme"><ThemeToggle client:idle /></div>
    </div>
    <a href="/" class="mobile-link" data-page="home">Início</a>
    <a href="/blog" class="mobile-link" data-page="blog">Blog</a>
    <a href="/receitas" class="mobile-link" data-page="receitas">🍳 Receitas</a>
    <a href="/mapa" class="mobile-link" data-page="mapa">Mapa</a>
    <a href="/sobre" class="mobile-link" data-page="sobre">Sobre</a>
    <a href="/contato" class="mobile-link" data-page="contato">Contato</a>
    <a href="/newsletter" class="mobile-link btn-primary btn-block">Newsletter</a>
    <span class="mobile-section-label">Sua Jornada</span>
    <a href="/jornada" class="mobile-link" data-page="jornada">📊 Jornada</a>
    <a href="/missoes" class="mobile-link" data-page="missoes">🎯 Missões</a>
    <a href="/trilhas" class="mobile-link" data-page="trilhas">🎓 Trilhas</a>
    <a href="/conquistas" class="mobile-link" data-page="conquistas">🏆 Conquistas</a>
    <span class="mobile-section-label">Personalizado</span>
    <a href="/graos" class="mobile-link" data-page="graos">🫘 Grãos</a>
    <a href="/torrefacao" class="mobile-link" data-page="torrefacao">☕ Torrefação</a>
    <a href="/biblioteca" class="mobile-link" data-page="biblioteca">📚 Biblioteca</a>
    <a href="/perfil" class="mobile-link" data-page="perfil">👤 Perfil</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-card);
    margin: 1rem;
    transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    will-change: transform, box-shadow, background;
    contain: layout style paint;
  }

  .header.scrolled {
    background: var(--color-glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-glass-border);
    box-shadow: var(--shadow-card), 0 0 0 1px rgba(255,255,255,0.03);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    height: 68px;
    padding: 0 1.25rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .header-logo:hover {
    transform: translateY(-1px);
  }

  .header-logo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to));
    color: var(--color-btn-text);
    box-shadow: 0 0 18px color-mix(in srgb, var(--color-accent) 40%, transparent);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .header-logo:hover .header-logo-icon {
    transform: rotate(-8deg) scale(1.06);
    box-shadow: 0 0 28px color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .header-logo-text {
    font-family: var(--font-serif);
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.9rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition), background var(--transition);
    border-radius: var(--radius-button);
    white-space: nowrap;
    overflow: hidden;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    opacity: 0;
    transform: scale(0.92);
    transition: opacity var(--transition), transform var(--transition);
    z-index: -1;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: calc(100% - 1.8rem);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-accent) 70%, transparent);
    transition: transform var(--transition) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link:hover::before,
  .nav-link.active::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* ── Dropdown de Receitas ─────────────────────────── */
  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-caret {
    margin-left: 0.25rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-dropdown:hover .nav-caret,
  .nav-dropdown.open .nav-caret {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%) translateY(10px) scale(0.97);
    width: 340px;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 200;
    transition:
      opacity 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.28s;
    transform-origin: top center;
  }

  .dropdown-panel::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 16px;
    height: 16px;
    background: var(--color-bg-card);
    border-left: 1px solid var(--color-glass-border);
    border-top: 1px solid var(--color-glass-border);
    border-radius: 3px;
  }

  .nav-dropdown:hover .dropdown-panel,
  .nav-dropdown.open .dropdown-panel,
  .nav-dropdown:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .dropdown-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .dropdown-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .dropdown-all {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.25s;
  }

  .dropdown-all:hover {
    opacity: 0.8;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem;
    max-height: 260px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: background 0.2s, transform 0.2s, color 0.2s;
  }

  .dropdown-item:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .dropdown-item-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--cat-color, var(--color-accent)) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color, var(--color-accent)) 22%, transparent);
    font-size: 1rem;
  }

  .dropdown-item-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .dropdown-item-name {
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-item-count {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .dropdown-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.65rem;
    margin-top: 0.65rem;
    border-top: 1px solid var(--color-bg-card-border);
  }

  .dropdown-foot-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .dropdown-foot-link:hover {
    color: var(--color-accent);
  }

  .nav-cta {
    margin-left: 0.5rem;
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-button);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition);
  }

  .nav-icon-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-card-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .mobile-theme {
    display: flex;
    align-items: center;
  }

  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .mobile-icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-button);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
  }

  .mobile-icon-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-card-hover);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all var(--transition);
    transform-origin: center;
  }

  .hamburger.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    padding-top: 5.25rem;
    background: color-mix(in srgb, var(--color-bg-primary) 97%, transparent);
    backdrop-filter: blur(26px);
    -webkit-backdrop-filter: blur(26px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.35s;
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-menu[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 0.04s),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 0.04s);
  }

  .mobile-menu[aria-hidden="false"] > * {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-link {
    padding: 0.8rem 1rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 12px;
    transition: background var(--transition), color var(--transition), padding var(--transition), transform var(--transition);
    display: block;
    width: 100%;
    text-align: left;
  }

  .mobile-link:hover {
    background: color-mix(in srgb, var(--color-bg-card) 80%, transparent);
    color: var(--color-accent);
    padding-left: 1.35rem;
    transform: translateX(4px);
  }

  .mobile-link.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .mobile-section-label {
    display: block;
    padding: 1rem 0.5rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  @media (max-width: 1000px) {
    .header-inner { gap: 0.5rem; }
    .nav-link { padding: 0.5rem 0.65rem; font-size: 0.82rem; }
    .header-actions .nav-cta { display: none; }
    .dropdown-panel { width: 300px; }
  }

  @media (max-width: 768px) {
    .header-nav { display: none; }
    .hamburger { display: flex; }
    .header-inner { grid-template-columns: auto 1fr auto; }
    .header { margin: 0.5rem; border-radius: var(--radius-card); }
  }

  @media (min-width: 769px) {
    .mobile-menu { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .nav-link,
    .nav-link::before,
    .nav-link::after,
    .hamburger-line,
    .mobile-menu,
    .mobile-menu > *,
    .mobile-link,
    .header-logo-icon,
    .nav-icon-btn {
      transition: none !important;
      animation: none !important;
    }
    .mobile-menu[aria-hidden="false"] > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger')
  const mobileMenu = document.getElementById('mobile-menu')

  if (hamburger && mobileMenu) {
    function closeMenu() {
      hamburger.classList.remove('active')
      hamburger.setAttribute('aria-expanded', 'false')
      mobileMenu.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    function openMenu() {
      hamburger.classList.add('active')
      hamburger.setAttribute('aria-expanded', 'true')
      mobileMenu.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
    }

    hamburger.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = hamburger.classList.contains('active')
      if (isOpen) { closeMenu() } else { openMenu() }
    })

    document.addEventListener('click', (e) => {
      if (hamburger.classList.contains('active')) {
        const target = e.target
        if (target instanceof Node && !hamburger.contains(target) && !mobileMenu.contains(target)) {
          closeMenu()
        }
      }
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.classList.contains('active')) {
        closeMenu()
      }
    })

    mobileMenu.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => { closeMenu() })
    })

    Array.prototype.forEach.call(mobileMenu.children, (el, i) => {
      el.style.setProperty('--i', String(i))
    })

    document.addEventListener('astro:before-swap', closeMenu)
    document.addEventListener('astro:after-swap', () => {
      const path = window.location.pathname
      const links = document.querySelectorAll('.header-nav .nav-link, .mobile-menu .mobile-link')
      function match(href) {
        if (path === '/' && href === '/') return true
        if (path === href) return true
        if (href !== '/' && path.indexOf(href + '/') === 0) return true
        if (href === '/blog' && path.indexOf('/blog/') === 0) return true
        return false
      }
      links.forEach(function (a) {
        a.classList.remove('active')
        var href = a.getAttribute('href')
        if (href && match(href)) a.classList.add('active')
      })
    })
  }

  let lastScrollY = window.pageYOffset;
  let ticking = false;

  function updateHeader() {
    const header = document.querySelector('.header');
    if (window.pageYOffset > 10) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }

  window.addEventListener('scroll', () => {
    lastScrollY = window.pageYOffset;
    requestTick();
  }, { passive: true });

  (function () {
    var path = window.location.pathname
    var links = document.querySelectorAll('.header-nav .nav-link, .mobile-menu .mobile-link')
    function match(href) {
      if (path === '/' && href === '/') return true
      if (path === href) return true
      if (href !== '/' && path.indexOf(href + '/') === 0) return true
      if (href === '/blog' && path.indexOf('/blog/') === 0) return true
      return false
    }
    links.forEach(function (a) {
      var href = a.getAttribute('href')
      if (!href) return
      if (match(href)) a.classList.add('active')
    })
  })()

  const searchToggle = document.getElementById('search-toggle')
  const searchToggleMobile = document.getElementById('search-toggle-mobile')

  function openSearch() {
    window.dispatchEvent(new CustomEvent('search:open'))
    if (hamburger) {
      hamburger.classList.remove('active')
      hamburger.setAttribute('aria-expanded', 'false')
    }
    if (mobileMenu) {
      mobileMenu.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }
  }

  searchToggle?.addEventListener('click', openSearch)
  searchToggleMobile?.addEventListener('click', openSearch)

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault()
      openSearch()
    }
  })

  // Dropdown de receitas: fechar ao clicar fora / navegar
  const dropdown = document.querySelector('[data-dropdown="receitas"]')
  const dropdownLink = dropdown?.querySelector('.nav-link')

  function closeDropdown() {
    dropdown?.classList.remove('open')
    dropdownLink?.setAttribute('aria-expanded', 'false')
  }

  dropdown?.addEventListener('mouseenter', () => {
    dropdown.classList.add('open')
    dropdownLink?.setAttribute('aria-expanded', 'true')
  })
  dropdown?.addEventListener('mouseleave', closeDropdown)

  dropdownLink?.addEventListener('click', (e) => {
    const isOpen = dropdown.classList.contains('open')
    if (!isOpen) {
      e.preventDefault()
      dropdown.classList.add('open')
      dropdownLink.setAttribute('aria-expanded', 'true')
    }
  })

  document.addEventListener('click', (e) => {
    if (dropdown && e.target instanceof Node && !dropdown.contains(e.target)) {
      closeDropdown()
    }
  })

  document.addEventListener('astro:before-swap', closeDropdown)
</script>