---
import ThemeToggle from './ThemeToggle'
import UserMenu from './UserMenu'
import { getRecipeCategories } from '../lib/laravel'
import { mainNav, mobileSections, activeMatchRules, type NavItem } from '../data/navItems'

type RecipeCat = { slug: string; name: string; icon: string | null; color: string | null; recipes_count: number }

// Cache no escopo do módulo: evita 1 request por página no build SSG (432+ páginas).
// Sem window/globalThis duplicado no cliente — Astro re-gera o módulo por página no build.
if (!globalThis.__recipeCats) {
  globalThis.__recipeCats = getRecipeCategories().catch((err) => {
    if (import.meta.env.DEV) console.warn('[Header] falha ao carregar categorias de receitas:', err)
    return []
  })
}
const recipeCategories = ((await globalThis.__recipeCats) as RecipeCat[]).slice(0, 8)

// Estado ativo calculado no SSR (Astro.url) — o script no fim reavalia no SPA.
const pathname = Astro.url.pathname
function isActive(item: { href: string; page: string }): boolean {
  if (pathname === '/' && item.href === '/') return true
  if (pathname === item.href) return true
  if (item.href !== '/') {
    for (const rule of activeMatchRules) {
      if (item.href === rule.parent && pathname.startsWith(rule.prefix)) return true
    }
  }
  return false
}
---

<header class="header" transition:name="site-header" transition:animate="none">
  <div class="header-inner container">
    <a href="/" class="header-logo" aria-label="Artigo com Café - Home" transition:name="site-logo" transition:persist="site-logo">
      <img
        class="header-logo-img"
        src="/images/artigologo.svg"
        alt="Artigo com Café"
        width="431"
        height="578"
        loading="eager"
        fetchpriority="high"
        transition:name="site-logo-img"
        transition:persist="site-logo-img"
      />
    </a>

    <nav class="header-nav" aria-label="Navegação principal" transition:name="site-nav" transition:persist="site-nav">
      {mainNav.map(item => item.dropdown ? (
        <div class="nav-dropdown" data-dropdown={item.page}>
          <a href={item.href} class:list={['nav-link', { active: isActive(item) }]} data-page={item.page} aria-haspopup="true" aria-expanded="false" aria-controls={`dropdown-${item.page}`}>
            {item.label}
            <svg class="nav-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
          </a>
          <div class="dropdown-panel glass-card" id={`dropdown-${item.page}`} role="menu">
            <div class="dropdown-head">
              <span class="dropdown-title">{item.title}</span>
              <a href={item.href} class="dropdown-all">{item.allLabel}</a>
            </div>
            <div class="dropdown-grid">
              {recipeCategories.length > 0 ? recipeCategories.map(cat => (
                <a href={`/receitas?categoria=${cat.slug}`} class="dropdown-item" role="menuitem" style={cat.color ? `--cat-color:${cat.color}` : ''}>
                  <span class="dropdown-item-icon" aria-hidden="true">{cat.icon || item.fallback.icon}</span>
                  <span class="dropdown-item-text">
                    <span class="dropdown-item-name">{cat.name}</span>
                    <span class="dropdown-item-count">{cat.recipes_count} receitas</span>
                  </span>
                </a>
              )) : (
                <a href={item.href} class="dropdown-item" role="menuitem">
                  <span class="dropdown-item-icon" aria-hidden="true">{item.fallback.icon}</span>
                  <span class="dropdown-item-text">
                    <span class="dropdown-item-name">{item.fallback.name}</span>
                    <span class="dropdown-item-count">{item.fallback.note}</span>
                  </span>
                </a>
              )}
            </div>
            <div class="dropdown-foot">
              {item.foot.map(f => (
                <a href={item.href} class="dropdown-foot-link">{f.icon} {f.label}</a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={item.href} class:list={['nav-link', { active: isActive(item) }]} data-page={item.page}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="nav-icon-btn" id="search-toggle" data-testid="search-toggle" aria-label="Buscar artigos (Ctrl+K)" title="Buscar (Ctrl+K)" type="button" transition:name="search-btn" transition:persist="search-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </button>
      <ThemeToggle client:idle transition:name="theme-toggle" transition:persist="theme-toggle" />
      <UserMenu client:load transition:name="user-menu" transition:persist="user-menu" />
      <a href="/newsletter" class="nav-cta btn-primary" transition:name="newsletter-cta" transition:persist="newsletter-cta">Newsletter</a>
    </div>

    <button class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false" transition:name="hamburger" transition:persist="hamburger">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-hidden="true" transition:name="mobile-menu" transition:persist="mobile-menu">
    <div class="mobile-menu-head">
      <button class="mobile-icon-btn" id="search-toggle-mobile" data-testid="search-toggle-mobile" aria-label="Buscar artigos" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span>Buscar</span>
      </button>
      <div class="mobile-theme"><ThemeToggle client:idle /></div>
    </div>

    {mobileSections.map((section, si) => (
      <div class="mobile-section" data-mobile-section>
        {section.label && (
          <div class="mobile-section-head">
            <span class="mobile-section-label">{section.label}</span>
            <span class="mobile-section-lock" data-section-lock hidden>🔒</span>
          </div>
        )}
        {section.items.map((link, i) => (
          <a href={link.href} class:list={['mobile-link', { active: isActive(link) }]} data-page={link.page} data-user-only={link.userOnly || undefined}>{link.label}</a>
        ))}
        {section.label && (
          <div class="mobile-login-hint" data-login-hint hidden>
            <a href="/entrar" class="mobile-login-btn">Entrar para sincronizar sua jornada →</a>
          </div>
        )}
      </div>
    ))}

    <a href="/newsletter" class="mobile-link btn-primary btn-block">Newsletter</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-glass-border);
    transition: background var(--transition), border-color var(--transition), box-shadow var(--transition), transform var(--transition);
    will-change: transform, box-shadow, background;
    contain: layout style paint;
  }

  .header.scrolled {
    background: var(--color-glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-glass-border);
    box-shadow: var(--shadow-card), 0 0 0 1px rgba(255,255,255,0.03);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 1rem;
    min-height: 74px;
    padding: 0.6rem 1.5rem;
  }

  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    line-height: 0;
  }

  .header-logo:hover {
    transform: translateY(-1px);
  }

  .header-logo-img {
    height: 60px;
    width: auto;
    object-fit: contain;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.35s;
  }

  .header-logo:hover .header-logo-img {
    transform: scale(1.04);
  }

  /* Tema claro: o logo (desenhado p/ fundo escuro) ganha leve queda de opacidade
     para suavizar no fundo claro — mantém legibilidade premium */
  .light .header-logo-img {
    filter: drop-shadow(0 2px 6px rgba(74, 48, 34, 0.12));
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.15rem 0.1rem;
    min-width: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.95rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--transition);
    border-radius: var(--radius-button);
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: calc(100% - 1.9rem);
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* ── Dropdown (data-driven, acessível) ─────────────── */
  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-caret {
    margin-left: 0.25rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-dropdown:hover .nav-caret,
  .nav-dropdown.open .nav-caret {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    width: 340px;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 200;
    transform-origin: top center;
    transform: translateX(-50%) translateY(10px);
    transition:
      opacity 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.22s;
  }

  .dropdown-panel::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 16px;
    height: 16px;
    background: var(--color-bg-card);
    border-left: 1px solid var(--color-glass-border);
    border-top: 1px solid var(--color-glass-border);
    border-radius: 3px;
  }

  .nav-dropdown:hover .dropdown-panel,
  .nav-dropdown.open .dropdown-panel,
  .nav-dropdown:focus-within .dropdown-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .dropdown-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .dropdown-all {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.25s;
  }

  .dropdown-all:hover {
    opacity: 0.8;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.35rem;
    max-height: 260px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: background 0.2s, transform 0.2s, color 0.2s;
  }

  .dropdown-item:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .dropdown-item-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--cat-color, var(--color-accent)) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-color, var(--color-accent)) 22%, transparent);
    font-size: 1rem;
  }

  .dropdown-item-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .dropdown-item-name {
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-item-count {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .dropdown-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.65rem;
    margin-top: 0.65rem;
    border-top: 1px solid var(--color-bg-card-border);
  }

  .dropdown-foot-link {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .dropdown-foot-link:hover {
    color: var(--color-accent);
  }

  .nav-cta {
    margin-left: 0.5rem;
  }

  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-button);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition);
  }

  .nav-icon-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-card-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .mobile-theme {
    display: flex;
    align-items: center;
  }

  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .mobile-icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-button);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition);
  }

  .mobile-icon-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-bg-card-hover);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger-line {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all var(--transition);
    transform-origin: center;
  }

  .hamburger.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .hamburger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    padding-top: 5.25rem;
    background: color-mix(in srgb, var(--color-bg-primary) 97%, transparent);
    backdrop-filter: blur(26px);
    -webkit-backdrop-filter: blur(26px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.35s;
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-menu[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu > * {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 0.04s),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 0.04s);
  }

  .mobile-menu[aria-hidden="false"] > * {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .mobile-section-lock {
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .mobile-login-hint {
    padding: 0.5rem 0.5rem 0.25rem;
  }

  .mobile-login-btn {
    display: block;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px dashed color-mix(in srgb, var(--color-accent) 40%, transparent);
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: all 0.25s;
  }

  .mobile-login-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .mobile-link {
    padding: 0.8rem 1rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    border-radius: 12px;
    transition: background var(--transition), color var(--transition), padding var(--transition), transform var(--transition);
    display: block;
    width: 100%;
    text-align: left;
  }

  .mobile-link:hover {
    background: color-mix(in srgb, var(--color-bg-card) 80%, transparent);
    color: var(--color-accent);
    padding-left: 1.35rem;
    transform: translateX(4px);
  }

  .mobile-link.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .mobile-section-label {
    display: block;
    padding: 1rem 0.5rem 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  /* Área do usuário logado fica "destravada" visualmente */
  .mobile-menu.is-auth [data-user-only] {
    opacity: 1;
  }

  @media (max-width: 1240px) {
    .header-inner { gap: 0.5rem 0.75rem; }
    .nav-link { padding: 0.5rem 0.7rem; font-size: 0.85rem; }
    .header-actions .nav-cta { display: none; }
    .dropdown-panel { width: 300px; }
  }

  @media (max-width: 1000px) {
    .header-inner { gap: 0.5rem; }
    .nav-link { padding: 0.5rem 0.6rem; font-size: 0.8rem; }
    .header-actions .nav-cta { display: none; }
    .dropdown-panel { width: 300px; }
  }

  @media (max-width: 768px) {
    .header-nav { display: none; }
    .hamburger { display: flex; }
    .header-inner { grid-template-columns: auto 1fr auto; }
    .header-logo-img { height: 48px; }
  }

  @media (min-width: 769px) {
    .mobile-menu { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .nav-link,
    .nav-link::before,
    .nav-link::after,
    .hamburger-line,
    .mobile-menu,
    .mobile-menu > *,
    .mobile-link,
    .header-logo-img,
    .nav-icon-btn {
      transition: none !important;
      animation: none !important;
    }
    .mobile-menu[aria-hidden="false"] > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger')
  const mobileMenu = document.getElementById('mobile-menu')

  // ── Estado de autenticação no menu mobile ──
  function refreshAuthState() {
    if (!mobileMenu) return
    const isAuth = typeof window !== 'undefined' && !!localStorage.getItem('token')
    mobileMenu.classList.toggle('is-auth', isAuth)
    mobileMenu.querySelectorAll('[data-section-lock]').forEach(el => { el.hidden = isAuth })
    mobileMenu.querySelectorAll('[data-login-hint]').forEach(el => { el.hidden = isAuth })
  }
  refreshAuthState()
  document.addEventListener('auth:changed', refreshAuthState)
  window.addEventListener('storage', refreshAuthState)

  if (hamburger && mobileMenu) {
    function closeMenu() {
      hamburger.classList.remove('active')
      hamburger.setAttribute('aria-expanded', 'false')
      mobileMenu.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }

    function openMenu() {
      refreshAuthState()
      hamburger.classList.add('active')
      hamburger.setAttribute('aria-expanded', 'true')
      mobileMenu.setAttribute('aria-hidden', 'false')
      document.body.style.overflow = 'hidden'
    }

    hamburger.addEventListener('click', (e) => {
      e.stopPropagation()
      const isOpen = hamburger.classList.contains('active')
      if (isOpen) { closeMenu() } else { openMenu() }
    })

    document.addEventListener('click', (e) => {
      if (hamburger.classList.contains('active')) {
        const target = e.target
        if (target instanceof Node && !hamburger.contains(target) && !mobileMenu.contains(target)) {
          closeMenu()
        }
      }
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hamburger.classList.contains('active')) {
        closeMenu()
      }
    })

    mobileMenu.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => { closeMenu() })
    })

    Array.prototype.forEach.call(mobileMenu.children, (el, i) => {
      el.style.setProperty('--i', String(i))
    })

    document.addEventListener('astro:before-swap', closeMenu)
    document.addEventListener('astro:after-swap', refreshAuthState)
  }

  // ── Estado ativo dos links (SPA) ──
  function setActiveLinks() {
    const path = window.location.pathname
    const links = document.querySelectorAll('.header-nav .nav-link, .mobile-menu .mobile-link')
    const rules = [
      { parent: '/blog', prefix: '/blog/' },
      { parent: '/receitas', prefix: '/receitas/' },
    ]
    function match(href) {
      if (path === '/' && href === '/') return true
      if (path === href) return true
      if (href !== '/' && path.indexOf(href + '/') === 0) return true
      for (const r of rules) {
        if (href === r.parent && path.indexOf(r.prefix) === 0) return true
      }
      return false
    }
    links.forEach(function (a) {
      a.classList.remove('active')
      const href = a.getAttribute('href')
      if (href && match(href)) a.classList.add('active')
    })
  }

  let lastScrollY = window.pageYOffset;
  let ticking = false;

  function updateHeader() {
    const header = document.querySelector('.header');
    if (window.pageYOffset > 10) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
    ticking = false;
  }

  function requestTick() {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }

  window.addEventListener('scroll', () => {
    lastScrollY = window.pageYOffset;
    requestTick();
  }, { passive: true });

  document.addEventListener('astro:after-swap', setActiveLinks)
  setActiveLinks()

  const searchToggle = document.getElementById('search-toggle')
  const searchToggleMobile = document.getElementById('search-toggle-mobile')

  function openSearch() {
    window.dispatchEvent(new CustomEvent('search:open'))
    if (hamburger) {
      hamburger.classList.remove('active')
      hamburger.setAttribute('aria-expanded', 'false')
    }
    if (mobileMenu) {
      mobileMenu.setAttribute('aria-hidden', 'true')
      document.body.style.overflow = ''
    }
  }

  searchToggle?.addEventListener('click', openSearch)
  searchToggleMobile?.addEventListener('click', openSearch)

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault()
      openSearch()
    }
  })

  // ── Dropdown acessível (hover + clique + Esc + clique fora) ──
  const dropdowns = Array.prototype.slice.call(document.querySelectorAll('[data-dropdown]'))

  function closeDropdowns(except) {
    dropdowns.forEach(dd => {
      if (dd === except) return
      dd.classList.remove('open')
      const link = dd.querySelector('.nav-link')
      link?.setAttribute('aria-expanded', 'false')
    })
  }

  dropdowns.forEach(dd => {
    const link = dd.querySelector('.nav-link')
    dd.addEventListener('mouseenter', () => {
      dd.classList.add('open')
      link?.setAttribute('aria-expanded', 'true')
    })
    dd.addEventListener('mouseleave', () => {
      closeDropdowns()
    })
    dd.addEventListener('focusin', () => {
      dd.classList.add('open')
      link?.setAttribute('aria-expanded', 'true')
    })
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget)) closeDropdowns()
    })
    link?.addEventListener('click', (e) => {
      e.preventDefault()
      const isOpen = dd.classList.contains('open')
      closeDropdowns()
      if (!isOpen) {
        dd.classList.add('open')
        link.setAttribute('aria-expanded', 'true')
      }
    })
  })

  document.addEventListener('click', (e) => {
    const target = e.target
    if (target instanceof Node && !target.closest('[data-dropdown]')) closeDropdowns()
  })

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdowns()
  })

  document.addEventListener('astro:before-swap', () => closeDropdowns())
</script>
