---
const consentVersion = 1
const storageKey = 'cookie-consent'
---

<div class="cookie-consent" id="cookie-consent" role="dialog" aria-label="Consentimento de cookies" hidden>
  <div class="cookie-consent-inner">
    <div class="cookie-consent-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10c0-.9-.3-1.4-.8-1.7a2 2 0 0 1-2.4-.4 2 2 0 0 1-.6-1.6 2 2 0 0 1-2.9-2.9 2 2 0 0 1-1.7-.9A3 3 0 0 1 12 2z" />
        <circle cx="8.5" cy="9.5" r="0.5" fill="currentColor" />
        <circle cx="12" cy="13" r="0.5" fill="currentColor" />
        <circle cx="15.5" cy="8.5" r="0.5" fill="currentColor" />
        <circle cx="13" cy="16.5" r="0.5" fill="currentColor" />
      </svg>
    </div>
    <div class="cookie-consent-content">
      <p class="cookie-consent-title">Respeitamos sua privacidade 🍪</p>
      <p class="cookie-consent-text">
        Usamos cookies essenciais para o funcionamento do site e, com o seu consentimento,
        cookies de estatística (Google Analytics) para entender como você usa o conteúdo.
        Você pode aceitar, recusar ou saber mais na nossa
        <a href="/cookies/" class="cookie-consent-link">Política de Cookies</a>.
      </p>
    </div>
    <div class="cookie-consent-actions">
      <button type="button" class="cookie-btn cookie-btn-reject" id="cookie-reject">Rejeitar</button>
      <button type="button" class="cookie-btn cookie-btn-accept" id="cookie-accept">Aceitar todos</button>
    </div>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 200;
    max-width: 560px;
    margin: 0 auto;
    background: var(--color-glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-glass-border);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    animation: cookie-slide-up 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent-inner {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.25rem;
  }

  .cookie-consent-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-accent);
  }

  .cookie-consent-content {
    flex: 1;
    min-width: 0;
  }

  .cookie-consent-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
  }

  .cookie-consent-text {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .cookie-consent-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-consent-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    flex-direction: column;
  }

  .cookie-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cookie-btn-accept {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    color: var(--color-btn-text);
    border: none;
  }

  .cookie-btn-accept:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .cookie-btn-reject {
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
  }

  .cookie-btn-reject:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }

  @keyframes cookie-slide-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 640px) {
    .cookie-consent {
      left: 1.5rem;
      right: auto;
      margin: 0;
    }

    .cookie-consent-actions {
      flex-direction: row;
      align-items: center;
      padding-top: 0.2rem;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'cookie-consent'
  const CONSENT_VERSION = 1

  const banner = document.getElementById('cookie-consent')
  const acceptBtn = document.getElementById('cookie-accept')
  const rejectBtn = document.getElementById('cookie-reject')

  function getConsent() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY)
      return raw ? JSON.parse(raw) : null
    } catch (e) {
      return null
    }
  }

  function saveConsent(analytics) {
    const payload = {
      essential: true,
      analytics: analytics,
      marketing: false,
      version: CONSENT_VERSION,
      date: new Date().toISOString()
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(payload))
  }

  function hideBanner() {
    if (banner) {
      banner.setAttribute('hidden', '')
    }
  }

  function maybeShowBanner() {
    const consent = getConsent()
    if (consent && consent.version === CONSENT_VERSION && banner) {
      hideBanner()
      return
    }
    if (banner) {
      banner.removeAttribute('hidden')
    }
  }

  function init() {
    if (!banner) return
    maybeShowBanner()

    acceptBtn?.addEventListener('click', () => {
      saveConsent(true)
      hideBanner()
      if (typeof window.__enableAnalytics === 'function') {
        window.__enableAnalytics()
      }
    })

    rejectBtn?.addEventListener('click', () => {
      saveConsent(false)
      hideBanner()
    })

    document.addEventListener('astro:page-load', maybeShowBanner)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>
