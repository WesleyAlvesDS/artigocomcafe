---
---

<!-- Modal imersivo (primeira visita, sem consentimento) -->
<div class="cookie-overlay" id="cookie-overlay" hidden>
  <div class="cookie-modal" role="dialog" aria-modal="true" aria-labelledby="cookie-title">
    <div class="cookie-modal-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10c0-.9-.3-1.4-.8-1.7a2 2 0 0 1-2.4-.4 2 2 0 0 1-.6-1.6 2 2 0 0 1-2.9-2.9 2 2 0 0 1-1.7-.9A3 3 0 0 1 12 2z" />
        <circle cx="8.5" cy="9.5" r="0.5" fill="currentColor" />
        <circle cx="12" cy="13" r="0.5" fill="currentColor" />
        <circle cx="15.5" cy="8.5" r="0.5" fill="currentColor" />
        <circle cx="13" cy="16.5" r="0.5" fill="currentColor" />
      </svg>
    </div>
    <h2 id="cookie-title" class="cookie-title">Sua privacidade importa</h2>
    <p class="cookie-text">
      Usamos cookies essenciais para o funcionamento do site e, com o seu consentimento,
      cookies de estatística (Google Analytics) e de marketing para melhorar sua experiência.
      Você pode aceitar tudo, recusar ou personalizar.
    </p>

    <div class="cookie-prefs" id="cookie-prefs" hidden>
      <label class="cookie-pref">
        <input type="checkbox" id="pref-essential" checked disabled />
        <span><strong>Essenciais</strong><small>Necessários para o funcionamento do site</small></span>
      </label>
      <label class="cookie-pref">
        <input type="checkbox" id="pref-analytics" checked />
        <span><strong>Estatística</strong><small>Google Analytics para entender o uso do conteúdo</small></span>
      </label>
      <label class="cookie-pref">
        <input type="checkbox" id="pref-marketing" checked />
        <span><strong>Marketing</strong><small>Personalização e anúncios relevantes</small></span>
      </label>
      <button type="button" id="cookie-prefs-save" class="cookie-btn cookie-btn-primary">Salvar preferências</button>
    </div>

    <div class="cookie-actions">
      <button type="button" id="cookie-accept" class="cookie-btn cookie-btn-accept">Aceitar todos</button>
      <button type="button" id="cookie-reject" class="cookie-btn cookie-btn-ghost">Só essenciais</button>
    </div>
    <button type="button" id="cookie-prefs-toggle" class="cookie-prefs-link">
      Personalizar preferências
    </button>

    <div class="cookie-location" role="group" aria-labelledby="cookie-location-title">
      <div class="cookie-location-head">
        <span class="cookie-location-emoji" aria-hidden="true">📍</span>
        <div>
          <p id="cookie-location-title" class="cookie-location-title">Clima do Café na sua região</p>
          <p class="cookie-location-text">
            Podemos usar sua localização para mostrar o clima certo onde você está? Você pode alterar depois.
          </p>
        </div>
      </div>
      <div class="cookie-location-options">
        <label class="cookie-location-opt">
          <input type="radio" name="cookie-location" id="loc-grant" value="grant" />
          <span class="cookie-location-dot" aria-hidden="true"></span>
          <span>Usar minha localização</span>
        </label>
        <label class="cookie-location-opt">
          <input type="radio" name="cookie-location" id="loc-city" value="city" checked />
          <span class="cookie-location-dot" aria-hidden="true"></span>
          <span>São Paulo (padrão)</span>
        </label>
      </div>
    </div>

    <p class="cookie-locating" id="cookie-locating" hidden>
      <span class="cookie-locating-spinner" aria-hidden="true"></span>
      Buscando sua localização…
    </p>

    <p class="cookie-footnote">
      <a href="/cookies/">Política de Cookies</a>
    </p>
  </div>
</div>

<!-- Chip flutuante (consentimento já registrado) -->
<button type="button" class="cookie-chip" id="cookie-chip" aria-haspopup="true" aria-expanded="false" hidden>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2a10 10 0 1 0 10 10c0-.9-.3-1.4-.8-1.7a2 2 0 0 1-2.4-.4 2 2 0 0 1-.6-1.6 2 2 0 0 1-2.9-2.9 2 2 0 0 1-1.7-.9A3 3 0 0 1 12 2z" />
    <circle cx="8.5" cy="9.5" r="0.5" fill="currentColor" />
    <circle cx="12" cy="13" r="0.5" fill="currentColor" />
    <circle cx="15.5" cy="8.5" r="0.5" fill="currentColor" />
    <circle cx="13" cy="16.5" r="0.5" fill="currentColor" />
  </svg>
  <span>Cookies</span>
</button>

<div class="cookie-popover" id="cookie-popover" role="dialog" aria-label="Preferências de cookies" hidden>
  <h3 class="cookie-popover-title">Consentimento de cookies</h3>
  <p class="cookie-popover-text">Altere suas preferências a qualquer momento.</p>
  <label class="cookie-pref">
    <input type="checkbox" id="chip-analytics" />
    <span><strong>Estatística</strong></span>
  </label>
  <label class="cookie-pref">
    <input type="checkbox" id="chip-marketing" />
    <span><strong>Marketing</strong></span>
  </label>

  <div class="cookie-location-mini">
    <span class="cookie-location-mini-label">Clima da sua região</span>
    <div class="cookie-location-mini-actions">
      <button type="button" id="chip-loc-grant" class="cookie-location-mini-btn">📍 Localização</button>
      <button type="button" id="chip-loc-city" class="cookie-location-mini-btn">🌤️ São Paulo</button>
    </div>
  </div>

  <div class="cookie-popover-actions">
    <button type="button" id="chip-save" class="cookie-btn cookie-btn-primary">Salvar</button>
    <a href="/cookies/" class="cookie-popover-link">Política</a>
  </div>
</div>

<style>
  .cookie-overlay {
    position: fixed;
    inset: 0;
    z-index: 9995;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: cookie-fade-in 0.35s ease-out;
  }

  .cookie-overlay[hidden],
  .cookie-chip[hidden],
  .cookie-popover[hidden],
  .cookie-locating[hidden] {
    display: none;
  }

  .cookie-modal {
    width: 100%;
    max-width: 480px;
    max-height: 92dvh;
    overflow-y: auto;
    padding: 2rem 1.75rem;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-glass-border);
    border-radius: 1.25rem;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
    text-align: center;
    animation: cookie-modal-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cookie-modal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    color: var(--color-btn-text);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .cookie-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 0.6rem;
  }

  .cookie-text {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .cookie-prefs {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: left;
    margin-bottom: 1rem;
    padding-top: 0.25rem;
  }

  .cookie-pref {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-bg-card-border);
    border-radius: 12px;
    background: var(--color-bg-card);
    cursor: pointer;
  }

  .cookie-pref input {
    width: 17px;
    height: 17px;
    accent-color: var(--color-accent);
    flex-shrink: 0;
  }

  .cookie-pref span {
    display: flex;
    flex-direction: column;
  }

  .cookie-pref strong {
    font-size: 0.82rem;
    color: var(--color-text-primary);
  }

  .cookie-pref small {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .cookie-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
  }

  .cookie-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .cookie-btn:disabled {
    opacity: 0.6;
    cursor: wait;
    transform: none;
  }

  .cookie-btn-accept {
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    color: var(--color-btn-text);
    border: none;
  }

  .cookie-btn-accept:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .cookie-btn-ghost {
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
  }

  .cookie-btn-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }

  .cookie-btn-primary {
    background: var(--color-bg-card);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }

  .cookie-btn-primary:hover {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .cookie-prefs-link {
    display: inline-block;
    margin-top: 0.85rem;
    background: none;
    border: none;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-location {
    margin-top: 1.1rem;
    padding: 0.9rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, var(--color-bg-card-border));
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-accent) 5%, var(--color-bg-card));
    text-align: left;
  }

  .cookie-location-head {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .cookie-location-emoji {
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .cookie-location-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .cookie-location-text {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin-top: 0.15rem;
  }

  .cookie-location-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .cookie-location-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--color-bg-card-border);
    border-radius: 10px;
    background: var(--color-bg-primary);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .cookie-location-opt:hover {
    border-color: var(--color-accent);
  }

  .cookie-location-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cookie-location-dot {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    border: 2px solid var(--color-bg-card-border);
    border-radius: 50%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .cookie-location-opt input:checked ~ .cookie-location-dot {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 3.5px var(--color-bg-primary), inset 0 0 0 5.5px var(--color-accent);
  }

  .cookie-location-opt:has(input:checked) {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-primary));
    color: var(--color-text-primary);
  }

  .cookie-locating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .cookie-locating-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-bg-card-border);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: cookie-spin 0.8s linear infinite;
  }

  @keyframes cookie-spin {
    to { transform: rotate(360deg); }
  }

  .cookie-footnote {
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }

  .cookie-footnote a,
  .cookie-popover-link {
    color: var(--color-text-muted);
  }

  .cookie-chip {
    position: fixed;
    right: 1.25rem;
    bottom: 5.5rem;
    z-index: 9996;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-glass-border);
    border-radius: 100px;
    background: var(--color-glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s, color 0.2s, border-color 0.2s;
  }

  .cookie-chip:hover {
    transform: translateY(-2px);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .cookie-popover {
    position: fixed;
    right: 1.25rem;
    bottom: 9rem;
    z-index: 9996;
    width: 300px;
    padding: 1rem;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-glass-border);
    border-radius: 1rem;
    box-shadow: var(--shadow-card);
    animation: cookie-modal-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cookie-popover-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
  }

  .cookie-popover-text {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .cookie-popover .cookie-pref {
    padding: 0.5rem 0.6rem;
  }

  .cookie-location-mini {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-bg-card-border);
  }

  .cookie-location-mini-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .cookie-location-mini-actions {
    display: flex;
    gap: 0.5rem;
  }

  .cookie-location-mini-btn {
    flex: 1;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--color-bg-card-border);
    border-radius: 10px;
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .cookie-location-mini-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cookie-popover-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .cookie-popover-actions .cookie-btn {
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
  }

  .cookie-popover-link {
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @keyframes cookie-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes cookie-modal-in {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 640px) {
    .cookie-actions {
      flex-direction: column;
    }
    .cookie-location-options {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { saveConsent as persistConsent, getConsent, hasConsented, saveLocationPref } from '../lib/consent'

  const overlay = document.getElementById('cookie-overlay')
  const chip = document.getElementById('cookie-chip')
  const popover = document.getElementById('cookie-popover')
  const prefs = document.getElementById('cookie-prefs')
  const prefsToggle = document.getElementById('cookie-prefs-toggle')
  const prefsSave = document.getElementById('cookie-prefs-save')
  const acceptBtn = document.getElementById('cookie-accept')
  const rejectBtn = document.getElementById('cookie-reject')
  const locating = document.getElementById('cookie-locating')
  const locGrant = document.getElementById('loc-grant')
  const locCity = document.getElementById('loc-city')
  const chipSave = document.getElementById('chip-save')
  const chipAnalytics = document.getElementById('chip-analytics')
  const chipMarketing = document.getElementById('chip-marketing')
  const chipLocGrant = document.getElementById('chip-loc-grant')
  const chipLocCity = document.getElementById('chip-loc-city')

  function applyConsent(analytics) {
    if (analytics && typeof window.__enableAnalytics === 'function') {
      window.__enableAnalytics()
    }
  }

  function showOverlay() {
    overlay?.removeAttribute('hidden')
    document.body.style.overflow = 'hidden'
  }

  function hideOverlay() {
    overlay?.setAttribute('hidden', '')
    document.body.style.overflow = ''
    setLocating(false)
  }

  function showChip() {
    chip?.removeAttribute('hidden')
  }

  function setLocating(on) {
    if (locating) locating.hidden = !on
    ;[acceptBtn, rejectBtn, prefsSave].forEach((btn) => {
      if (btn) btn.disabled = on
    })
  }

  function syncChipState() {
    if (!chip || !chipAnalytics || !chipMarketing) return
    const consent = getConsent()
    if (consent) {
      chipAnalytics.checked = !!consent.analytics
      chipMarketing.checked = !!consent.marketing
    }
  }

  function maybeInit() {
    if (hasConsented()) {
      showChip()
      syncChipState()
      return
    }
    showOverlay()
  }

  function togglePopover(force) {
    if (!popover) return
    const next = typeof force === 'boolean' ? force : popover.hasAttribute('hidden')
    if (next) {
      popover.removeAttribute('hidden')
      chip?.setAttribute('aria-expanded', 'true')
    } else {
      popover.setAttribute('hidden', '')
      chip?.setAttribute('aria-expanded', 'false')
    }
  }

  function close() {
    hideOverlay()
    showChip()
    syncChipState()
  }

  function selectedLocationPref() {
    const grant = locGrant && locGrant.checked
    if (!grant) {
      return { granted: false, city: 'São Paulo' }
    }
    return null // precisa da localização real
  }

  function finishConsent(analytics, marketing) {
    const pref = selectedLocationPref()
    if (pref) {
      persistConsent(analytics, marketing, pref)
      applyConsent(analytics)
      close()
      return
    }

    // Usuário optou por geolocalização
    setLocating(true)
    if (!navigator.geolocation) {
      persistConsent(analytics, marketing, { granted: false, city: 'São Paulo' })
      applyConsent(analytics)
      close()
      return
    }
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        persistConsent(analytics, marketing, {
          granted: true,
          lat: pos.coords.latitude,
          lon: pos.coords.longitude,
          updated_at: new Date().toISOString(),
        })
        applyConsent(analytics)
        close()
      },
      () => {
        persistConsent(analytics, marketing, { granted: false, city: 'São Paulo' })
        applyConsent(analytics)
        close()
      },
      { timeout: 8000, maximumAge: 600000 }
    )
  }

  function init() {
    maybeInit()

    acceptBtn?.addEventListener('click', () => finishConsent(true, true))
    rejectBtn?.addEventListener('click', () => finishConsent(false, false))

    prefsToggle?.addEventListener('click', () => {
      const show = prefs?.hasAttribute('hidden')
      if (show) {
        prefs?.removeAttribute('hidden')
        prefsToggle.textContent = 'Ocultar preferências'
      } else {
        prefs?.setAttribute('hidden', '')
        prefsToggle.textContent = 'Personalizar preferências'
      }
    })

    prefsSave?.addEventListener('click', () => {
      const analytics = document.getElementById('pref-analytics')?.checked
      const marketing = document.getElementById('pref-marketing')?.checked
      finishConsent(!!analytics, !!marketing)
    })

    chip?.addEventListener('click', (e) => {
      e.stopPropagation()
      togglePopover()
    })

    chipSave?.addEventListener('click', () => {
      persistConsent(!!chipAnalytics?.checked, !!chipMarketing?.checked)
      applyConsent(!!chipAnalytics?.checked)
      togglePopover(false)
    })

    // Localização a partir do popover (alterar depois)
    chipLocGrant?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        saveLocationPref({ granted: false, city: 'São Paulo' })
        return
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          saveLocationPref({ granted: true, lat: pos.coords.latitude, lon: pos.coords.longitude, updated_at: new Date().toISOString() })
        },
        () => saveLocationPref({ granted: false, city: 'São Paulo' }),
        { timeout: 8000, maximumAge: 600000 }
      )
    })
    chipLocCity?.addEventListener('click', () => {
      saveLocationPref({ granted: false, city: 'São Paulo' })
    })

    document.addEventListener('click', (e) => {
      if (!popover || popover.hasAttribute('hidden')) return
      if (!chip?.contains(e.target) && !popover.contains(e.target)) {
        togglePopover(false)
      }
    })

    document.addEventListener('astro:page-load', maybeInit)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>
