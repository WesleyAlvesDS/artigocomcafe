---
import CafeDoDia from './CafeDoDia'
import ReceitaDoDia from './ReceitaDoDia'
import NewsletterForm from './NewsletterForm'
import ClimaDoCafe from './ClimaDoCafe'
import ExchangeRateWidget from './ExchangeRateWidget'
import AdSterraNative from './AdSterraNative.astro'
import AdSterraSmartLink from './AdSterraSmartLink.astro'

interface Props {
  /** Mostra o widget de Café do Dia (artigo em destaque) */
  cafeDoDia?: boolean
  /** Mostra o widget de Receita do Dia (receita em destaque) */
  receitaDoDia?: boolean
  /** Mostra o widget de Newsletter */
  newsletter?: boolean
  /** Mostra o widget de Clima do Café */
  clima?: boolean
  /** Mostra o widget de Câmbio ao Vivo */
  cambio?: boolean
  /**
   * Mostra o anúncio nativo no topo do sidebar. Desative (false) em páginas que
   * já têm outro AdSterraNative no conteúdo (ex.: in-feed nas listagens) — o id
   * do container é fixo por unidade e duplicar quebra o segundo anúncio.
   */
  nativeAd?: boolean
}

const {
  cafeDoDia = true,
  receitaDoDia = true,
  newsletter = true,
  clima = false,
  cambio = false,
  nativeAd = true,
} = Astro.props
---

<aside class="sidebar-widgets" aria-label="Widgets e conteúdo em destaque">
  {nativeAd && (
    <div class="widget widget-ad" data-scroll-reveal="fade" data-scroll-delay="0">
      <AdSterraNative lazy />
    </div>
  )}

  {cafeDoDia && (
    <div class="widget" data-scroll-reveal="fade" data-scroll-delay="0">
      <CafeDoDia client:visible />
    </div>
  )}

  {receitaDoDia && (
    <div class="widget" data-scroll-reveal="fade" data-scroll-delay="60">
      <ReceitaDoDia client:visible />
    </div>
  )}

  {clima && (
    <div class="widget" data-scroll-reveal="fade" data-scroll-delay="120">
      <ClimaDoCafe client:visible />
    </div>
  )}

  {newsletter && (
    <div class="widget widget-newsletter glass-card" data-scroll-reveal="fade" data-scroll-delay="180">
      <span class="widget-badge">☕ Novidades direto no email</span>
      <h3 class="widget-title">Receba o melhor do café</h3>
      <p class="widget-desc">
        Artigos, receitas e novidades — sem spam, só conteúdo bom para a sua pausa.
      </p>
      <NewsletterForm client:load variant="inline" />
    </div>
  )}

  {cambio && (
    <div class="widget" data-scroll-reveal="fade" data-scroll-delay="240">
      <ExchangeRateWidget client:visible compact={false} maxRates={5} />
    </div>
  )}

  <div class="widget widget-sponsor" data-scroll-reveal="fade" data-scroll-delay="300">
    <AdSterraSmartLink
      variant="card"
      text="Pausa para o café? Explore seleções e experiências escolhidas para o seu momento."
    />
  </div>
</aside>

<style>
  .sidebar-widgets {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .widget {
    min-width: 0;
  }

  .widget-newsletter {
    padding: 1.5rem;
  }

  .widget-badge {
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .widget-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-serif);
  }

  .widget-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .widget {
      transition: none !important;
    }
  }
</style>
