---
// Barra de categorias do modelo editorial (modelonovo.md)
// Cada categoria: ícone + nome, com hover e link para o blog filtrado.
// ATENÇÃO: os slugs precisam existir no backend (backend/database/seeders/CategorySeeder.php)
// para o filtro /blog?categoria=<slug> nunca abrir vazio.
const CATEGORIES = [
  { name: 'Tecnologia', slug: 'tecnologia', icon: '💻', tint: '#3b82f6' },
  { name: 'Finanças', slug: 'financas', icon: '📈', tint: '#10b981' },
  { name: 'Educação', slug: 'educacao', icon: '🎓', tint: '#8b5cf6' },
  { name: 'Produtividade', slug: 'produtividade', icon: '⚡', tint: '#f59e0b' },
  { name: 'Saúde e Bem-estar', slug: 'saude-e-bem-estar', icon: '🧠', tint: '#ef4444' },
  { name: 'Curiosidades', slug: 'curiosidades', icon: '✨', tint: '#ec4899' },
]
---

<div class="category-bar" data-scroll-reveal="slide-up" data-scroll-delay="150" role="navigation" aria-label="Categorias de artigos">
  <div class="category-bar-inner">
    {CATEGORIES.map((cat) => (
      <a
        href={`/blog?categoria=${cat.slug}`}
        class="category-item"
        style={`--cat-tint: ${cat.tint}`}
      >
        <span class="category-icon" aria-hidden="true">{cat.icon}</span>
        <span class="category-name">{cat.name}</span>
        <span class="category-arrow" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </span>
      </a>
    ))}
  </div>
</div>

<style>
  .category-bar {
    position: relative;
    z-index: 5;
    margin-bottom: 2rem;
  }

  .category-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--color-bg-card) 60%, transparent);
    border: 1px solid var(--color-bg-card-border);
    border-radius: var(--radius-card-lg);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    /* Sem barra de rolagem visível: o swipe continua funcionando e o visual
       fica limpo (queixa: "barra de rolagem não muito legal"). */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .category-bar-inner::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  /* Máscara lateral: esmaece as bordas quando há overflow (dica de swipe) */
  .category-bar::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 56px;
    background: linear-gradient(90deg, transparent, var(--color-bg-primary));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    border-radius: 0 var(--radius-card-lg) var(--radius-card-lg) 0;
  }

  .category-bar.has-overflow::after {
    opacity: 0.85;
  }

  .category-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .category-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.95rem;
    background: color-mix(in srgb, var(--cat-tint) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--cat-tint) 20%, transparent);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s;
  }

  .category-arrow {
    display: inline-flex;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s, transform 0.3s;
    color: var(--cat-tint);
  }

  .category-item:hover {
    background: color-mix(in srgb, var(--cat-tint) 9%, transparent);
    border-color: color-mix(in srgb, var(--cat-tint) 28%, transparent);
    color: var(--cat-tint);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--cat-tint) 18%, transparent);
  }

  .category-item:hover .category-icon {
    transform: scale(1.12) rotate(-6deg);
    background: color-mix(in srgb, var(--cat-tint) 20%, transparent);
  }

  .category-item:hover .category-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Mobile: scroll horizontal suave */
  @media (max-width: 768px) {
    .category-bar { margin-top: -1rem; }
    .category-item { padding: 0.5rem 0.9rem; font-size: 0.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-item,
    .category-icon,
    .category-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Mostra a máscara lateral apenas quando a barra realmente tem overflow
  (function () {
    function refresh() {
      const bar = document.querySelector('.category-bar')
      if (!bar) return
      const inner = bar.querySelector('.category-bar-inner')
      if (!inner) return
      bar.classList.toggle('has-overflow', inner.scrollWidth > inner.clientWidth + 4)
    }
    window.addEventListener('astro:page-load', refresh)
    window.addEventListener('resize', refresh)
    document.addEventListener('DOMContentLoaded', refresh)
    refresh()
  })()
</script>
