---
interface Props {
  /** Classes extras aplicadas ao wrapper externo */
  className?: string
  /** Exibe o rótulo de publicidade */
  showLabel?: boolean
  /** Texto do rótulo */
  label?: string
  /** Carrega o script só quando o slot se aproxima da viewport (preserva LCP) */
  lazy?: boolean
  /**
   * Id do container. Deve ser ÚNICO por página: só use mais de uma instância
   * por página se cada uma apontar para uma unidade (placement) diferente do
   * dashboard Adsterra — id duplicado faz o getElementById preencher só o 1º.
   * Para uma 2ª unidade, passe também `src` (o invoke.js é por unidade).
   */
  containerId?: string
  /** URL do invoke.js da unidade. Padrão = unidade atual (nativo in-feed). */
  src?: string
}

/** Chave da unidade nativa atual (usada no id do container e no src) */
const zoneKey = 'b286da2e2fe2bfd4ecebf03e8a877de9'

const {
  className = '',
  showLabel = true,
  label = 'Publicidade',
  lazy = false,
  containerId = `container-${zoneKey}`,
  src = `https://pl30726903.effectivecpmnetwork.com/${zoneKey}/invoke.js`
} = Astro.props

const nativeSrc = src
---

<div class={`adsterra-native ${className}`}>
  {showLabel && <span class="adsterra-native-label">{label}</span>}
  <div class="adsterra-native-slot">
    <div id={containerId} class="adsterra-native-container"></div>
    {lazy ? (
      <script is:inline define:vars={{ nativeSrc }}>
        (function () {
          var slot = document.currentScript && document.currentScript.parentElement;
          if (!slot) return;
          var loaded = false;
          function load() {
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.setAttribute('data-cfasync', 'false');
            s.src = nativeSrc;
            slot.insertBefore(s, slot.firstChild);
            if (obs) obs.disconnect();
          }
          var obs = null;
          if ('IntersectionObserver' in window) {
            obs = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) { if (e.isIntersecting) load(); });
            }, { rootMargin: '350px 0px' });
            obs.observe(slot);
          } else {
            load();
          }
          setTimeout(load, 9000);
        })();
      </script>
    ) : (
      <script is:inline async="async" data-cfasync="false" src={nativeSrc}></script>
    )}
  </div>
</div>

<style>
  .adsterra-native {
    width: 100%;
    max-width: 100%;
    margin: 3rem auto;
  }

  .adsterra-native-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .adsterra-native-slot {
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .adsterra-native-container {
    width: 100%;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .adsterra-native-slot,
    .adsterra-native-container {
      min-height: 0;
    }
  }
</style>