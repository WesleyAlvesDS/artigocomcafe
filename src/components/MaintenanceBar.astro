    overflow: hidden;
    padding: 0.6rem 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }

  .maintenance-track {
    display: flex;
    width: max-content;
    animation: maintenance-scroll 28s linear infinite;
    will-change: transform;
  }

  .maintenance-content {
