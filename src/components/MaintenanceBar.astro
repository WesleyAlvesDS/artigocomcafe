<script is:inline>
  // Empurra o header fixo para baixo quando a barra de manutenção está presente
  (function() {
    function adjust() {
      var bar = document.querySelector('[data-maintenance-bar]');
      var header = document.querySelector('.header');
      if (bar && header) {
        var h = bar.offsetHeight;
        header.style.top = h + 'px';
        document.documentElement.style.setProperty('--maintenance-bar-h', h + 'px');
      }
    }
    adjust();
    document.addEventListener('astro:after-swap', adjust);
    window.addEventListener('resize', adjust);
  })();
</script>

<style>
