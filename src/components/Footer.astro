---
import NewsletterForm from './NewsletterForm'
import AdSterraSmartLink from './AdSterraSmartLink.astro'
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-icon">&#9749;</span>
          <span>Artigo com <span class="gradient-text">Café</span></span>
        </div>
        <p class="footer-desc">
          Um ambiente de leitura aberto a todos, onde o café é uma analogia do acolhimento: cultura, história, métodos e conhecimento — um artigo por vez.
        </p>
        <div class="footer-social">
          <a href="/contato" class="social-link" aria-label="Contato">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href="/newsletter" class="social-link" aria-label="Newsletter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h2 class="footer-heading">Navegação</h2>
        <a href="/blog" class="footer-link">📝 Blog</a>
        <a href="/receitas" class="footer-link">🍳 Receitas</a>
        <a href="/dashboard" class="footer-link">📊 Dashboard</a>
        <a href="/dashboard#/mapa" class="footer-link">🗺️ Mapa do Conhecimento</a>
        <a href="/sobre" class="footer-link">ℹ️ Sobre</a>
        <a href="/contato" class="footer-link">📧 Contato</a>
        <a href="/newsletter" class="footer-link">📬 Newsletter</a>
      </div>

      <div class="footer-links">
        <h2 class="footer-heading">Guia do Café</h2>
        <a href="/metodos-de-preparo/" class="footer-link">☕ Métodos de Preparo</a>
        <a href="/tipos-de-graos/" class="footer-link">🫘 Tipos de Grãos</a>
        <a href="/como-fazer-cafe/" class="footer-link">✨ Como Fazer Café</a>
        <a href="/cafes-do-brasil/" class="footer-link">🇧🇷 Cafés do Brasil</a>
        <a href="/glossario-do-cafe/" class="footer-link">📖 Glossário do Café</a>
        <a href="/cafe-da-manha/" class="footer-link">🥐 Café da Manhã</a>
      </div>

      <div class="footer-links">
        <h2 class="footer-heading">Institucional</h2>
        <a href="/cookies" class="footer-link">🍪 Política de Cookies</a>
      </div>

      <div class="footer-links">
        <h2 class="footer-heading">Gamificação</h2>
        <a href="/dashboard#/jornada" class="footer-link">📊 Jornada</a>
        <a href="/dashboard#/graos" class="footer-link">🫘 Grãos</a>
        <a href="/dashboard#/torrefacao" class="footer-link">☕ Torrefação</a>
        <a href="/dashboard#/missoes" class="footer-link">🎯 Missões</a>
        <a href="/dashboard#/conquistas" class="footer-link">🏆 Conquistas</a>
        <a href="/dashboard#/trilhas" class="footer-link">🎓 Trilhas</a>
        <a href="/dashboard#/biblioteca" class="footer-link">📚 Biblioteca</a>
      </div>

      <div class="footer-newsletter">
        <h2 class="footer-heading">Receba novidades</h2>
        <p class="footer-newsletter-text">
          Inscreva-se para receber os melhores conteúdos de leitura e café.
        </p>
        <NewsletterForm client:visible />
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Artigo com Café. Todos os direitos reservados.</p>
      <AdSterraSmartLink
        variant="link"
        text="Conheça nossas indicações de produtos e experiências"
        label="Parceria"
      />
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-bg-card-border);
    padding-top: 4rem;
    padding-bottom: 2rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
    gap: 2rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .footer-logo-icon {
    font-size: 1.5rem;
  }

  .footer-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-button);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-muted);
    transition: color var(--transition), background-color var(--transition), border-color var(--transition), transform var(--transition)
    text-decoration: none;
  }

  .social-link:hover {
    background: var(--color-accent);
    color: var(--color-btn-text);
    transform: translateY(-2px);
  }

  .footer-heading {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-newsletter-text {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-bg-card-border);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-bottom .adsterra-smartlink {
    font-size: 0.78rem;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-newsletter {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
