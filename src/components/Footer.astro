  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-icon">&#9749;</span>
          <span>Artigo com <span class="gradient-text">Café</span></span>
        </div>
        <p class="footer-desc">
          Blog autoral sobre cafeteria digital. Conteúdo, experiência do usuário e monetização.
        </p>
        <div class="footer-social">
          <a href="https://github.com/WesleyAlvesDS" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
