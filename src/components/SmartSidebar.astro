---
interface Props {
  articleTitle: string
  articleUrl: string
  tocHeadings: { id: string; text: string; level: number }[]
  categories: { name: string; slug: string }[]
  tags: { name: string; slug: string }[]
  readingTime: number
}

const { articleTitle, articleUrl, tocHeadings, categories, tags, readingTime } = Astro.props
---

<div class="smart-sidebar" id="smart-sidebar">
  {/* Reading Progress Ring */}
  <div class="sidebar-card">
    <div class="reading-progress" aria-label="Progresso de leitura">
      <div class="progress-ring" id="reading-progress-ring" role="img" aria-label={`${Math.round(0)}% lido`}>
        <svg class="progress-ring-svg" width="64" height="64">
          <circle
            class="progress-ring-circle-bg"
            cx="32"
            cy="32"
            r="16"
            fill="none"
            stroke="var(--color-bg-card-border)"
            stroke-width="4"
          />
          <circle
            class="progress-ring-circle"
            cx="32"
            cy="32"
            r="16"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-dasharray="100.53"
            stroke-dashoffset="100.53"
            style="transform: rotate(-90deg); transform-origin: 32px 32px;"
          />
        </svg>
        <div class="progress-ring-text">
          <span class="progress-ring-value" id="reading-progress-text">0%</span>
          <span class="progress-ring-label">Lido</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sidebar-divider"></div>

  {/* Table of Contents */}
  {tocHeadings.length > 0 && (
    <div class="sidebar-card">
      <h3 class="sidebar-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 11l3 3L22 4" />
          <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
        </svg>
        Neste artigo
      </h3>
      <nav class="toc-nav" aria-label="Sumário">
        <ul class="toc-list">
          {tocHeadings.map(heading => (
            <li class="toc-item">
              <a href={`#${heading.id}`} class={`toc-link ${heading.level === 3 ? 'toc-h3' : ''}`} data-toc-level={heading.level}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="sidebar-divider"></div>
  )}

  {/* Categories */}
  {categories.length > 0 && (
    <div class="sidebar-card">
      <h3 class="sidebar-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" />
          <line x1="7" y1="7" x2="7.01" y2="7" />
        </svg>
        Categorias
      </h3>
      <div class="sidebar-tags">
        {categories.map(cat => (
          <a href={`/blog?categoria=${cat.slug}`} class="sidebar-tag">{cat.name}</a>
        ))}
      </div>
    </div>
    <div class="sidebar-divider"></div>
  )}

  {/* Tags */}
  {tags.length > 0 && (
    <div class="sidebar-card">
      <h3 class="sidebar-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z" />
          <line x1="7" y1="7" x2="7.01" y2="7" />
        </svg>
        Tags
      </h3>
      <div class="sidebar-tags">
        {tags.map(tag => (
          <a href={`/blog?tag=${tag.slug}`} class="sidebar-tag">#{tag.name}</a>
        ))}
      </div>
    </div>
    <div class="sidebar-divider"></div>
  )}

  {/* Quick Actions */}
  <div class="sidebar-card">
    <h3 class="sidebar-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 7 4 4 20 4 20 7" />
        <line x1="9" y1="20" x2="15" y2="20" />
        <line x1="12" y1="4" x2="12" y2="20" />
      </svg>
      Ações rápidas
    </h3>
    <div class="quick-actions">
      <button class="action-btn" id="copy-link" aria-label="Copiar link" data-url={articleUrl}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
        </svg>
        <span>Copiar link</span>
      </button>
      <button class="action-btn" id="share-native" aria-label="Compartilhar nativo" style="display: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3" />
          <circle cx="6" cy="12" r="3" />
          <circle cx="18" cy="19" r="3" />
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
        </svg>
        <span>Compartilhar</span>
      </button>
      <button class="action-btn" id="font-decrease" aria-label="Diminuir fonte" data-font-size="small">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <text x="4" y="20" font-size="16">A-</text>
        </svg>
        <span>Fonte -</span>
      </button>
      <button class="action-btn" id="font-increase" aria-label="Aumentar fonte" data-font-size="large">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <text x="4" y="20" font-size="16">A+</text>
        </svg>
        <span>Fonte +</span>
      </button>
    </div>
  </div>

  <div class="sidebar-divider"></div>

  {/* Tema de leitura */}
  <div class="sidebar-card">
    <h3 class="sidebar-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v18" />
        <path d="M5 21h14" />
        <path d="M7 6h10" />
      </svg>
      Tema de leitura
    </h3>
    <div class="reading-themes" role="radiogroup" aria-label="Tema de leitura">
      <button type="button" class="theme-btn" data-reading-theme="default" role="radio" aria-checked="true">
        <span class="theme-swatch sw-default"></span>
        <span>Clássico</span>
      </button>
      <button type="button" class="theme-btn" data-reading-theme="serif" role="radio" aria-checked="false">
        <span class="theme-swatch sw-serif"></span>
        <span>Serifado</span>
      </button>
      <button type="button" class="theme-btn" data-reading-theme="sepia" role="radio" aria-checked="false">
        <span class="theme-swatch sw-sepia"></span>
        <span>Sépia</span>
      </button>
    </div>
  </div>

  <div class="sidebar-divider"></div>

  {/* Reading Time */}
  <div class="sidebar-card">
    <div class="reading-time">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
      <span>Tempo de leitura: <strong id="reading-time-estimate">{readingTime} min</strong></span>
    </div>
  </div>

  {/* Related Articles Placeholder - Lazy Loaded */}
  <div class="sidebar-card" id="related-placeholder">
    <h3 class="sidebar-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
      Artigos Relacionados
    </h3>
    <div class="related-placeholder" id="related-content">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12V7H5" />
        <path d="M16 7l-4 4" />
      </svg>
      <p>Carregando sugestões...</p>
    </div>
  </div>
</div>

<script>
  import {
    initReadingProgress,
    initScrollSpy,
    initFontControls,
    initReadingThemes,
    initCopyLink,
    initShareButton,
    initReadingTime,
    initLazyRelated,
  } from '../scripts/index';

  function initAll() {
    initReadingProgress();
    initScrollSpy();
    initFontControls();
    initReadingThemes();
    initCopyLink();
    initShareButton();
    initReadingTime();
    initLazyRelated();
  }

  document.addEventListener('astro:page-load', initAll);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>

<style>
  .smart-sidebar .sidebar-card {
    padding: 1.25rem;
  }

  .smart-sidebar .sidebar-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sidebar-divider {
    height: 1px;
    background: var(--color-bg-card-border);
    margin: 0 0.25rem;
  }

  /* Progresso de leitura */
  .reading-progress {
    display: flex;
    justify-content: center;
    padding: 0.25rem 0;
  }

  .progress-ring {
    position: relative;
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progress-ring-svg {
    transform: rotate(-90deg);
  }

  .progress-ring-circle {
    transition: stroke-dashoffset 0.15s linear;
  }

  .progress-ring-text {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
  }

  .progress-ring-value {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .progress-ring-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  /* TOC */
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .toc-h3 {
    padding-left: 1.1rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .toc-link:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .toc-link.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  /* Ações rápidas */
  .quick-actions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .action-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .action-btn.active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .action-btn.copied {
    color: #34d399;
    border-color: rgba(52, 211, 153, 0.5);
  }

  /* Tempo de leitura */
  .reading-time {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .reading-time svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .reading-time strong {
    color: var(--color-text-primary);
  }

  /* Relacionados (lazy) */
  .related-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.25rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-bg-card) 60%, transparent);
    border: 1px dashed var(--color-bg-card-border);
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .related-placeholder svg {
    color: var(--color-accent);
    opacity: 0.6;
  }

  .smart-sidebar .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .smart-sidebar .sidebar-tag {
    font-size: 0.78rem;
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast)
  }

  a.smart-sidebar .sidebar-tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .smart-sidebar .action-btn,
    .smart-sidebar .sidebar-tag {
      transition: none !important;
    }
  }

  .reading-themes {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .theme-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: 10px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    width: 100%;
  }

  .theme-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
    transform: translateX(2px);
  }

  .theme-btn.active {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }

  .theme-swatch {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    flex-shrink: 0;
    border: 1px solid var(--color-bg-card-border);
  }

  .sw-default {
    background: linear-gradient(135deg, var(--color-bg-card), var(--color-bg-card-hover));
  }

  .sw-serif {
    background: linear-gradient(135deg, #2b231a, #4e463b);
  }

  .sw-sepia {
    background: linear-gradient(135deg, #f4ecd8, #e8dcc0);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-btn {
      transition: none !important;
    }
  }
</style>