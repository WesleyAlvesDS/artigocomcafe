---

<script>
  import { initScrollAnimations } from '../scripts/scroll-animations';
  initScrollAnimations();
</script>

<style is:global>
  [data-scroll-reveal] {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-scroll-reveal].scroll-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  [data-scroll-reveal="fade"] {
    transform: none;
  }

  [data-scroll-reveal="fade"].scroll-revealed {
    transform: none;
  }

  [data-scroll-reveal="slide-left"] {
    transform: translateX(-40px);
  }

  [data-scroll-reveal="slide-left"].scroll-revealed {
    transform: translateX(0);
  }

  [data-scroll-reveal="slide-right"] {
    transform: translateX(40px);
  }

  [data-scroll-reveal="slide-right"].scroll-revealed {
    transform: translateX(0);
  }

  [data-scroll-reveal="scale"] {
    transform: scale(0.9);
  }

  [data-scroll-reveal="scale"].scroll-revealed {
    transform: scale(1);
  }

  [data-scroll-reveal="flip"] {
    transform: perspective(1000px) rotateY(90deg);
    transform-origin: center;
  }

  [data-scroll-reveal="flip"].scroll-revealed {
    transform: perspective(1000px) rotateY(0deg);
  }

  [data-stagger] > [data-stagger-item] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  [data-stagger] > [data-stagger-item].stagger-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  [data-stagger="fade"] > [data-stagger-item] {
    transform: none;
  }

  [data-stagger="scale"] > [data-stagger-item] {
    transform: scale(0.9);
  }

  [data-stagger="slide-up"] > [data-stagger-item] {
    transform: translateY(30px);
  }

  [data-stagger="slide-down"] > [data-stagger-item] {
    transform: translateY(-30px);
  }

  [data-parallax] {
    will-change: transform;
  }

  [data-counter] {
    font-variant-numeric: tabular-nums;
  }

  [data-typewriter] {
    overflow: hidden;
    white-space: nowrap;
  }

  [data-typewriter].typewriter-done {
    border-right: none !important;
    animation: cursor-blink 1s infinite;
  }

  @keyframes cursor-blink {
    0%, 50% { border-right-color: var(--color-accent); }
    51%, 100% { border-right-color: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-scroll-reveal],
    [data-stagger] > [data-stagger-item],
    [data-parallax],
    [data-counter],
    [data-typewriter] {
      transition: none !important;
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }

    [data-scroll-reveal] {
      transform: none !important;
    }

    [data-typewriter] {
      border-right: none !important;
    }
  }
</style>
