---
import type { BlogPost } from '../lib/types'
import { formatDate } from '../lib/utils'
import { cardStaggerTransition } from '../lib/transitions'

export interface Props {
  post: BlogPost
  index?: number
  revealDelay?: string
}

const { post, index = 0, revealDelay } = Astro.props
const cardTransitionName = `article-card-${post.slug}`
const imageTransitionName = `article-image-${post.slug}`
const titleTransitionName = `article-title-${post.slug}`
const staggerDelay = index * 80
---

<a href={`/blog/${post.slug}`} class="article-card glass-card tilt-card spotlight-card" 
   transition:name={cardTransitionName} 
   transition:animate={cardStaggerTransition}
   style={`--stagger-delay: ${staggerDelay}ms`}
   data-reveal={revealDelay || ''}>
   
  {post.featuredImage && (
    <div class="article-image-wrapper" transition:name={imageTransitionName} transition:animate="morph">
       <img
         src={post.featuredImage}
         alt={post.featuredImageAlt}
         class="article-image"
         width="1200"
         height="675"
         loading="lazy"
         decoding="async"
         fetchpriority="low"
       />
     <div class="image-overlay" aria-hidden="true"></div>
   </div>
  )}
  
  <div class="article-body">
    <div class="article-meta">
      {post.categories.length > 0 && (
        <span class="article-category" transition:name={`article-category-${post.slug}`} transition:animate="slide">
          {post.categories[0].name}
        </span>
      )}
      <span class="article-date">{formatDate(post.date)}</span>
      <span class="article-reading">{post.readingTime} min de leitura</span>
    </div>
    <h2 class="article-title" transition:name={titleTransitionName} transition:animate="fade">
      {post.title}
    </h2>
    <p class="article-excerpt">{post.excerpt}</p>
    <span class="article-read-more" transition:name={`article-readmore-${post.slug}`} transition:animate="slide">
      Ler artigo
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </span>
  </div>

  <div class="article-card-actions" onclick={(e) => e.stopPropagation()}>
    <button class="card-action-btn card-save-btn" data-article-id={post.id} aria-label="Salvar artigo" title="Salvar na biblioteca">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
      </svg>
    </button>
    <button class="card-action-btn card-share-btn" data-share-url={`https://artigocomcafe.com/blog/${post.slug}`} data-share-title={post.title} aria-label="Compartilhar" title="Compartilhar artigo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
      </svg>
    </button>
  </div>
  
  <div class="card-glow" aria-hidden="true"></div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    position: relative;
    isolation: isolate;
    will-change: transform, box-shadow, border-color;
    contain: layout style paint;
  }

  .article-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--color-bg-secondary);
  }

  .article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
    will-change: transform, filter;
  }

  /* Moldura interna no hover: a imagem "assenta" levemente (diminui em vez
     de dar zoom), com um anel sutil — enquadramento premium e sem cortes. */
  .article-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-accent) 28%, transparent),
      inset 0 0 28px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(10,8,5,0.4) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .article-card:hover .article-image {
    transform: scale(0.97);
    filter: brightness(0.92);
  }

  .article-card:hover .article-image-wrapper::after,
  .article-card:hover .image-overlay {
    opacity: 1;
  }

  .article-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .article-category {
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    font-weight: 500;
    font-family: var(--font-sans);
    transition: color var(--transition), background-color var(--transition), border-color var(--transition), transform var(--transition);
  }

  .article-card:hover .article-category {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    transform: translateY(-1px);
  }

  .article-date::before,
  .article-reading::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--color-text-muted-dark);
  }

  .article-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0;
    transition: color 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .article-card:hover .article-title {
    color: var(--color-accent);
  }

  .article-excerpt {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-top: auto;
    transition: gap 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.3s;
  }

  .article-card:hover .article-read-more {
    gap: 0.7rem;
    transform: translateX(2px);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
    z-index: -1;
  }

  .article-card:hover .card-glow {
    opacity: 1;
  }

  .article-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-image,
    .image-overlay,
    .article-image-wrapper::after,
    .article-category,
    .article-title,
    .article-read-more,
    .card-glow {
      transition: none !important;
    }
    .article-card:hover .article-image {
      transform: none;
    }
    .article-card:hover .article-read-more {
      transform: none;
      gap: 0.35rem;
    }
  }

  @media (max-width: 768px) {
    .article-body {
      padding: 1.25rem;
    }
    .article-title {
      font-size: 1.1rem;
    }
  }

  /* ═══ Card Actions (Save + Share) ═══ */
  .article-card-actions {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    opacity: 0;
    transform: translateX(8px);
    transition: opacity 0.25s, transform 0.25s;
    z-index: 5;
  }

  .article-card:hover .article-card-actions,
  .article-card:focus-within .article-card-actions {
    opacity: 1;
    transform: translateX(0);
  }

  /* Touch devices: always show actions */
  @media (hover: none) {
    .article-card-actions {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .card-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast)
    backdrop-filter: blur(8px);
  }

  .card-action-btn:hover {
    background: var(--color-accent);
    color: var(--color-btn-text);
    border-color: var(--color-accent);
    transform: scale(1.1);
  }

  .card-save-btn:hover {
    background: #22c55e;
    border-color: #22c55e;
    color: white;
  }

  .card-share-btn:hover {
    background: #3b82f6;
    border-color: #3b82f6;
    color: white;
  }
</style>

<script>
(function () {
  document.addEventListener('astro:page-load', initCardActions)
  document.addEventListener('click', function (e) {
    var saveBtn = e.target.closest('.card-save-btn')
    if (saveBtn) {
      e.preventDefault()
      e.stopPropagation()
      handleSave(saveBtn)
      return
    }
    var shareBtn = e.target.closest('.card-share-btn')
    if (shareBtn) {
      e.preventDefault()
      e.stopPropagation()
      handleShare(shareBtn)
      return
    }
  })

  function initCardActions() {
    document.querySelectorAll('.card-save-btn').forEach(function (btn) {
      if (btn.dataset.bound) return
      btn.dataset.bound = '1'
    })
  }

  async function handleSave(btn) {
    var articleId = btn.dataset.articleId
    if (!articleId) return
    var token = localStorage.getItem('auth_token')
    if (!token) {
      window.location.href = '/entrar?next=' + encodeURIComponent(window.location.pathname)
      return
    }
    btn.style.pointerEvents = 'none'
    btn.style.opacity = '0.6'
    try {
      var res = await fetch('/api-proxy.php/user/library/' + articleId, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        }
      })
      if (res.ok) {
        btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>'
        btn.style.background = '#22c55e'
        btn.style.color = 'white'
        btn.style.borderColor = '#22c55e'
        btn.style.opacity = '1'
        btn.setAttribute('aria-label', 'Salvo!')
        window.dispatchEvent(new CustomEvent('app:show-toast', {
          detail: { title: 'Salvo na biblioteca 📚', type: 'success', message: 'Artigo adicionado à sua biblioteca.', duration: 3000 }
        }))
      } else {
        btn.style.opacity = '1'
        btn.style.pointerEvents = ''
      }
    } catch (err) {
      btn.style.opacity = '1'
      btn.style.pointerEvents = ''
    }
  }

  async function handleShare(btn) {
    var url = btn.dataset.shareUrl || window.location.href
    var title = btn.dataset.shareTitle || document.title
    if (navigator.share) {
      try {
        await navigator.share({ title: title, url: url })
      } catch (e) { /* usuário cancelou */ }
    } else {
      try {
        await navigator.clipboard.writeText(url)
        btn.style.background = '#22c55e'
        btn.style.color = 'white'
        btn.style.borderColor = '#22c55e'
        btn.setAttribute('aria-label', 'Link copiado!')
        btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>'
        window.dispatchEvent(new CustomEvent('app:show-toast', {
          detail: { title: 'Link copiado! 📋', type: 'success', message: 'URL copiada para a área de transferência.', duration: 2500 }
        }))
        setTimeout(function () {
          btn.style.background = ''
          btn.style.color = ''
          btn.style.borderColor = ''
          btn.setAttribute('aria-label', 'Compartilhar')
          btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>'
        }, 2000)
      } catch (err) {
        window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url), '_blank', 'width=600,height=400')
      }
    }
  }
})()
</script>