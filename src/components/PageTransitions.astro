<script>
  export const pageTransitions = {
    default: 'fade',
    home: 'hero',
    article: 'morph',
    blog: 'slide',
    category: 'slide',
    journey: 'scale',
    dashboard: 'scale',
    profile: 'scale',
    settings: 'fade',
    login: 'slide',
    register: 'slide',
    search: 'fade',
    mapa: 'morph',
    trilhas: 'slide',
    missoes: 'slide',
    conquistas: 'scale',
    graos: 'morph',
    torrefacao: 'morph',
    biblioteca: 'slide',
    sobre: 'fade',
    contato: 'fade',
    newsletter: 'slide',
    perfil: 'scale',
  } as const;

  export type PageTransitionType = keyof typeof pageTransitions;

  export function getPageTransition(pageType: string): string {
    return pageTransitions[pageType as PageTransitionType] || 'fade';
  }

  export function getTransitionConfig(type: string) {
    const configs = {
      fade: {
        forwards: { old: [{ name: 'fade-out', duration: '250ms' }], new: [{ name: 'fade-in', duration: '300ms' }] },
        backwards: { old: [{ name: 'fade-out', duration: '250ms' }], new: [{ name: 'fade-in', duration: '300ms' }] }
      },
      slide: {
        forwards: { 
          old: [{ name: 'page-slide-left-out', duration: '350ms' }], 
          new: [{ name: 'page-slide-right-in', duration: '450ms' }] 
        },
        backwards: { 
          old: [{ name: 'page-slide-right-out', duration: '350ms' }], 
          new: [{ name: 'page-slide-left-in', duration: '450ms' }] 
        }
      },
      morph: {
        forwards: { 
          old: [{ name: 'morph-out', duration: '400ms' }], 
          new: [{ name: 'morph-in', duration: '500ms' }] 
        },
        backwards: { 
          old: [{ name: 'morph-out', duration: '400ms' }], 
          new: [{ name: 'morph-in', duration: '500ms' }] 
        }
      },
      scale: {
        forwards: { 
          old: [{ name: 'scale-out', duration: '300ms' }], 
          new: [{ name: 'scale-in', duration: '450ms' }] 
        },
        backwards: { 
          old: [{ name: 'scale-out', duration: '300ms' }], 
          new: [{ name: 'scale-in', duration: '450ms' }] 
        }
      },
      hero: {
        forwards: { 
          old: [{ name: 'hero-slide-up-out', duration: '400ms' }], 
          new: [{ name: 'hero-slide-up-in', duration: '600ms' }] 
        },
        backwards: { 
          old: [{ name: 'hero-slide-up-out', duration: '400ms' }], 
          new: [{ name: 'hero-slide-up-in', duration: '600ms' }] 
        }
      }
    };
    return configs[type as keyof typeof configs] || configs.fade;
  }
</script>