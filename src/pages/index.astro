---
import Base from '../layouts/Base.astro'
import HeroCTA from '../components/HeroCTA'
import CategoryNav from '../components/CategoryNav'
import FeedCenter from '../components/FeedCenter'
import ScrollAnimations from '../components/ScrollAnimations.astro'
import HomePersonalized from '../components/HomePersonalized'
---

<Base
  title="Artigo com Café — Ambiente de Leitura Aberto a Todos"
  description="Um ambiente de leitura onde o café é uma analogia do acolhimento. Artigos, receitas, biblioteca e conhecimento para todos."
  canonical="/"
  fullWidth
  breadcrumbs={[{ name: 'Início', slug: '/' }]}
  image="/og-default.png.ts"
>
  {/* ═══ Hero CTA (não logado) ═══ */}
  <div class="landing-view" id="landing-view">
    <HeroCTA client:load />
    <div class="feed-divider" aria-hidden="true">
      <div class="feed-divider-line"></div>
      <div class="feed-divider-content">
        <span class="feed-divider-icon">📰</span>
        <span class="feed-divider-text">Feed de artigos</span>
      </div>
      <div class="feed-divider-line"></div>
    </div>
  </div>

  {/* ═══ Feed Central (sempre visível) ═══ */}
  <div class="feed-content" id="feed-content">
    {/* Filtros rápidos horizontais */}
    <CategoryNav client:load />

    {/* Feed de artigos */}
    <FeedCenter client:visible />
  </div>

  {/* Recomendações personalizadas (logados) */}
  <HomePersonalized client:visible />

  <ScrollAnimations />

  <script>
    import { initLandingAuth } from '../scripts/landing-auth';
    initLandingAuth();
  </script>

  <style>
    /* Feed divider */
    .feed-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 0 auto;
      padding: 1rem 0 0;
    }

    .feed-divider-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--color-bg-card-border), transparent);
    }

    .feed-divider-content {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .feed-divider-icon { font-size: 0.9rem; opacity: 0.6; }

    .feed-divider-text {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-text-muted);
      white-space: nowrap;
    }

    .feed-content {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
  </style>
</Base>