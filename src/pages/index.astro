---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import ArticleCard from '../components/ArticleCard.astro'
import CafeDoDia from '../components/CafeDoDia'
import ReceitaDoDia from '../components/ReceitaDoDia'
import ClimaDoCafe from '../components/ClimaDoCafe'
import { getPosts, getCategories } from '../lib/laravel'

const { posts } = await getPosts(1, 6)
const categories = await getCategories()
---

<Base title="Artigo com Café — Blog de Cafeteria Digital" description="Blog autoral sobre o universo do café: cultura, tecnologia e conhecimento. Conteúdo aprofundado para quem ama aprender." canonical="/" breadcrumbs={[{ name: 'Início', slug: '/' }]} image="/og-default.png.ts">
  <Hero />

  {/* Café do Dia */}
  <section class="section" data-reveal style="padding-top: 1rem; padding-bottom: 0;">
    <div class="container" style="max-width: 720px;">
      <CafeDoDia client:load />
    </div>
  </section>

  {/* Receita do Dia */}
  <section class="section" data-reveal style="padding-top: 1rem; padding-bottom: 0;">
    <div class="container" style="max-width: 720px;">
      <ReceitaDoDia client:load />
    </div>
  </section>

  {/* Clima do Café — sugere a bebida ideal para o dia */}
  <section class="section" data-reveal style="padding-top: 1rem; padding-bottom: 0;">
    <div class="container" style="max-width: 720px;">
      <ClimaDoCafe client:visible />
    </div>
  </section>

  {categories.length > 0 && (
    <section class="section categories-section" data-reveal>
      <div class="container">
        <div class="categories-scroll">
          <a href="/blog" class="category-chip active">Todos</a>
          {categories.slice(0, 10).map(cat => (
            <a href={`/blog?categoria=${cat.slug}`} class="category-chip">{cat.name}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="section-label">Artigos Recentes</span>
        <h2 class="section-title">Últimos do Blog</h2>
        <p class="section-subtitle">
          Escolha um tema, leia com calma e ganhe grãos a cada artigo concluído.
        </p>
      </div>

      {posts.length > 0 ? (
        <div class="articles-grid">
          {posts.map(post => (
            <ArticleCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Nenhum artigo publicado ainda.</p>
          <p>Volte em breve para conferir os novos conteúdos.</p>
        </div>
      )}

      <div class="section-footer" data-reveal>
        <a href="/blog" class="btn-primary">
          Ver todos os artigos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section features-section" data-reveal>
    <div class="container">
      <div class="features-grid">
        <div class="feature-card glass-card">
          <div class="feature-icon" style="background: rgba(0,212,170,0.1); color: var(--color-accent);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
          </div>
          <h3 class="feature-title">Conteúdo Original</h3>
          <p class="feature-desc">Artigos autorais com pesquisa aprofundada sobre cultura, história e técnicas do café — escritos para quem ama aprender de verdade.</p>
        </div>
        <div class="feature-card glass-card">
          <div class="feature-icon" style="background: rgba(124,58,237,0.1); color: var(--color-accent-secondary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <line x1="3" y1="9" x2="21" y2="9" />
              <line x1="9" y1="21" x2="9" y2="9" />
            </svg>
          </div>
          <h3 class="feature-title">Experiência do Usuário</h3>
          <p class="feature-desc">Interface pensada para leitura fluida e confortável, com foco no que importa: o seu tempo de aprendizado.</p>
        </div>
        <div class="feature-card glass-card">
          <div class="feature-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 6v6l4 2" />
            </svg>
          </div>
          <h3 class="feature-title">Leitura que Evolui</h3>
          <p class="feature-desc">Ganhe grãos a cada leitura, complete conquistas e trilhas, e acompanhe sua evolução em uma jornada contínua de conhecimento.</p>
        </div>
      </div>
    </div>
  </section>

    <!-- BlogPosting JSON-LD Schema for homepage -->
  {posts.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      'mainEntityOfPage': {
        '@type': 'WebPage',
        '@id': 'https://artigocomcafe.com'
      },
      'headline': 'Artigo com Café — Blog de Cafeteria Digital',
      'description': 'Blog autoral sobre o universo do café: cultura, tecnologia e conhecimento. Conteúdo aprofundado para quem ama aprender.',
      'image': 'https://artigocomcafe.com/images/og-default.jpg',
      'author': {
        '@type': 'Organization',
        'name': 'Artigo com Café'
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Artigo com Café'
      },
      'dateModified': new Date(posts[0].date).toISOString()
    })} />
  )}

</Base>

<style>
  .categories-section {
    padding: 2rem 0;
  }

  .categories-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .categories-scroll::-webkit-scrollbar {
    height: 4px;
  }

  .categories-scroll::-webkit-scrollbar-thumb {
    background: var(--color-bg-card-border);
    border-radius: 4px;
  }

  .category-chip {
    flex-shrink: 0;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
    white-space: nowrap;
  }

  .category-chip:hover,
  .category-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header .section-subtitle {
    margin: 0 auto;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
  }

  .empty-state p {
    margin-bottom: 0.5rem;
  }

  .section-footer {
    text-align: center;
    margin-top: 3rem;
  }

  .features-section {
    background: var(--color-bg-secondary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    text-align: center;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
