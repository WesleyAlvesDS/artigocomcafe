---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import ArticleCard from '../components/ArticleCard.astro'
import CafeDoDia from '../components/CafeDoDia'
import ReceitaDoDia from '../components/ReceitaDoDia'
import ClimaDoCafe from '../components/ClimaDoCafe'
import ExchangeRateWidget from '../components/ExchangeRateWidget'
import ScrollAnimations from '../components/ScrollAnimations.astro'
import CategoryBar from '../components/CategoryBar.astro'
import AdSterraNative from '../components/AdSterraNative.astro'
import AdSterraSmartLink from '../components/AdSterraSmartLink.astro'
import AdSterraBanner from '../components/AdSterraBanner.astro'
import { getPosts, getCategories } from '../lib/laravel'

const { posts } = await getPosts(1, 6)
const categories = await getCategories()
---

<Base title="Artigo com Café — Blog de Cafeteria Digital" description="Blog autoral sobre o universo do café: cultura, tecnologia e conhecimento. Conteúdo aprofundado para quem ama aprender." canonical="/" breadcrumbs={[{ name: 'Início', slug: '/' }]} image="/og-default.png.ts">
  <Hero />

  {/* Barra de categorias do modelo editorial (logo abaixo do hero) */}
  <div class="container" style="margin-top: -2.25rem; position: relative; z-index: 5;">
    <CategoryBar />
  </div>

  <section class="section home-leaderboard" data-scroll-reveal="fade">
    <div class="container" style="max-width: 760px;">
      <AdSterraBanner key="a2885857c5978b578e5340115924dbb1" width={728} height={90} />
    </div>
  </section>

  {/* ── Experiência imersiva: grade assimétrica dos widgets ── */}
  <section class="section home-experience" data-scroll-reveal="fade">
    <div class="container">
      <div class="experience-header" data-scroll-reveal="fade">
        <div>
          <span class="section-label">Sua Pausa Perfeita</span>
          <h2 class="section-title" style="margin-bottom: 0.35rem;">Um café, muitas descobertas</h2>
        </div>
        <p class="experience-sub">
          Conteúdo, clima e economia — tudo pensado para o seu momento.
        </p>
      </div>

      <div class="experience-grid" data-stagger data-stagger-delay="60" data-stagger-start="100">
        <div class="exp-cell exp-cell-large" data-stagger-item data-scroll-reveal="slide-up">
          <span class="exp-cell-label" aria-hidden="true">
            <span class="pulse-dot"></span> Em destaque hoje
          </span>
          <CafeDoDia client:load />
        </div>

        <div class="exp-cell exp-cell-recipe" data-stagger-item data-scroll-reveal="slide-up">
          <span class="exp-cell-label" aria-hidden="true">
            <span class="pulse-dot"></span> Para preparar agora
          </span>
          <ReceitaDoDia client:load />
        </div>

        <div class="exp-cell exp-cell-clima" data-stagger-item data-scroll-reveal="slide-up">
          <span class="exp-cell-label" aria-hidden="true">
            <span class="pulse-dot"></span> Clima agora
          </span>
          <ClimaDoCafe client:visible />
        </div>

        <div class="exp-cell exp-cell-cambio" data-stagger-item data-scroll-reveal="slide-up">
          <span class="exp-cell-label" aria-hidden="true">
            <span class="pulse-dot"></span> Câmbio ao vivo
          </span>
          <ExchangeRateWidget client:visible compact={true} maxRates={4} />
        </div>
      </div>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="section categories-section" data-scroll-reveal="slide-up" data-scroll-delay="400">
      <div class="container">
        <div class="categories-scroll" data-stagger data-stagger-delay="60">
          <a href="/blog" class="category-chip active" data-stagger-item>Todos</a>
          {categories.slice(0, 10).map(cat => (
            <a href={`/blog?categoria=${cat.slug}`} class="category-chip" data-stagger-item>{cat.name}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-header" data-scroll-reveal="fade">
        <span class="section-label">Artigos Recentes</span>
        <h2 class="section-title">Últimos do Blog</h2>
        <p class="section-subtitle">
          Escolha um tema, leia com calma e ganhe grãos a cada artigo concluído.
        </p>
      </div>

      {posts.length > 0 ? (
        <div class="articles-grid" data-stagger data-stagger-delay="80" data-stagger-start="100">
          {posts.map((post, i) => (
            <ArticleCard post={post} index={i} />
          ))}
        </div>
      ) : (
        <div class="empty-state" data-scroll-reveal="scale">
          <p>Nenhum artigo publicado ainda.</p>
          <p>Volte em breve para conferir os novos conteúdos.</p>
        </div>
      )}

      <div class="section-footer" data-scroll-reveal="fade" data-scroll-delay="200">
        <a href="/blog" class="btn-primary ripple">
          Ver todos os artigos
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-ad-section" data-scroll-reveal="fade">
    <div class="container" style="max-width: 720px;">
      <AdSterraNative lazy />
      <AdSterraSmartLink
        variant="link"
        text="Descubra indicações selecionadas para acompanhar seu café."
        className="home-ad-smartlink"
      />
      <p class="home-ad-disclosure">
        Este site é mantido com o apoio de anúncios e parcerias. Saiba mais sobre
        <a href="/cookies/">como utilizamos cookies de publicidade</a>.
      </p>
    </div>
  </section>

  <section class="section features-section" data-scroll-reveal="fade">
    <div class="container">
      <div class="features-grid" data-stagger data-stagger-delay="100" data-stagger-start="150">
        <div class="feature-card glass-card" data-stagger-item>
          <div class="feature-icon" style="background: rgba(0,212,170,0.1); color: var(--color-accent);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <polyline points="10 9 9 9 8 9" />
            </svg>
          </div>
          <h3 class="feature-title">Conteúdo Original</h3>
          <p class="feature-desc">Artigos autorais com pesquisa aprofundada sobre cultura, história e técnicas do café — escritos para quem ama aprender de verdade.</p>
        </div>
        <div class="feature-card glass-card" data-stagger-item>
          <div class="feature-icon" style="background: rgba(124,58,237,0.1); color: var(--color-accent-secondary);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <line x1="3" y1="9" x2="21" y2="9" />
              <line x1="9" y1="21" x2="9" y2="9" />
            </svg>
          </div>
          <h3 class="feature-title">Experiência do Usuário</h3>
          <p class="feature-desc">Interface pensada para leitura fluida e confortável, com foco no que importa: o seu tempo de aprendizado.</p>
        </div>
        <div class="feature-card glass-card" data-stagger-item>
          <div class="feature-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 6v6l4 2" />
            </svg>
          </div>
          <h3 class="feature-title">Leitura que Evolui</h3>
          <p class="feature-desc">Ganhe grãos a cada leitura, complete conquistas e trilhas, e acompanhe sua evolução em uma jornada contínua de conhecimento.</p>
        </div>
      </div>
    </div>
  </section>

    <!-- BlogPosting JSON-LD Schema for homepage -->
  {posts.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      'mainEntityOfPage': {
        '@type': 'WebPage',
        '@id': 'https://artigocomcafe.com'
      },
      'headline': 'Artigo com Café — Blog de Cafeteria Digital',
      'description': 'Blog autoral sobre o universo do café: cultura, tecnologia e conhecimento. Conteúdo aprofundado para quem ama aprender.',
      'image': 'https://artigocomcafe.com/images/og-default.jpg',
      'author': {
        '@type': 'Organization',
        'name': 'Artigo com Café'
      },
      'publisher': {
        '@type': 'Organization',
        'name': 'Artigo com Café'
      },
      'dateModified': new Date(posts[0].date).toISOString()
    })} />
  )}

  <ScrollAnimations />
</Base>

<style>
  .home-leaderboard {
    padding-top: 0.5rem;
    padding-bottom: 1.5rem;
  }

  /* Barra de categorias do modelo: dentro de um container alinhado */
  .category-bar {
    margin-bottom: 1.5rem;
  }

  /* ── Experiência imersiva ─────────────────────────── */
  .home-experience {
    padding: 3rem 0 2rem;
  }

  .experience-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .experience-sub {
    max-width: 380px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .experience-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.25rem;
  }

  .exp-cell {
    position: relative;
    min-width: 0;
  }

  .exp-cell-large {
    grid-column: span 7;
  }

  .exp-cell-recipe {
    grid-column: span 5;
  }

  .exp-cell-clima {
    grid-column: span 5;
  }

  .exp-cell-cambio {
    grid-column: span 7;
  }

  .exp-cell-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .exp-cell-label .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
  }

  .exp-cell > *:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .exp-cell-large,
    .exp-cell-recipe,
    .exp-cell-clima,
    .exp-cell-cambio {
      grid-column: span 12;
    }
  }

  .home-ad-disclosure {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .home-ad-disclosure a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .home-ad-disclosure a:hover {
    text-decoration: underline;
  }

  .categories-section {
    padding: 1.5rem 0 2.5rem;
  }

  .categories-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .categories-scroll::-webkit-scrollbar {
    height: 4px;
  }

  .categories-scroll::-webkit-scrollbar-thumb {
    background: var(--color-bg-card-border);
    border-radius: 4px;
  }

  .category-chip {
    flex-shrink: 0;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
    white-space: nowrap;
  }

  .category-chip:hover,
  .category-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header .section-subtitle {
    margin: 0 auto;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--color-text-muted);
  }

  .empty-state p {
    margin-bottom: 0.5rem;
  }

  .section-footer {
    text-align: center;
    margin-top: 3rem;
  }

  .features-section {
    background: var(--color-bg-secondary);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    text-align: center;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>