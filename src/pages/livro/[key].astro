---
import Base from '../../layouts/Base.astro'
import BookCard from '../../components/BookCard.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSterraSmartLink from '../../components/AdSterraSmartLink.astro'
import { getBook, getCuratedBooks, bookCover } from '../../lib/books'
import type { OpenLibraryBook, OpenLibraryWork } from '../../lib/types'

// Páginas SEO por livro — geradas no build a partir da curadoria da
// OpenLibrary (mesma estratégia resiliente do laravel.ts: falha → vazio,
// o build SSG nunca quebra quando a API oscila).
export async function getStaticPaths() {
  const curated = await getCuratedBooks(24)
  return curated
    .filter(b => b.key)
    .map(b => ({ params: { key: b.key! } }))
}

const { key } = Astro.params
let book: OpenLibraryWork | null = null
let moreBooks: OpenLibraryBook[] = []
let error = false

try {
  book = await getBook(key!)
  if (!book) error = true
} catch {
  error = true
}

// Recomendados: mesma curadoria, sem repetir o livro atual.
if (book) {
  try {
    const curated = await getCuratedBooks(24)
    moreBooks = curated.filter(b => b.key && b.key !== book!.key).slice(0, 4)
  } catch {
    moreBooks = []
  }
}

const cover = book ? bookCover(book, 'L') : null
const year = book?.first_publish_year ? String(book.first_publish_year).match(/\d{4}/)?.[0] : null
const descriptionText = book?.description
  ? (typeof book.description === 'string' ? book.description : String(book.description))
  : ''

const schemaBook = book ? {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': book.title,
  'alternateName': book.subtitle || undefined,
  'description': descriptionText.substring(0, 500) || undefined,
  'image': cover || undefined,
  'author': (book.authors || []).map(a => ({ '@type': 'Person', 'name': a })),
  'datePublished': year ? `${year}` : undefined,
  'inLanguage': 'pt-BR',
  'publisher': { '@type': 'Organization', 'name': 'Open Library' },
} : null
---

{error || !book ? (
  <Base title="Livro não encontrado — Artigo com Café">
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Livro não encontrado</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          O livro que você procura não está disponível ou foi removido.
        </p>
        <a href="/livros" class="btn-primary">Explorar a biblioteca</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${book.title} — Livro | Artigo com Café`}
    description={descriptionText.substring(0, 160) || `${book.title} — conheça este livro na biblioteca do Artigo com Café.`}
    image={cover || '/images/og-default.svg'}
    type="book"
    canonical={`/livro/${book.key}/`}
    breadcrumbs={[
      { name: 'Início', slug: '/' },
      { name: 'Biblioteca', slug: '/biblioteca/' },
      { name: book.title, slug: `/livro/${book.key}/` }
    ]}
  >
    {schemaBook && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaBook)} />
    )}

    <article class="book-page">
      <div class="book-header-section">
        <div class="book-header-bg">
          <div class="book-header-sphere b-hs-1"></div>
          <div class="book-header-sphere b-hs-2"></div>
        </div>
        <div class="container">
          <div class="book-header" data-scroll-reveal="slide-up">
            <div class="book-meta">
              <span class="book-kicker">📚 Biblioteca Digital</span>
              <span class="book-source">via OpenLibrary</span>
            </div>
            <h1 class="book-title-page">{book.title}</h1>
            {book.subtitle && <p class="book-subtitle-page">{book.subtitle}</p>}
            <p class="book-authors-page">
              {(book.authors || []).join(', ') || 'Autor desconhecido'}
            </p>
            <div class="book-stats-row">
              {year && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                  {year}
                </span>
              )}
              {(book.subjects || []).length > 0 && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                  {(book.subjects || []).length} {book.subjects!.length === 1 ? 'tema' : 'temas'}
                </span>
              )}
              {book.key && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                  {book.key}
                </span>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="book-content-section">
        <div class="container">
          <div class="book-layout">
            <div class="book-main">
              {cover && (
                <div class="book-cover-large" data-scroll-reveal="fade">
                  <img
                    src={cover}
                    alt={`Capa de ${book.title}`}
                    width="480"
                    height="720"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                  <div class="cover-shine" aria-hidden="true"></div>
                </div>
              )}

              <div class="book-description prose" data-scroll-reveal="fade">
                {descriptionText ? (
                  <>
                    <h2>Sobre este livro</h2>
                    <p>{descriptionText}</p>
                  </>
                ) : (
                  <>
                    <h2>Sobre este livro</h2>
                    <p>
                      {book.title} é uma obra {book.subtitle ? `com o subtítulo "${book.subtitle}"` : 'relevante para quem busca conhecimento'}.
                      {book.authors && book.authors.length > 0 ? ` Escrito por ${book.authors.join(', ')}.` : ''}
                      {year ? ` Publicado pela primeira vez em ${year}.` : ''}
                      Descubra este e outros títulos na biblioteca do Artigo com Café.
                    </p>
                  </>
                )}
              </div>

              {(book.subjects || []).length > 0 && (
                <div class="book-subjects" data-scroll-reveal="fade">
                  <h2>Assuntos relacionados</h2>
                  <div class="subject-chips">
                    {book.subjects!.slice(0, 12).map(s => (
                      <a href={`/livros?busca=${encodeURIComponent(s)}`} class="subject-chip">{s}</a>
                    ))}
                  </div>
                </div>
              )}

              <div class="book-actions" data-scroll-reveal="fade">
                <a href="/livros" class="btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
                  Explorar a biblioteca
                </a>
                {book.key && (
                  <a
                    href={`https://openlibrary.org/works/${book.key}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-ghost"
                  >
                    Ver na OpenLibrary →
                  </a>
                )}
              </div>

              <AdSterraNative className="ad-book-inline" lazy />
              <AdSterraSmartLink
                variant="card"
                text="Curioso para saber mais? Conheça outros títulos selecionados na biblioteca do Artigo com Café."
                className="ad-book-smartlink"
              />
            </div>

            <aside class="book-sidebar">
              <AdSterraNative className="ad-book-sidebar" lazy />
              <div class="sidebar-card glass-card" data-scroll-reveal="fade">
                <h3 class="sidebar-title">Sobre a biblioteca</h3>
                <p class="sidebar-text">
                  Milhões de títulos gratuitos via OpenLibrary — café, conhecimento e literatura.
                  Crie sua conta para salvar livros nas suas prateleiras.
                </p>
                <a href="/livros" class="sidebar-link">Explorar todos os livros →</a>
              </div>
              <div class="sidebar-card glass-card" data-scroll-reveal="fade">
                <h3 class="sidebar-title">Compartilhar</h3>
                <div class="share-links">
                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(book.title)}&url=${encodeURIComponent(`https://artigocomcafe.com/livro/${book.key}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Twitter"
                  >𝕏</a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://artigocomcafe.com/livro/${book.key}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Facebook"
                  >f</a>
                  <a
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${book.title} — ${`https://artigocomcafe.com/livro/${book.key}`}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no WhatsApp"
                  >w</a>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </article>

    {moreBooks.length > 0 && (
      <section class="section" data-scroll-reveal="fade">
        <div class="container">
          <div class="section-header">
            <span class="section-label">Continue Explorando</span>
            <h2 class="section-title">Mais Livros para Você</h2>
          </div>
          <div class="books-grid">
            {moreBooks.map((b, i) => (
              <BookCard book={b} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
        </div>
      </section>
    )}
  </Base>
)}

<style is:global>
  .book-page {
    padding-top: 64px;
  }

  .book-header-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 4rem;
    background: color-mix(in srgb, var(--color-bg-card) 40%, var(--color-bg-primary));
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .book-header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .book-header-sphere {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.7;
    animation: float-particle 12s ease-in-out infinite;
  }

  .b-hs-1 {
    width: 380px;
    height: 380px;
    top: -20%;
    left: -5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent);
  }

  .b-hs-2 {
    width: 300px;
    height: 300px;
    bottom: -30%;
    right: 5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-secondary) 18%, transparent), transparent);
    animation-delay: -5s;
  }

  .book-header {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .book-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .book-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .book-source {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .book-title-page {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.9rem;
    background: linear-gradient(135deg, var(--color-text-primary) 30%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .book-subtitle-page {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .book-authors-page {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .book-stats-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .book-stat {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-bg-card) 90%, transparent);
    border: 1px solid var(--color-bg-card-border);
    backdrop-filter: blur(8px);
  }

  .book-stat svg {
    color: var(--color-accent);
  }

  .book-content-section {
    padding: 3rem 0 4rem;
  }

  .book-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .book-main {
    min-width: 0;
  }

  .book-cover-large {
    position: relative;
    max-width: 300px;
    margin: 0 0 2rem;
    aspect-ratio: 2 / 3;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-card), 0 0 0 1px rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-secondary);
  }

  .book-cover-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 45%, color-mix(in srgb, white 7%, transparent) 50%, transparent 60%);
    background-size: 200% 200%;
    animation: gradient-shift 12s ease infinite;
    pointer-events: none;
  }

  .book-description h2,
  .book-subjects h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    scroll-margin-top: 90px;
  }

  .book-description p {
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .book-subjects {
    margin-bottom: 2rem;
  }

  .subject-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subject-chip {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    text-decoration: none;
    transition: all 0.25s;
  }

  .subject-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .book-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 2.5rem;
  }

  .ad-book-inline {
    margin-top: 2.5rem;
  }

  .ad-book-smartlink {
    margin: 3rem 0;
  }

  .book-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 84px;
  }

  .sidebar-card {
    padding: 1.25rem;
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }

  .sidebar-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 0.75rem;
  }

  .sidebar-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .sidebar-link:hover {
    text-decoration: underline;
  }

  .share-links {
    display: flex;
    gap: 0.5rem;
  }

  .share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .share-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 960px) {
    .book-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .book-cover-large {
      max-width: 240px;
    }
    .book-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }
</style>
