---
import Base from '../../layouts/Base.astro'
import BookCard from '../../components/BookCard.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSterraSmartLink from '../../components/AdSterraSmartLink.astro'
import { getBook, getCuratedBooks, bookCover } from '../../lib/books'
import type { OpenLibraryBook, OpenLibraryWork } from '../../lib/types'

// Páginas SEO por livro — geradas no build a partir da curadoria da
// OpenLibrary (mesma estratégia resiliente do laravel.ts: falha → vazio,
// o build SSG nunca quebra quando a API oscila).
export async function getStaticPaths() {
  const curated = await getCuratedBooks(24)
  return curated
    .filter(b => b.key)
    .map(b => ({ params: { key: b.key! } }))
}

const { key } = Astro.params
let book: OpenLibraryWork | null = null
let moreBooks: OpenLibraryBook[] = []
let error = false

try {
  book = await getBook(key!)
  if (!book) error = true
} catch {
  error = true
}

// Recomendados: mesma curadoria, sem repetir o livro atual.
if (book) {
  try {
    const curated = await getCuratedBooks(24)
    moreBooks = curated.filter(b => b.key && b.key !== book!.key).slice(0, 4)
  } catch {
    moreBooks = []
  }
}

// Tradução automática: o backend devolve *_pt quando o texto original não
// é português. Preferimos a versão traduzida, mantendo a original visível.
const displayTitle = book?.title_pt || book?.title || ''
const displaySubtitle = book?.subtitle_pt || book?.subtitle || null
const hasTranslation = Boolean(book?.title_pt)
const descriptionText = book?.description_pt
  ? String(book.description_pt)
  : (book?.description ? (typeof book.description === 'string' ? book.description : String(book.description)) : '')

const cover = book ? bookCover(book, 'L') : null
const year = book?.first_publish_year ? String(book.first_publish_year).match(/\d{4}/)?.[0] : null

// ── Descrição rica de fallback ────────────────────────────────
// Quando a OpenLibrary não traz descrição, montamos um texto informativo
// com o que sabemos: autores, tema, ano, edições, línguas e assuntos.
const editions = book?.editions || []
const editionsCount = book?.editions_count ?? editions.length
const editionYears = editions.map(e => e.year).filter(Boolean) as number[]
const latestEditionYear = editionYears.length ? Math.max(...editionYears) : null
const earliestEditionYear = editionYears.length ? Math.min(...editionYears) : null
const languages = editions.flatMap(e => e.languages || []).filter(Boolean)
const hasLanguages = languages.length > 0

const fallbackDescription = book ? (() => {
  const parts: string[] = []
  parts.push(`${displayTitle} é uma obra ${displaySubtitle ? `com o subtítulo "${displaySubtitle}"` : 'relevante para quem busca conhecimento e aprofundamento'}${(book.authors || []).length ? `, escrita por ${book.authors.join(', ')}` : ''}.`)
  if ((book.subjects || []).length) {
    const subj = book.subjects!.slice(0, 5).join(', ')
    parts.push(`A obra aborda ${subj.toLowerCase()}.`)
  }
  if (year) {
    parts.push(`Publicada pela primeira vez em ${year}.`)
  } else if (earliestEditionYear) {
    parts.push(`Registrada pela primeira vez em ${earliestEditionYear}.`)
  }
  if (editionsCount && editionsCount > 0) {
    const range = latestEditionYear && earliestEditionYear && latestEditionYear !== earliestEditionYear
      ? ` entre ${earliestEditionYear} e ${latestEditionYear}`
      : ''
    parts.push(`Ao todo, são ${editionsCount} ${editionsCount === 1 ? 'edição conhecida' : 'edições conhecidas'}${range}.`)
  }
  if (hasLanguages) {
    const unique = [...new Set(languages)].slice(0, 4).map(l => l.toUpperCase()).join(', ')
    parts.push(`Publicada em ${unique}.`)
  }
  parts.push('Encontre este e outros títulos na biblioteca do Artigo com Café.')
  return parts.join(' ')
})() : ''

const effectiveDescription = descriptionText || fallbackDescription

// Formata a lista de línguas de uma edição (ex.: ["eng","por"] -> "EN, PT")
const langLabel = (codes: string[] = []): string =>
  [...new Set(codes)].slice(0, 3).map(c => c.toUpperCase()).join(', ')

const schemaBook = book ? {
  '@context': 'https://schema.org',
  '@type': 'Book',
  'name': displayTitle,
  'alternateName': displaySubtitle || book.subtitle || undefined,
  'description': effectiveDescription.substring(0, 500) || undefined,
  'image': cover || undefined,
  'author': (book.authors || []).map(a => ({ '@type': 'Person', 'name': a })),
  'datePublished': year ? `${year}` : undefined,
  'inLanguage': 'pt-BR',
  'publisher': { '@type': 'Organization', 'name': 'Open Library' },
  'numberOfEditions': editionsCount && editionsCount > 0 ? editionsCount : undefined,
  'subject': (book.subjects || []).slice(0, 5),
  'url': `https://artigocomcafe.com/livro/${book.key}/`,
} : null

const schemaBreadcrumb = book ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://artigocomcafe.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Biblioteca', 'item': 'https://artigocomcafe.com/biblioteca/' },
    { '@type': 'ListItem', 'position': 3, 'name': displayTitle, 'item': `https://artigocomcafe.com/livro/${book.key}/` },
  ],
} : null
---

{error || !book ? (
  <Base title="Livro não encontrado — Artigo com Café" fullWidth>
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Livro não encontrado</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          O livro que você procura não está disponível ou foi removido.
        </p>
        <a href="/livros" class="btn-primary">Explorar a biblioteca</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${displayTitle} — Livro | Artigo com Café`}
    description={effectiveDescription.substring(0, 160) || `${displayTitle} — conheça este livro na biblioteca do Artigo com Café.`}
    image={cover || '/images/og-default.svg'}
    type="book"
    canonical={`/livro/${book.key}/`}
    fullWidth
    breadcrumbs={[
      { name: 'Início', slug: '/' },      {name: 'Biblioteca', slug: '/dashboard#/biblioteca' },
      { name: displayTitle, slug: `/livro/${book.key}/` }
    ]}
  >
    {schemaBook && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaBook)} />
    )}
    {schemaBreadcrumb && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
    )}

    <article class="book-page">
      <div class="book-header-section">
        <div class="book-header-bg">
          <div class="book-header-sphere b-hs-1"></div>
          <div class="book-header-sphere b-hs-2"></div>
          <div class="book-header-sphere b-hs-3"></div>
        </div>
        <div class="container">
          <div class="book-header" data-scroll-reveal="slide-up">
            <div class="book-meta">
              <span class="book-kicker">📚 Biblioteca Digital</span>
              <span class="book-source">via OpenLibrary{hasTranslation ? ' · traduzido' : ''}</span>
            </div>
            <h1 class="book-title-page">{displayTitle}</h1>
            {hasTranslation && book.title && (
              <p class="book-original-title">Título original: {book.title}</p>
            )}
            {displaySubtitle && <p class="book-subtitle-page">{displaySubtitle}</p>}
            <p class="book-authors-page">
              por <strong>{(book.authors || []).join(', ') || 'Autor desconhecido'}</strong>
            </p>
            <div class="book-stats-row">
              {year && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                  {year}
                </span>
              )}
              {(book.subjects || []).length > 0 && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                  {(book.subjects || []).length} {book.subjects!.length === 1 ? 'tema' : 'temas'}
                </span>
              )}
              {editionsCount && editionsCount > 0 && (
                <span class="book-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
                  {editionsCount} {editionsCount === 1 ? 'edição' : 'edições'}
                </span>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="book-content-section">
        <div class="container">
          <div class="book-layout">
            <div class="book-main">
              {cover && (
                <div class="book-cover-large" data-scroll-reveal="fade">
                  <img
                    src={cover}
                    alt={`Capa de ${displayTitle}`}
                    width="480"
                    height="720"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                  <div class="cover-shine" aria-hidden="true"></div>
                </div>
              )}

              <div class="book-description prose" data-scroll-reveal="fade">
                <h2>Sobre este livro</h2>
                <p>{effectiveDescription}</p>
                {!descriptionText && (
                  <p class="book-desc-note">
                    <em>Resumo gerado automaticamente a partir dos dados da OpenLibrary.</em>
                  </p>
                )}
              </div>

              {(book.subjects || []).length > 0 && (
                <div class="book-subjects" data-scroll-reveal="fade">
                  <h2>Assuntos relacionados</h2>
                  <div class="subject-chips">
                    {book.subjects!.slice(0, 12).map(s => (
                      <a href={`/livros?busca=${encodeURIComponent(s)}`} class="subject-chip">{s}</a>
                    ))}
                  </div>
                </div>
              )}

              {editions.length > 0 && (
                <div class="book-editions" data-scroll-reveal="fade">
                  <div class="editions-head">
                    <h2>Edições e Versões</h2>
                    <span class="editions-count">{editionsCount} {editionsCount === 1 ? 'edição' : 'edições'} na OpenLibrary</span>
                  </div>
                  <div class="editions-list">
                    {editions.slice(0, 8).map((ed, i) => (
                      <div class="edition-card" data-stagger-item>
                        <div class="edition-year">
                          {ed.year ? ed.year : (ed.publish_date || '—')}
                        </div>
                        <div class="edition-body">
                          <div class="edition-top">
                            <span class="edition-name">
                              {ed.edition_name || `${displayTitle}${ed.year ? ` (${ed.year})` : ''}`}
                            </span>
                            {ed.physical_format && <span class="edition-format">{ed.physical_format}</span>}
                          </div>
                          <div class="edition-meta">
                            {ed.publishers && ed.publishers.length > 0 && (
                              <span>{ed.publishers.join(', ')}</span>
                            )}
                            {ed.number_of_pages && <span>{ed.number_of_pages} págs.</span>}
                            {ed.languages && ed.languages.length > 0 && <span>{langLabel(ed.languages)}</span>}
                            {ed.isbn && ed.isbn.length > 0 && (
                              <span class="edition-isbn">ISBN {ed.isbn[0]}</span>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <div class="book-actions" data-scroll-reveal="fade">
                <a href="/livros" class="btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" /></svg>
                  Explorar a biblioteca
                </a>
                {book.key && (
                  <a
                    href={`https://openlibrary.org/works/${book.key}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-ghost"
                  >
                    Ver na OpenLibrary →
                  </a>
                )}
                {/* {isLoggedIn && book.key && (
                  <ShelfSelector bookKey={book.key} bookTitle={displayTitle} client:visible />
                )} */}
              </div>

              <AdSterraNative className="ad-book-inline" lazy />
              <AdSterraSmartLink
                variant="card"
                text="Curioso para saber mais? Conheça outros títulos selecionados na biblioteca do Artigo com Café."
                className="ad-book-smartlink"
              />
            </div>

            <aside class="book-sidebar">
              {/* Sem AdSterraNative aqui: a página já tem o nativo no conteúdo
                  (ad-book-inline) e o containerId é fixo por unidade — 2 na
                  mesma página faz o 2º nunca preencher (regra do MAPA-DE-ANUNCIOS). */}
              <div class="sidebar-card glass-card" data-scroll-reveal="fade">
                <h3 class="sidebar-title">Sobre a biblioteca</h3>
                <p class="sidebar-text">
                  Milhões de títulos gratuitos via OpenLibrary — café, conhecimento e literatura.
                  Crie sua conta para salvar livros nas suas prateleiras.
                </p>
                <a href="/livros" class="sidebar-link">Explorar todos os livros →</a>
              </div>
              <div class="sidebar-card glass-card" data-scroll-reveal="fade">
                <h3 class="sidebar-title">Compartilhar</h3>
                <div class="share-links">
                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(book.title)}&url=${encodeURIComponent(`https://artigocomcafe.com/livro/${book.key}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Twitter"
                  >𝕏</a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://artigocomcafe.com/livro/${book.key}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Facebook"
                  >f</a>
                  <a
                    href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${book.title} — ${`https://artigocomcafe.com/livro/${book.key}`}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no WhatsApp"
                  >w</a>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </article>

    {moreBooks.length > 0 && (
      <section class="section" data-scroll-reveal="fade">
        <div class="container">
          <div class="section-header">
            <span class="section-label">Continue Explorando</span>
            <h2 class="section-title">Mais Livros para Você</h2>
          </div>
          <div class="books-grid">
            {moreBooks.map((b, i) => (
              <BookCard book={b} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
        </div>
      </section>
    )}
  </Base>
)}

<style is:global>
  .book-page {
  }

  .book-header-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 4rem;
    background: color-mix(in srgb, var(--color-bg-card) 40%, var(--color-bg-primary));
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .book-header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .book-header-sphere {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.7;
    animation: float-particle 12s ease-in-out infinite;
  }

  .b-hs-1 {
    width: 380px;
    height: 380px;
    top: -20%;
    left: -5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent);
  }

  .b-hs-2 {
    width: 300px;
    height: 300px;
    bottom: -30%;
    right: 5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-secondary) 18%, transparent), transparent);
    animation-delay: -5s;
  }

  .b-hs-3 {
    width: 200px;
    height: 200px;
    top: 30%;
    right: 20%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent);
    animation-delay: -8s;
  }

  .book-header {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .book-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .book-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .book-source {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .book-title-page {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.9rem;
    background: linear-gradient(135deg, var(--color-text-primary) 30%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .book-original-title {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0.6rem;
    padding: 0.3rem 0.75rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    border-radius: 100px;
    display: inline-block;
  }

  .book-subtitle-page {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .book-authors-page {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .book-authors-page strong {
    color: var(--color-text-primary);
  }

  .book-stats-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .book-stat {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-bg-card) 90%, transparent);
    border: 1px solid var(--color-bg-card-border);
    backdrop-filter: blur(8px);
    transition: color var(--transition), background-color var(--transition), border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .book-stat:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    transform: translateY(-1px);
  }

  .book-stat svg {
    color: var(--color-accent);
  }

  .book-content-section {
    padding: 3rem 0 4rem;
  }

  .book-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .book-main {
    min-width: 0;
  }

  .book-cover-large {
    position: relative;
    max-width: 220px;
    margin: 0 0 1.25rem;
    aspect-ratio: 2 / 3;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-card), 0 0 0 1px rgba(255, 255, 255, 0.03), 0 20px 60px rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-secondary);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.4s;
  }

  .book-cover-large:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-card), 0 0 0 1px rgba(255, 255, 255, 0.03), 0 30px 80px rgba(0, 0, 0, 0.4), var(--shadow-glow);
  }

  .book-cover-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 45%, color-mix(in srgb, white 7%, transparent) 50%, transparent 60%);
    background-size: 200% 200%;
    animation: gradient-shift 12s ease infinite;
    pointer-events: none;
  }

  .book-description h2,
  .book-subjects h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    scroll-margin-top: 90px;
  }

  .book-description p {
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  .book-subjects {
    margin-bottom: 2rem;
  }

  .book-desc-note {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  /* ── Edições e Versões ─────────────────────────── */
  .book-editions {
    margin-bottom: 2.5rem;
  }

  .editions-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .editions-head h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    scroll-margin-top: 90px;
  }

  .editions-count {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
  }

  .editions-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .edition-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    transition: color var(--transition), background-color var(--transition), border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }

  .edition-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
