</style>

<script>
  // Filtro de categorias client-side (SPA-friendly)
  (function() {
    const buttons = document.querySelectorAll('.category-filter-btn');
    const cards = document.querySelectorAll('.product-card');

    function filter(category) {
      cards.forEach(card => {
        const cat = card.dataset.category;
        const match = category === 'all' || cat === category;
        card.style.display = match ? 'flex' : 'none';
        if (match) {
          // Re-trigger stagger animation
          card.style.animation = 'none';
          card.offsetHeight; // force reflow
          card.style.animation = '';
        }
      });
      buttons.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.category === category);
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => filter(btn.dataset.category));
    });

    // Re-inicializa após navegação SPA
    document.addEventListener('astro:after-swap', () => {
      const newButtons = document.querySelectorAll('.category-filter-btn');
      const newCards = document.querySelectorAll('.product-card');
      newButtons.forEach(btn => {
        btn.addEventListener('click', () => filter(btn.dataset.category));
      });
    });
  })();
</script>