  {
    slug: 'caderno-pontos',
    name: 'Caderno Pontos 160 pág',
    description: 'Papel 90g/m², abertura 180°. Para anotações, bullet journal, sketches.',
    price: 49.90,
    image: '/images/products/caderno-pontos.jpg',
