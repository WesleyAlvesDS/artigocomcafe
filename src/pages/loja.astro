---
import Base from '../layouts/Base.astro'
import ProductCard from '../components/ProductCard.astro'
import AdSterraBanner from '../components/AdSterraBanner.astro'
import AdSterraNative from '../components/AdSterraNative.astro'
import ScrollAnimations from '../components/ScrollAnimations.astro'

// Produtos estáticos (máximo 20) — Dropshipping + POD
// TODO: Substituir por API quando fornecedores forem definidos
