  {
    slug: 'poster-cafe-manha',
    name: 'Poster "Ritual da Manhã" A3',
    description: 'Ilustração autoral. Papel premium mate. Emoldure e decore seu cantinho de café.',
    price: 39.90,
    image: '/images/products/poster-cafe-manha.jpg',
