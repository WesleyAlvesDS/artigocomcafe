---
import Base from '../layouts/Base.astro'
import ProductCard from '../components/ProductCard.astro'
import CartDrawer from '../components/CartDrawer.astro'
import AdSterraNative from '../components/AdSterraNative.astro'
import ScrollAnimations from '../components/ScrollAnimations.astro'
import { products, categories, formatBRL } from '../data/products'

---

<Base
  title="Loja Artigo com Café — Produtos para seus momentos de café e leitura"
  description="Pequena loja para apoiar o Artigo com Café. Até 20 produtos selecionados: café especial, métodos de preparo, acessórios e produtos com a identidade da marca. Frete calculado no checkout."
  canonical="/loja/"
  breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Loja', slug: '/loja/' }]}
  image="/images/og-loja.png"
>
  <!-- Hero da Loja -->
  <section class="section loja-hero" data-scroll-reveal="fade">
    <div class="container">
      <div class="loja-hero-content">
        <span class="section-label">🛍️ Loja</span>
        <h1 class="section-title">A Loja do Artigo com Café</h1>
        <p class="section-subtitle" style="max-width: 600px; margin: 1.5rem auto 0;">
          Uma pequena loja para grandes momentos. Produtos escolhidos para acompanhar seu café, sua leitura e suas descobertas. Ao comprar, você apoia a continuidade deste projeto.
        </p>
        <div class="loja-stats" data-stagger data-stagger-delay="80">
          <div class="stat-item" data-stagger-item>
            <span class="stat-number">{products.length}</span>
            <span class="stat-label">Produtos curados</span>
          </div>
          <div class="stat-item" data-stagger-item>
            <span class="stat-number">2</span>
            <span class="stat-label">Pilares: Dropshipping + POD</span>
          </div>
          <div class="stat-item" data-stagger-item>
            <span class="stat-number">100%</span>
            <span class="stat-label">Curadoria própria</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros de Categoria + Busca + Ordenação -->
  <section class="section loja-filters-section" data-scroll-reveal="slide-up">
    <div class="container">
      <div class="loja-toolbar">
        <div class="search-form loja-search">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            id="loja-search"
            class="search-input"
            placeholder="Buscar produto..."
            aria-label="Buscar produto"
            autocomplete="off"
          />
        </div>
        <select id="loja-sort" class="filter-select loja-sort" aria-label="Ordenar produtos">
          <option value="featured">Destaques</option>
          <option value="price-asc">Menor preço</option>
          <option value="price-desc">Maior preço</option>
          <option value="name">Nome (A–Z)</option>
        </select>
      </div>

      <div class="categories-scroll" data-stagger data-stagger-delay="60">
        {categories.map((cat, i) => (
          <button
            class:list={['category-filter-btn', { active: i === 0 }]}
            data-category={cat.id}
            data-stagger-item
            data-count={cat.count}
          >
            <span class="cat-label">{cat.label}</span>
            <span class="cat-count">{cat.count}</span>
          </button>
        ))}
      </div>
      <p class="loja-results" id="loja-results" role="status" aria-live="polite"></p>
    </div>
  </section>

  <!-- Grade de Produtos -->
  <section class="section loja-products-section" data-scroll-reveal="fade">
    <div class="container">
      <div id="products-grid" class="products-grid" data-stagger data-stagger-delay="80">
        {products.map((product, i) => (
          <ProductCard product={product} index={i} revealDelay={`delay-${(i % 4) + 1}`} />
        ))}
      </div>

      <div class="section-footer" data-scroll-reveal="fade" data-scroll-delay="200">
        <p class="loja-footer-text">
          <strong>Poucos produtos. Boas escolhas.</strong> Nossa curadoria é intencionalmente enxuta — até 20 itens que fazem sentido no universo do Artigo com Café.
        </p>
      </div>
    </div>
  </section>

  <!-- Seção: Como funciona -->
  <section class="section loja-how-section" data-scroll-reveal="fade">
    <div class="container">
      <div class="section-header" data-scroll-reveal="fade">
        <span class="section-label">Como funciona</span>
        <h2 class="section-title">Sua compra, sua jornada</h2>
        <p class="section-subtitle">Experiência integrada do conteúdo ao produto.</p>
      </div>
      <div class="how-grid" data-stagger data-stagger-delay="80">
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">🔍</div>
          <h3 class="how-title">Descubra</h3>
          <p class="how-desc">Navegue pela loja ou clique em recomendações dentro dos artigos. Cada produto foi escolhido pela equipe.</p>
        </div>
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">🛒</div>
          <h3 class="how-title">Adicione ao carrinho</h3>
          <p class="how-desc">Carrinho lateral fluido. Misture dropshipping e POD no mesmo pedido — o sistema organiza tudo.</p>
        </div>
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">💳</div>
          <h3 class="how-title">Checkout moderno</h3>
          <p class="how-desc">Pix, cartão, boleto. Endereço salvo no perfil. Cupom de grãos da jornada aplicado automaticamente.</p>
        </div>
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">📦</div>
          <h3 class="how-title">Acompanhe no Dashboard</h3>
          <p class="how-desc">Pedido único, múltiplos fornecedores. Status unificado: confirmado → preparação → enviado → entregue.</p>
        </div>
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">☕</div>
          <h3 class="how-title">Chegou? Hora do café</h3>
          <p class="how-desc">Ao receber, o dashboard sugere artigos relacionados. Compra → entrega → conteúdo → nova descoberta.</p>
        </div>
        <div class="how-card glass-card" data-stagger-item>
          <div class="how-icon" aria-hidden="true">🫘</div>
          <h3 class="how-title">Ganhe grãos</h3>
          <p class="how-desc">Cada compra gera grãos. Troque por descontos, frete grátis ou acesso antecipado a coleções POD.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA de apoio -->
  <section class="section loja-support-section" data-scroll-reveal="fade">
    <div class="container">
      <div class="support-card glass-card">
        <div class="support-icon" aria-hidden="true">☕</div>
        <h2 class="support-title">Por que comprar aqui?</h2>
        <p class="support-text">
          O Artigo com Café é um projeto independente. Cada compra — seja um café especial, uma camiseta ou um kit — ajuda a manter os artigos, receitas e a biblioteca no ar, gratuitos para todos.
        </p>
        <div class="support-points">
          <span>💚 Apoio direto ao projeto</span>
          <span>🫘 Grãos na sua jornada</span>
          <span>🚚 Frete grátis acima de {formatBRL(199)}</span>
          <span>↩️ Troca em até 7 dias</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Newsletter -->
  <section class="section home-ad-section" data-scroll-reveal="fade">
    <div class="container" style="max-width: 720px;">
      <AdSterraNative lazy />
      <p class="home-ad-disclosure">
        Esta loja apoia o Artigo com Café. Produtos de parceiros (dropshipping) e produção sob demanda (POD).
        Saiba mais sobre <a href="/cookies/">como utilizamos cookies de publicidade</a>.
      </p>
    </div>
  </section>

  <CartDrawer />
  <ScrollAnimations />

  <script>
    // Filtro de categorias + busca + ordenação — SPA-friendly com delegação
    // (um único listener no document: sem listeners duplicados após o swap).
    (function () {
      let grid = document.getElementById('products-grid')
      if (!grid) return

      let results = document.getElementById('loja-results')
      let searchInput = document.getElementById('loja-search')
      let sortSelect = document.getElementById('loja-sort')

      let activeCategory = 'all'
      let searchTerm = ''

      function visibleCards() {
        const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[]
        const term = searchTerm.trim().toLowerCase()

        const filtered = cards.filter(card => {
          const catOk = activeCategory === 'all' || card.dataset.category === activeCategory
          const searchOk = !term || (card.dataset.search || '').includes(term)
          return catOk && searchOk
        })

        const sort = sortSelect ? sortSelect.value : 'featured'
        if (sort === 'price-asc') {
          filtered.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price))
        } else if (sort === 'price-desc') {
          filtered.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price))
        } else if (sort === 'name') {
          filtered.sort((a, b) => (a.dataset.search || '').localeCompare(b.dataset.search || '', 'pt-BR'))
        } else {
          // 'featured': mantém a ordem original do grid (ordem do DOM)
          const order = new Map<string, number>()
          cards.forEach((c, i) => order.set(c.dataset.product || '', i))
          filtered.sort((a, b) => (order.get(a.dataset.product || '') || 0) - (order.get(b.dataset.product || '') || 0))
        }

        return filtered
      }

      function applyFilters() {
        const allCards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[]
        const filtered = visibleCards()
        const filteredSet = new Set(filtered)

        allCards.forEach(card => {
          card.style.display = filteredSet.has(card) ? 'flex' : 'none'
          if (filteredSet.has(card)) {
            card.style.animation = 'none'
            card.offsetHeight // reflow
            card.style.animation = ''
          }
        })

        // Reordena no DOM respeitando a ordenação escolhida
        filtered.forEach(card => grid.appendChild(card))

        if (results) {
          const total = allCards.length
          results.textContent = `${filtered.length} de ${total} ${total === 1 ? 'produto' : 'produtos'}`
        }
      }

      function bindControls() {
        searchInput = document.getElementById('loja-search')
        sortSelect = document.getElementById('loja-sort')
        results = document.getElementById('loja-results')

        if (searchInput && !searchInput.dataset.lojaBound) {
          searchInput.dataset.lojaBound = '1'
          searchInput.addEventListener('input', () => {
            searchTerm = searchInput.value
            applyFilters()
          })
        }
        if (sortSelect && !sortSelect.dataset.lojaBound) {
          sortSelect.dataset.lojaBound = '1'
          sortSelect.addEventListener('change', () => applyFilters())
        }
      }

      // Delegação: sobrevive à navegação SPA sem duplicar listeners
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement | null)?.closest?.('.category-filter-btn')
        if (!btn) return
        const cat = (btn as HTMLElement).dataset.category
        if (!cat) return
        activeCategory = cat
        document.querySelectorAll('.category-filter-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.category === cat)
        })
        applyFilters()
      })

      // Re-sincroniza após navegação SPA (novo DOM, mesmos filtros)
      document.addEventListener('astro:after-swap', () => {
        setTimeout(() => {
          const newGrid = document.getElementById('products-grid')
          if (!newGrid || newGrid.querySelectorAll('.product-card').length === 0) return
          grid = newGrid
          bindControls()
          applyFilters()
        }, 100)
      })

      bindControls()
      applyFilters()
    })()
  </script>
</Base>

<style>
  /* ── Hero da Loja ───────────────────────────────────── */
  .loja-hero {
    padding: 5rem 0 3rem;
    text-align: center;
  }

  .loja-hero .section-title {
    margin-bottom: 1rem;
  }

  .loja-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--gradient-from), var(--gradient-to));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  /* ── Barra de ferramentas (busca + ordenação) ──────── */
  .loja-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }

  .loja-search { flex: 1; min-width: 240px; max-width: 420px; }

  .loja-sort { min-width: 180px; }

  /* ── Filtros de Categoria ───────────────────────────── */
  .loja-filters-section {
    padding: 1.5rem 0 2rem;
  }

  .categories-scroll {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .categories-scroll::-webkit-scrollbar {
    display: none;
  }

  .category-filter-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    white-space: nowrap;
  }

  .category-filter-btn:hover,
  .category-filter-btn.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
    background: var(--color-bg-card-border);
    padding: 0.1rem 0.5rem;
    border-radius: 100px;
  }

  .category-filter-btn.active .cat-count {
    background: var(--color-accent);
    color: var(--color-btn-text);
  }

  .loja-results {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    margin: 0.9rem 0 0;
  }

  /* ── Grade de Produtos ──────────────────────────────── */
  .loja-products-section {
    padding: 2rem 0 4rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
  }

  .loja-footer-text {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .loja-footer-text strong {
    color: var(--color-text-primary);
  }

  /* ── Como funciona ──────────────────────────────────── */
  .loja-how-section {
    padding: 4rem 0;
    background: var(--color-bg-secondary);
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .how-card {
    padding: 2rem;
    text-align: center;
    transition: transform 0.35s, box-shadow 0.35s, border-color 0.35s;
  }

  .how-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.18);
  }

  .how-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1;
  }

  .how-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
  }

  .how-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Apoio ─────────────────────────────────────────── */
  .loja-support-section { padding: 2rem 0 5rem; }

  .support-card {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .support-icon { font-size: 2.4rem; margin-bottom: 0.8rem; }

  .support-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 0.8rem;
    font-family: var(--font-serif);
  }

  .support-text {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 620px;
    margin: 0 auto 1.4rem;
  }

  .support-points {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .support-points span {
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    padding: 0.45rem 0.9rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
  }
</style>
