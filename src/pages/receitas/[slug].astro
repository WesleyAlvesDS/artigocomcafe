---
import Base from '../../layouts/Base.astro'
import RecipeCard from '../../components/RecipeCard.astro'
import ReadingTracker from '../../components/ReadingTracker'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSterraSmartLink from '../../components/AdSterraSmartLink.astro'
import AdSterraBanner from '../../components/AdSterraBanner.astro'
import AdSenseSlot from '../../components/AdSenseSlot.astro'
import { formatDate } from '../../lib/utils'
import { getRecipe, getAllRecipeSlugs } from '../../lib/laravel'
import type { Recipe } from '../../lib/types'

export async function getStaticPaths() {
  const slugs = await getAllRecipeSlugs()
  return slugs.map(slug => ({ params: { slug } }))
}

const { slug } = Astro.params
let recipe: Recipe | null = null
let related: Recipe[] = []
let error = false

try {
  const result = await getRecipe(slug!)
  if (result) {
    recipe = result.recipe
    related = result.related
  } else {
    error = true
  }
} catch {
  error = true
}

const difficultyLabel: Record<string, string> = { facil: 'Fácil', media: 'Média', dificil: 'Difícil' }

// ── Conversor de porções ────────────────────────────────────────
// O backend costuma gravar a quantidade dentro do campo `unit`
// (ex.: "2 1/2 tbs", "150ml", "1 cup", "4"), com `amount` nulo.
// Este parser extrai (quantidade, unidade) do jeito que vier.
interface RawIngredient {
  name: string
  amount?: string | null
  unit?: string | null
}

function parseIngredientQty(ing: RawIngredient): { qty: string; unit: string; name: string } {
  const raw = [ing.amount, ing.unit].filter(Boolean).join(' ').trim()
  if (!raw) return { qty: '', unit: '', name: ing.name }
  // Número + unidade ("2 1/2 tbs", "150ml", "1 cup", "4")
  const m = raw.match(/^(\d+\s+\d+\/\d+|\d+\/\d+|\d+(?:[.,]\d+)?)\s*(.*)$/)
  if (m) return { qty: m[1].replace(',', '.'), unit: m[2].trim(), name: ing.name }
  // Sem número: texto descritivo (ex.: "a gosto") — junta ao nome para não duplicar
  const suffix = raw.toLowerCase()
  const name = ing.name.toLowerCase().includes(suffix) ? ing.name : `${ing.name} ${raw}`
  return { qty: '', unit: '', name }
}

// Dados preparados para o conversor (quantidade como número decimal)
// "2 1/2" -> 2.5 · "1/2" -> 0.5 · "150" -> 150
function qtyToNumber(q: string): number | null {
  let total = 0
  let found = false
  for (const part of q.split(/\s+/)) {
    if (!part) continue
    if (part.includes('/')) {
      const [n, d] = part.split('/').map(Number)
      if (!d) return null
      total += n / d
      found = true
    } else {
      const v = parseFloat(part)
      if (isNaN(v)) return null
      total += v
      found = true
    }
  }
  return found && isFinite(total) && total > 0 ? total : null
}

const ingredientData = (recipe?.ingredients || []).map(ing => {
  const { qty, unit, name } = parseIngredientQty(ing)
  return { qty: qtyToNumber(qty), qtyRaw: qty, unit, name }
})

// Schema.org Recipe
const schemaRecipe = recipe ? {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.title,
  headline: recipe.title,
  description: recipe.excerpt || recipe.description || recipe.title,
  image: recipe.cover_image || 'https://artigocomcafe.com/images/recipe-default.svg',
  datePublished: recipe.published_at,
  recipeCategory: recipe.category?.name,
  recipeCuisine: recipe.meta?.cuisine || 'Brasileira',
  prepTime: recipe.prep_time_minutes != null ? `PT${recipe.prep_time_minutes}M` : undefined,
  cookTime: recipe.cook_time_minutes != null ? `PT${recipe.cook_time_minutes}M` : undefined,
  totalTime: recipe.prep_time_minutes != null || recipe.cook_time_minutes != null
    ? `PT${(recipe.prep_time_minutes || 0) + (recipe.cook_time_minutes || 0)}M`
    : undefined,
  recipeYield: recipe.servings ? String(recipe.servings) : undefined,
  recipeDifficulty: difficultyLabel[recipe.difficulty] || recipe.difficulty,
  author: { '@type': 'Organization', name: 'Artigo com Café' },
  publisher: { '@type': 'Organization', name: 'Artigo com Café' },
  recipeIngredient: (recipe.ingredients || []).map((i: { name: string; amount?: string | null; unit?: string | null }) =>
    [i.amount, i.unit, i.name].filter(Boolean).join(' ')
  ),
  recipeInstructions: (recipe.steps || []).map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text: s.description || String(s),
  })),
} : null
---

{error || !recipe ? (
  <Base title="Receita não encontrada — Artigo com Café">
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Receita não encontrada</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          A receita que você procura não está disponível ou foi removida.
        </p>
        <a href="/receitas" class="btn-primary">Ver todas as receitas</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${recipe.title} — Artigo com Café`}
    description={(recipe.excerpt || recipe.description || '').substring(0, 160)}
    image={recipe.cover_image || '/images/recipe-default.svg'}
    type="article"
    canonical={`/receitas/${recipe.slug}/`}
    fullWidth
    breadcrumbs={[
      { name: 'Início', slug: '/' },
      { name: 'Receitas', slug: '/receitas/' },
      { name: recipe.title, slug: `/receitas/${recipe.slug}/` }
    ]}
  >
    {schemaRecipe && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaRecipe)} />
    )}

    <article class="recipe-page">
      <div class="recipe-header-section">
        <div class="recipe-header-bg">
          <div class="recipe-header-sphere r-hs-1"></div>
          <div class="recipe-header-sphere r-hs-2"></div>
        </div>
        <div class="container">
          <div class="recipe-header" data-reveal>
            <div class="recipe-meta">
              {recipe.category && (
                <span class="recipe-category" style={`color: ${recipe.category.color || 'var(--color-accent)'}`}>
                  {recipe.category.icon && <span aria-hidden="true">{recipe.category.icon}</span>}
                  {recipe.category.name}
                </span>
              )}
              <span class="recipe-date">{formatDate(recipe.published_at)}</span>
              <span class="recipe-badge-live"><span class="pulse-dot"></span> Receita verificada</span>
            </div>
            <h1 class="recipe-title">{recipe.title}</h1>
            <p class="recipe-excerpt-header">{recipe.excerpt}</p>
            <div class="recipe-toolbar">
              <button class="recipe-print-btn" id="recipe-print-btn" type="button" aria-label="Imprimir receita">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 6 2 18 2 18 9" />
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                  <rect x="6" y="14" width="12" height="8" />
                </svg>
                Imprimir
              </button>
              <span class="recipe-prep-progress" id="recipe-prep-progress">0% preparado</span>
            </div>
            <div class="recipe-stats-row">
              {recipe.prep_time_minutes != null && (
                <span class="recipe-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                  Preparo: {recipe.prep_time_minutes} min
                </span>
              )}
              {recipe.cook_time_minutes != null && recipe.cook_time_minutes > 0 && (
                <span class="recipe-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" /></svg>
                  Cozimento: {recipe.cook_time_minutes} min
                </span>
              )}
              {recipe.servings != null && (
                <span class="recipe-stat">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                  {recipe.servings} porções
                </span>
              )}
              <span class="recipe-stat">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 7 4 4 20 4 20 7" /><line x1="9" y1="20" x2="15" y2="20" /><line x1="12" y1="4" x2="12" y2="20" /></svg>
                {difficultyLabel[recipe.difficulty] || recipe.difficulty}
              </span>
            </div>
            {recipe.tags.length > 0 && (
              <div class="recipe-tags">
                {recipe.tags.map(tag => (
                  <a href={`/receitas?tag=${tag.slug}`} class="tag">#{tag.name}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {recipe.cover_image && (
        <div class="recipe-cover" data-reveal>
          <div class="container">
            <div class="cover-frame">
               <img src={recipe.cover_image} alt={recipe.title} class="cover-image" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
            </div>
          </div>
        </div>
      )}

      <div class="recipe-content-section">
        <div class="container">
          <div class="recipe-layout">
            <div class="recipe-main">
              {recipe.description && (
                <div class="recipe-description prose" data-reveal>
                  <h2>Sobre esta receita</h2>
                  <p>{recipe.description}</p>
                </div>
              )}

              <section class="recipe-ingredients" data-reveal>
                <div class="section-head-row">
                  <h2>Ingredientes</h2>
                  {(recipe.servings != null && recipe.servings > 0) && (
                    <div class="servings-stepper" aria-label="Ajustar porções">
                      <button type="button" class="stepper-btn" id="servings-minus" aria-label="Diminuir porções" disabled>−</button>
                      <span class="stepper-value"><strong id="servings-value">{recipe.servings}</strong> porções</span>
                      <button type="button" class="stepper-btn" id="servings-plus" aria-label="Aumentar porções">+</button>
                    </div>
                  )}
                </div>
                <ul class="ingredients-list" id="ingredients-list">
                  {(recipe.ingredients || []).map((ing, i) => (
                    <li class="ingredient-item" data-ingredient-row={i}>
                      <label>
                        <input type="checkbox" class="ingredient-check" data-ingredient={i} />
                        <span class="ingredient-text">
                          <span class="ingredient-qty" data-ingredient-qty data-qty={ingredientData[i]?.qty ?? ''}>
                            {ingredientData[i]?.qtyRaw || ''}
                          </span>
                          {ingredientData[i]?.qty != null && ingredientData[i]?.unit ? ' ' : ''}
                          <span class="ingredient-unit" data-ingredient-unit>{ingredientData[i]?.unit || ''}</span>{' '}
                          <span class="ingredient-name" data-ingredient-name>{ingredientData[i]?.name || ing.name}</span>
                          {ing.optional && <em class="ingredient-optional"> (opcional)</em>}
                        </span>
                      </label>
                      <button
                        type="button"
                        class="ingredient-sub-btn"
                        data-sub-btn={i}
                        aria-label={`Ver substituições de ${ing.name}`}
                        title="Ver substituições"
                      >↔</button>
                      <div class="ingredient-sub-menu" data-sub-menu={i} role="menu" aria-hidden="true">
                        <div class="sub-menu-head">
                          <span class="sub-menu-title">Substituir <strong data-sub-orig-name>{ing.name}</strong></span>
                          <button type="button" class="sub-menu-close" data-sub-close={i} aria-label="Fechar">✕</button>
                        </div>
                        <div class="sub-menu-options" data-sub-options={i}></div>
                      </div>
                    </li>
                  ))}
                </ul>
                <p class="ingredients-progress" id="ingredients-progress">0/{recipe.ingredients.length} ingredientes</p>
              </section>

              {/* Slot reservado para o Google AdSense (após ingredientes, desabilitado até criar a unidade) */}
              <AdSenseSlot />

              <section class="recipe-steps" data-reveal>
                <div class="section-head-row">
                  <h2>Modo de Preparo</h2>
                  <span class="steps-count">{(recipe.steps || []).length} {(recipe.steps || []).length === 1 ? 'passo' : 'passos'}</span>
                </div>
                <ol class="steps-list">
                  {(recipe.steps || []).map((s, i) => (
                    <li class="step-item" data-step={i}>
                      <span class="step-number">{i + 1}</span>
                      <div class="step-content">
                        <p class="step-text">{s.description || String(s)}</p>
                        <span class="step-time" data-step-time={i} aria-hidden="true"></span>
                      </div>
                      <label class="step-done" aria-label={`Marcar passo ${i + 1} como concluído`}>
                        <input type="checkbox" class="step-check" data-step-check={i} />
                        <span class="step-done-icon">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                      </label>
                    </li>
                  ))}
                </ol>
              </section>

              <section class="recipe-chef-tips" data-reveal>
                <div class="tips-head">
                  <span class="tips-icon" aria-hidden="true">👨‍🍳</span>
                  <div>
                    <h2>Dicas do Chef</h2>
                    <p>Truques profissionais para um resultado impecável</p>
                  </div>
                </div>
                <div class="tips-grid" id="chef-tips"></div>
              </section>

               <ReadingTracker recipeId={recipe.id} articleTitle={recipe.title} client:visible />

      <div class="recipe-author" data-reveal>
                <div class="author-avatar">&#9749;</div>
                <div class="author-info">
                  <span class="author-label">Receita de</span>
                  <strong class="author-name">Artigo com Café</strong>
                  <p class="author-bio">
                    Receitas autorais para acompanhar sua pausa para o conhecimento.
                  </p>
                </div>
                <a href="/sobre" class="author-link">Conheça o projeto →</a>
              </div>

              <AdSterraSmartLink
                variant="card"
                text="Gostou desta receita? Descubra seleções e experiências recomendadas para acompanhar sua próxima xícara."
                className="ad-recipe-smartlink"
              />

              <AdSterraBanner key="5e4796fac36254508762271cad34a145" width={468} height={60} className="ad-recipe-banner" lazy />
            </div>

            <aside class="recipe-sidebar">
              <AdSterraNative className="ad-recipe-sidebar" lazy />
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-title">Dica do barista</h3>
                <p class="sidebar-text">
                  Use sempre água filtrada e ingredientes em temperatura ambiente para melhores resultados.
                </p>
              </div>
              {recipe.category && (
                <div class="sidebar-card glass-card" data-reveal>
                  <h3 class="sidebar-title">Categoria</h3>
                  <a href={`/receitas?categoria=${recipe.category.slug}`} class="sidebar-tag">
                    {recipe.category.icon && <span aria-hidden="true">{recipe.category.icon}</span>} {recipe.category.name}
                  </a>
                </div>
              )}
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-title">Compartilhar</h3>
                <div class="share-links">
                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(recipe.title)}&url=${encodeURIComponent(`https://artigocomcafe.com/receitas/${recipe.slug}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Twitter"
                  >𝕏</a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://artigocomcafe.com/receitas/${recipe.slug}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Facebook"
                  >f</a>
                  <button class="share-link" id="copy-link" aria-label="Copiar link" data-url={`https://artigocomcafe.com/receitas/${recipe.slug}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  </button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="section" data-reveal>
        <div class="container">
          <div class="section-header">
            <span class="section-label">Continue Cozinhando</span>
            <h2 class="section-title">Receitas Relacionadas</h2>
          </div>
          <div class="recipes-grid">
            {related.slice(0, 4).map((r, i) => (
              <RecipeCard recipe={r} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
        </div>
      </section>
    )}

    <script is:inline define:vars={{
      recipePrep: recipe.prep_time_minutes || 0,
      recipeCook: recipe.cook_time_minutes || 0,
      recipeDifficulty: recipe.difficulty,
      recipeCategoryName: recipe.category?.name || '',
      recipeIngredientData: ingredientData,
      recipeBaseServings: recipe.servings || 0,
      recipeStepCount: (recipe.steps || []).length
    }}>
      (function() {
        // 1. Ingredient checklist progress
        const ingredientsList = document.getElementById('ingredients-list')
        const progressEl = document.getElementById('ingredients-progress')
        if (ingredientsList && progressEl) {
          const checkboxes = ingredientsList.querySelectorAll('.ingredient-check')
          const total = checkboxes.length
          const update = () => {
            const checked = [...checkboxes].filter(c => c.checked).length
            progressEl.textContent = `${checked}/${total} ingredientes`
            ingredientsList.classList.toggle('all-ready', checked === total && total > 0)
            updatePrepProgress()
          }
          checkboxes.forEach(cb => cb.addEventListener('change', update))
        }

        const copyBtn = document.getElementById('copy-link')
        if (copyBtn) {
          copyBtn.addEventListener('click', async () => {
            const url = copyBtn.getAttribute('data-url')
            if (url) {
              try {
                await navigator.clipboard.writeText(url)
                copyBtn.style.color = 'var(--color-accent)'
                setTimeout(() => { copyBtn.style.color = '' }, 2000)
              } catch {}
            }
          })
        }

        // 2. Estimated time per step (proportional to total time)
        const stepTimes = document.querySelectorAll('[data-step-time]')
        const stepChecks = document.querySelectorAll('[data-step-check]')
        const totalTime = (recipePrep || 0) + (recipeCook || 0)
        const nSteps = recipeStepCount
        if (stepTimes.length > 0 && totalTime > 0 && nSteps > 0) {
          // Distribui o tempo total entre os passos, com peso um pouco maior
          // para o meio do preparo (etapas principais).
          const weights = []
          for (let i = 0; i < nSteps; i++) {
            const center = Math.abs(i - (nSteps - 1) / 2) / Math.max(1, (nSteps - 1) / 2)
            weights.push(1 + (1 - center) * 0.6)
          }
          const totalW = weights.reduce((a, b) => a + b, 0)
          let acc = 0
          stepTimes.forEach((el, i) => {
            const mins = Math.max(1, Math.round((totalTime * weights[i] / totalW) / 5) * 5)
            acc += mins
            el.textContent = `≈ ${mins} min`
          })
        }

        // 3. Chef tips (dynamic, based on recipe data)
        const tipsBox = document.getElementById('chef-tips')
        if (tipsBox) {
          const tips = []
          const hasOven = recipeCook > 0
          const cats = recipeCategoryName.toLowerCase()

          if (hasOven) {
            tips.push({
              icon: '🔥',
              title: 'Temperatura do forno',
              text: 'Preaqueça o forno sempre 10–15 min antes e evite abrir a porta durante o cozimento — a variação de temperatura compromete a textura final.'
            })
          }
          tips.push({
            icon: '🌡️',
            title: 'Ingredientes em ponto',
            text: 'Retire ovos, manteiga e laticínios da geladeira 30 min antes: ingredientes em temperatura ambiente incorporam melhor e garantem emulsão estável.'
          })
          if (recipeDifficulty === 'facil') {
            tips.push({
              icon: '✅',
              title: 'Mise en place',
              text: 'Separe e pese todos os ingredientes antes de começar. O preparo flui sem pausas e o risco de esquecer algo cai pela metade.'
            })
          } else if (recipeDifficulty === 'dificil') {
            tips.push({
              icon: '🎯',
              title: 'Passos críticos',
              text: 'Nas receitas mais complexas, execute cada etapa com atenção total — separe o dobro do tempo estimado para as etapas de emulsão e montagem.'
            })
          }
          if (cats.includes('café') || cats.includes('coffee')) {
            tips.push({
              icon: '☕',
              title: 'Toque de café',
              text: 'Use café recém-moído e ajuste a moagem ao método: extrações curtas pedem moagem fina, preparos longos pedem moagem mais grossa.'
            })
          }
          if (cats.includes('sobremesa') || cats.includes('doce') || cats.includes('dessert')) {
            tips.push({
              icon: '🍫',
              title: 'Finalização doce',
              text: 'Deixe a sobremesa descansar antes de servir: o repouso estabiliza texturas e intensifica os sabores.'
            })
          }
          // Fallback universal
          tips.push({
            icon: '👨‍🍳',
            title: 'Prova final',
            text: 'Ajuste sal, acidez e doçura ao final — cada paladar é único, e pequenos ajustes transformam um bom prato em memorável.'
          })

          tips.slice(0, 4).forEach(tip => {
            const card = document.createElement('div')
            card.className = 'tip-card'
            card.style.setProperty('--tip-delay', '0ms')
            card.innerHTML = `
              <span class="tip-icon" aria-hidden="true">${tip.icon}</span>
              <div class="tip-body">
                <strong class="tip-title">${tip.title}</strong>
                <p class="tip-text">${tip.text}</p>
              </div>
            `
            tipsBox.appendChild(card)
          })
        }

        // 4. Overall prep progress (ingredients + steps)
        const prepBar = document.getElementById('recipe-prep-progress')
        function updatePrepProgress() {
          if (!prepBar) return
          let done = 0
          let total = 0
          const ingBoxes = ingredientsList ? ingredientsList.querySelectorAll('.ingredient-check') : []
          total += ingBoxes.length
          done += [...ingBoxes].filter(c => c.checked).length
          stepChecks.forEach(cb => { total++; if (cb.checked) done++ })
          if (total === 0) return
          const pct = Math.round((done / total) * 100)
          prepBar.textContent = `${pct}% preparado`
          prepBar.classList.toggle('complete', pct === 100)
        }
        stepChecks.forEach(cb => {
          cb.addEventListener('change', () => {
            const item = cb.closest('.step-item')
            if (item) item.classList.toggle('done', cb.checked)
            updatePrepProgress()
          })
        })
        updatePrepProgress()

        // 5. Print button
        const printBtn = document.getElementById('recipe-print-btn')
        if (printBtn) {
          printBtn.addEventListener('click', () => window.print())
        }

        // 6. Conversor de porções
        const servingsValue = document.getElementById('servings-value')
        const servingsMinus = document.getElementById('servings-minus')
        const servingsPlus = document.getElementById('servings-plus')
        const baseServings = Number(recipeBaseServings) || 0
        const rows = document.querySelectorAll('[data-ingredient-row]')

        // Frações amigáveis para exibição
        const FRACTIONS = { 0.25: '1/4', 0.33: '1/3', 0.5: '1/2', 0.66: '2/3', 0.75: '3/4' }
        function formatQty(n) {
          if (!isFinite(n) || n <= 0) return ''
          const rounded = Math.round(n * 100) / 100
          const whole = Math.floor(rounded)
          let frac = rounded - whole
          // Aproxima para as frações mais comuns
          let best = ''
          let bestDiff = 0.06
          for (const [dec, label] of Object.entries(FRACTIONS)) {
            const diff = Math.abs(frac - Number(dec))
            if (diff < bestDiff) { best = label; bestDiff = diff }
          }
          if (best && whole > 0) return `${whole} ${best}`
          if (best) return best
          if (whole > 0) return String(whole)
          return String(rounded)
        }

        function applyServings(target) {
          if (!servingsValue || baseServings <= 0) return
          const clamped = Math.min(Math.max(target, 1), 99)
          const factor = clamped / baseServings
          servingsValue.textContent = String(clamped)
          if (servingsMinus) servingsMinus.disabled = clamped <= 1
          if (servingsPlus) servingsPlus.disabled = clamped >= 99
          rows.forEach(row => {
            const qtyEl = row.querySelector('[data-ingredient-qty]')
            const origQty = Number(qtyEl?.dataset.qty) || 0
            if (qtyEl && origQty > 0) {
              const scaled = origQty * factor
              qtyEl.textContent = formatQty(scaled)
            }
          })
        }

        if (servingsPlus) servingsPlus.addEventListener('click', () => {
          applyServings(Number(servingsValue.textContent) + 1)
        })
        if (servingsMinus) servingsMinus.addEventListener('click', () => {
          applyServings(Number(servingsValue.textContent) - 1)
        })

        // 7. Substituições de ingredientes
        // Dicionário: chave (em minúsculas) -> opções de substituição
        const SUBSTITUTIONS = [
          {
            keys: ['açúcar', 'acucar', 'sugar', 'a\u00e7\u00facar'],
            options: [
              { label: 'Mel (3/4 da quantidade)', note: 'Mais doce e úmido; reduza o líquido em 1 colher por xícara.' },
              { label: 'Açúcar de coco (1:1)', note: 'Sabor caramelizado; mesma proporção.' },
              { label: 'Xilitol ou eritritol (1:1)', note: 'Zero calorias; pode cristalizar se aquecer demais.' }
            ]
          },
          {
            keys: ['manteiga', 'butter'],
            options: [
              { label: 'Óleo de coco (1:1)', note: 'Sabor leve de coco; ótimo em massas.' },
              { label: 'Margarina vegetal (1:1)', note: 'Mesma textura em massas e cremes.' },
              { label: 'Azeite de oliva (3/4)', note: 'Use 3/4 da quantidade; sabor mais intenso.' }
            ]
          },
          {
            keys: ['ovos', 'ovo', 'egg'],
            options: [
              { label: 'Linhaça hidratada (1 ovo = 1 colher + 3 de água)', note: 'Deixe descansar 10 min antes de usar.' },
              { label: 'Banana amassada (1/4 xícara por ovo)', note: 'Mais doçura e umidade.' },
              { label: 'Iogurte natural (1/4 xícara por ovo)', note: 'Mantém maciez em bolos.' }
            ]
          },
          {
            keys: ['leite', 'milk'],
            options: [
              { label: 'Leite de aveia (1:1)', note: 'Sabor neutro, textura próxima.' },
              { label: 'Leite de amêndoas (1:1)', note: 'Mais leve; adicione 1 colher de óleo se a massa pedir gordura.' },
              { label: 'Leite de coco (1:1)', note: 'Mais cremoso e com sabor marcante.' }
            ]
          },
          {
            keys: ['farinha de trigo', 'farinha', 'flour'],
            options: [
              { label: 'Farinha integral (1:1)', note: 'Use 25% menos líquido ou deixe a massa descansar 30 min.' },
              { label: 'Farinha de aveia (1:1)', note: 'Sabor suave; textura mais densa.' },
              { label: 'Mix sem glúten (1:1)', note: 'Acrescente 1/2 colher de goma xantana por xícara.' }
            ]
          },
          {
            keys: ['creme de leite', 'cream'],
            options: [
              { label: 'Iogurte natural integral (1:1)', note: 'Mais leve e levemente ácido.' },
              { label: 'Creme de coco (1:1)', note: 'Vegano e cremoso; doçura natural.' },
              { label: 'Leite + amido de milho (1 xícara: 1 colher)', note: 'Misture e aqueça até engrossar.' }
            ]
          },
          {
            keys: ['chocolate', 'chocolate ao leite'],
            options: [
              { label: 'Cacau em pó + manteiga (3 colheres + 1 colher)', note: 'Equivale a 100g de chocolate meio amargo.' },
              { label: 'Chocolate amargo 70% (1:1)', note: 'Menos doce; ajuste o açúcar da receita.' },
              { label: 'Alfarroba (1:1)', note: 'Sem cafeína, sabor mais caramelizado.' }
            ]
          },
          {
            keys: ['fermento em pó', 'baking powder', 'fermento químico'],
            options: [
              { label: 'Bicarbonato + limão (1/4 colher + 1/2 colher)', note: 'Substitui 1 colher de fermento químico.' },
              { label: 'Bicarbonato + vinagre (1/4 colher + 1/2 colher)', note: 'Misture na hora de levar ao forno.' }
            ]
          },
          {
            keys: ['amendoim', 'peanut'],
            options: [
              { label: 'Amêndoas (1:1)', note: 'Sabor mais delicado e menos alergênico.' },
              { label: 'Castanha de caju (1:1)', note: 'Cremosidade parecida em pastas e farofas.' }
            ]
          }
        ]

        function normalizeKey(text) {
          return String(text || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim()
        }

        const substitutedNames = {}

        rows.forEach(row => {
          const btn = row.querySelector('[data-sub-btn]')
          const menu = row.querySelector('[data-sub-menu]')
          const optionsBox = row.querySelector('[data-sub-options]')
          const nameEl = row.querySelector('[data-ingredient-name]')
          const origName = nameEl ? nameEl.textContent.trim() : ''
          if (!btn || !menu || !optionsBox || !nameEl) return

          // Encontra substituições que batem com o nome do ingrediente
          const norm = normalizeKey(origName)
          const match = SUBSTITUTIONS.find(s => s.keys.some(k => norm.includes(normalizeKey(k))))
          if (!match) { btn.style.display = 'none'; return }
          row.classList.add('has-sub')

          function restoreOriginal() {
            nameEl.textContent = origName
            row.classList.remove('substituted')
            const note = row.querySelector('.substitution-note')
            if (note) note.remove()
            delete substitutedNames[row.dataset.ingredientRow]
            // Reconstroi as opções (remove o item de restaurar)
            optionsBox.innerHTML = ''
            buildOptions()
          }

          function buildOptions() {
            optionsBox.innerHTML = ''
            if (substitutedNames[row.dataset.ingredientRow]) {
              const restore = document.createElement('button')
              restore.type = 'button'
              restore.className = 'sub-option restore'
              restore.setAttribute('role', 'menuitem')
              const restoreLabel = document.createElement('span')
              restoreLabel.className = 'sub-option-label'
              restoreLabel.textContent = `↺ Restaurar ${origName}`
              restore.appendChild(restoreLabel)
              restore.addEventListener('click', restoreOriginal)
              optionsBox.appendChild(restore)
            }
            match.options.forEach((opt) => {
              const item = document.createElement('button')
              item.type = 'button'
              item.className = 'sub-option'
              item.setAttribute('role', 'menuitem')
              item.innerHTML = `<span class="sub-option-label">${opt.label}</span><span class="sub-option-note">${opt.note || ''}</span>`
              item.addEventListener('click', () => {
                nameEl.textContent = opt.label.split(' (')[0]
                substitutedNames[row.dataset.ingredientRow] = { name: opt.label, origName }
                row.classList.add('substituted')
                // Substitui a nota anterior, se houver, em vez de empilhar
                const oldNote = row.querySelector('.substitution-note')
                if (oldNote) oldNote.remove()
                const note = document.createElement('em')
                note.className = 'ingredient-optional substitution-note'
                note.textContent = ` (substituído: ${opt.label})`
                row.querySelector('.ingredient-text')?.appendChild(note)
                closeMenus()
              })
              optionsBox.appendChild(item)
            })
          }

          buildOptions()

          btn.addEventListener('click', (e) => {
            e.stopPropagation()
            const isOpen = menu.classList.contains('open')
            closeMenus()
            if (!isOpen) {
              menu.classList.add('open')
              menu.setAttribute('aria-hidden', 'false')
            }
          })
        })

        function closeMenus() {
          document.querySelectorAll('[data-sub-menu]').forEach(m => {
            m.classList.remove('open')
            m.setAttribute('aria-hidden', 'true')
          })
        }

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ingredient-sub-menu') && !e.target.closest('.ingredient-sub-btn')) {
            closeMenus()
          }
        })
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenus()
        })
        document.querySelectorAll('[data-sub-close]').forEach(btn => {
          btn.addEventListener('click', () => closeMenus())
        })

        // 8. Active step detection on scroll + progress line
        const stepItems = document.querySelectorAll('.step-item')
        const stepsList = document.querySelector('.steps-list')

        function updateActiveStep() {
          let activeIndex = -1
          const viewportCenter = window.innerHeight * 0.45

          stepItems.forEach((item, idx) => {
            const rect = item.getBoundingClientRect()
            const itemCenter = rect.top + rect.height / 2

            // Remove previous state classes
            item.classList.remove('active', 'pending')
            item.style.setProperty('--step-index', String(idx))

            if (itemCenter < viewportCenter && rect.bottom > 0) {
              activeIndex = idx
            }
          })

          // Marcar passos anteriores ao ativo como "pending" (visualmente diferentes)
          stepItems.forEach((item, idx) => {
            if (idx < activeIndex && !item.classList.contains('done')) {
              item.classList.add('pending')
            }
          })

          // Destacar o passo ativo
          if (activeIndex >= 0) {
            const activeItem = stepItems[activeIndex]
            if (!activeItem.classList.contains('done')) {
              activeItem.classList.add('active')
            }
          }

          // Atualizar linha de progresso baseada em passos concluídos
          if (stepsList) {
            const doneSteps = document.querySelectorAll('.step-item.done').length
            const totalSteps = stepItems.length
            const progressPct = totalSteps > 0 ? (doneSteps / totalSteps) * 100 : 0
            stepsList.style.setProperty('--steps-progress', `${progressPct}%`)
          }
        }

        // IntersectionObserver para detecção mais precisa
        const stepObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const item = entry.target
            const idx = Number(item.dataset.step)

            if (entry.isIntersecting && entry.intersectionRatio > 0.4) {
              item.classList.add('visible')
            }
          })
        }, { threshold: [0.3, 0.5, 0.7], rootMargin: '-20% 0px -60% 0px' })

        stepItems.forEach(item => stepObserver.observe(item))

        // Atualizar no scroll (throttled)
        let scrollTicking = false
        function onScroll() {
          if (!scrollTicking) {
            requestAnimationFrame(() => {
              updateActiveStep()
              scrollTicking = false
            })
            scrollTicking = true
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true })
        window.addEventListener('resize', onScroll, { passive: true })

        // Inicialização
        updateActiveStep()
        stepItems.forEach((item, idx) => {
          item.style.setProperty('--step-index', String(idx))
        })

        // Re-executar após navegação SPA
        document.addEventListener('astro:after-swap', () => {
          setTimeout(() => {
            const newItems = document.querySelectorAll('.step-item')
            newItems.forEach((item, idx) => {
              item.style.setProperty('--step-index', String(idx))
            })
            updateActiveStep()
          }, 100)
        })
      })();
    </script>
  </Base>
)}

