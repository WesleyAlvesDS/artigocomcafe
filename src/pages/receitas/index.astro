---
import Base from '../../layouts/Base.astro'
import RecipeCard from '../../components/RecipeCard.astro'
import Pagination from '../../components/Pagination.astro'
import { getRecipes, getRecipeCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const url = new URL(Astro.request.url)
const currentPage = Number(url.searchParams.get('page')) || 1
const search = url.searchParams.get('busca') || ''
const categorySlug = url.searchParams.get('categoria') || ''
const tagSlug = url.searchParams.get('tag') || ''

const categories = await getRecipeCategories()

const recipesResponse = await getRecipes(currentPage, 9, categorySlug || undefined, search || undefined, tagSlug || undefined)
const recipes = recipesResponse.data
const pagination = {
  last_page: recipesResponse.last_page,
  current_page: recipesResponse.current_page,
}
---

<Base title="Receitas — Artigo com Café" description="Receitas práticas para acompanhar sua pausa para o conhecimento: café, bebidas, acompanhamentos e sobremesas." canonical="/receitas/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Receitas', slug: '/receitas/' }]}>
  {pagination.last_page > 1 && currentPage < pagination.last_page && (
    <link rel="next" href={`/receitas?page=${currentPage + 1}${categorySlug ? `&categoria=${categorySlug}` : ''}${search ? `&busca=${encodeURIComponent(search)}` : ''}`} />
  )}
  {pagination.last_page > 1 && currentPage > 1 && (
    <link rel="prev" href={`/receitas?page=${currentPage - 1}${categorySlug ? `&categoria=${categorySlug}` : ''}${search ? `&busca=${encodeURIComponent(search)}` : ''}`} />
  )}
  <section class="section receitas-header">
    <div class="container">
      <div class="receitas-header-content" data-reveal>
        <span class="section-label">Receitas</span>
        <h1 class="section-title">Café, Pausa e Prática</h1>
        <p class="section-subtitle">
          Receitas passo a passo para colocar em prática — do café coado perfeito às sobremesas para acompanhar a leitura.
        </p>
      </div>

      <div class="receitas-filters" data-reveal>
        <form class="search-form" method="GET" action="/receitas">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            name="busca"
            value={search}
            placeholder="Buscar receitas…"
            class="search-input"
            aria-label="Buscar receitas"
          />
          {categorySlug && <input type="hidden" name="categoria" value={categorySlug} />}
        </form>

        <div class="categories-filter">
          <a href="/receitas" class={`cat-chip ${!categorySlug && !tagSlug ? 'active' : ''}`}>Todas</a>
          {categories.map(cat => (
            <a
              href={`/receitas?categoria=${cat.slug}${search ? `&busca=${search}` : ''}${tagSlug ? `&tag=${tagSlug}` : ''}`}
              class={`cat-chip ${categorySlug === cat.slug ? 'active' : ''}`}
            >
              {cat.icon && <span aria-hidden="true">{cat.icon}</span>}
              {cat.name}
              <span class="cat-count">{cat.recipes_count}</span>
            </a>
          ))}
        </div>
        {tagSlug && (
          <div class="tag-filter-bar">
            <span>Filtrando por tag:</span>
            <a href="/receitas" class="tag-filter-chip">#{tagSlug}</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {recipes.length > 0 ? (
        <>
          <div class="recipes-grid">
            {recipes.map((recipe, i) => (
              <RecipeCard recipe={recipe} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
          {pagination.last_page > 1 && (
            <Pagination
              currentPage={currentPage}
              totalPages={pagination.last_page}
              basePath="/receitas"
              queryParams={{
                ...(categorySlug ? { categoria: categorySlug } : {}),
                ...(search ? { busca: search } : {}),
              }}
            />
          )}
        </>
      ) : (
        <div class="empty-state" data-reveal>
          <div class="empty-icon">☕</div>
          <h2 class="empty-title">Nenhuma receita encontrada</h2>
          <p class="empty-desc">
            {search ? `Nenhum resultado para "${search}".` : 'Nenhuma receita publicada nesta categoria ainda.'}
          </p>
          <a href="/receitas" class="btn-primary">Ver todas as receitas</a>
        </div>
      )}
    </div>
  </section>

</Base>

<style>
  .receitas-header {
    padding-bottom: 1rem;
  }

  .receitas-header-content {
    margin-bottom: 2rem;
  }

  .receitas-header-content .section-subtitle {
    margin: 0;
  }

  .receitas-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-form {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-form .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.3s;
  }

  .search-form .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-form .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cat-chip:hover,
  .cat-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .tag-filter-bar span {
    color: var(--color-text-muted);
  }

  .tag-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-mono);
    text-decoration: none;
    transition: all 0.25s;
  }

  .tag-filter-chip:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>
