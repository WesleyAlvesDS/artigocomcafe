---
import Base from '../../layouts/Base.astro'
import RecipeBrowser from '../../components/RecipeBrowser'
import RecipeCard from '../../components/RecipeCard.astro'
import Pagination from '../../components/Pagination.astro'
import SidebarWidgets from '../../components/SidebarWidgets.astro'
import ScrollAnimations from '../../components/ScrollAnimations.astro'
import AdSterraBanner from '../../components/AdSterraBanner.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSenseSlot from '../../components/AdSenseSlot.astro'
import { getRecipes, getRecipeCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const url = new URL(Astro.request.url)
const currentPage = Number(url.searchParams.get('page')) || 1
const search = url.searchParams.get('busca') || ''
const categorySlug = url.searchParams.get('categoria') || ''
const tagSlug = url.searchParams.get('tag') || ''
const difficulty = url.searchParams.get('dificuldade') || ''
const timeMax = url.searchParams.get('tempo_max') || ''

const categories = await getRecipeCategories()

const { recipes, pagination } = await getRecipes(currentPage, 12, {
  category: categorySlug || undefined,
  search: search || undefined,
  tag: tagSlug || undefined,
  difficulty: difficulty || undefined,
  timeMax: timeMax || undefined
})
---

<Base title="Receitas — Artigo com Café" description="Receitas deliciosas com café e para acompanhar seu café. Do café da manhã ao jantar, sobremesas e drinks." canonical="/receitas/" fullWidth breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Receitas', slug: '/receitas/' }]}>
  {/* Paginação agora é client-side (island RecipeBrowser) — sem rel next/prev */}
  
  <section class="section recipes-hero">
    <div class="container">
      <div class="hero-content" data-scroll-reveal="slide-up">
        <span class="section-label">Receitas</span>
        <h1 class="section-title">Todas as Receitas</h1>
        <p class="section-subtitle">
          Receitas autorais para acompanhar sua pausa — do café da manhã ao drink noturno.
        </p>
      </div>
      
      {/* O formulário de busca + filtros e a grade ficam no island
          RecipeBrowser (client-side): o site é estático e filtros por
          query string nunca re-renderizam no servidor. */}
    </div>
  </section>

  <section class="section recipes-listing-section">
    <div class="container">
      <div class="recipes-layout">
        <div class="recipes-main">
          {/* Navegador client-side: busca, filtros e paginação funcionam no
              site estático (os cards SSG entram como estado inicial). */}
          <RecipeBrowser client:visible categories={categories} initialRecipes={recipes} />
          {recipes.length > 6 && (
            <>
              {/* In-feed: anúncio nativo após a grade */}
              <AdSterraNative lazy className="recipes-feed-ad" label="Publicidade" />
              {/* Slot reservado para o Google AdSense */}
              <AdSenseSlot />
            </>
          )}
        </div>

        <SidebarWidgets
          cafeDoDia={false}
          receitaDoDia={true}
          newsletter={true}
          clima={true}
          cambio={true}
          nativeAd={false}
        />
      </div>

      {/* Fallback sem JavaScript: lista SSG das receitas da página 1. */}
      <noscript>
        <form class="recipes-filters" method="GET" action="/receitas">
          <div class="search-form">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" name="busca" value={search} placeholder="Buscar receitas…" class="search-input" aria-label="Buscar receitas" />
          </div>
        </form>
        {recipes.length > 0 ? (
          <>
            <div class="recipes-grid">
              {recipes.map((recipe, i) => (
                <RecipeCard recipe={recipe} index={i} />
              ))}
            </div>
            {pagination.totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={pagination.totalPages}
                basePath="/receitas"
              />
            )}
          </>
        ) : (
          <div class="empty-state">
            <h2 class="empty-title">Nenhuma receita encontrada</h2>
            <p class="empty-desc">Ative o JavaScript para usar busca e filtros avançados.</p>
          </div>
        )}
      </noscript>
    </div>
  </section>

  <section class="section recipes-leaderboard" data-scroll-reveal="fade">
    <div class="container" style="max-width: 760px;">
      <AdSterraBanner key="a2885857c5978b578e5340115924dbb1" width={728} height={90} lazy />
    </div>
  </section>

  <ScrollAnimations />
</Base>

<style>
  .recipes-hero {
    padding-bottom: 1rem;
  }
  
  .hero-content {
    margin-bottom: 2rem;
  }
  
  .hero-content .section-subtitle {
    margin: 0;
  }
  
  .recipes-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .filters-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  @media (min-width: 768px) {
    .filters-row {
      flex-direction: row;
      align-items: flex-start;
    }
  }
  
  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }
  
  .active-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 0.75rem;
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
    border-radius: var(--radius-card);
  }
  
  .filter-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 500;
  }
  
  .filter-tag .remove-filter {
    margin-left: 0.35rem;
    color: inherit;
    opacity: 0.7;
    font-size: 1.1rem;
    line-height: 1;
    text-decoration: none;
  }
  
  .filter-tag .remove-filter:hover {
    opacity: 1;
  }
  
  .clear-filters {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .clear-filters:hover {
    opacity: 0.8;
  }
  
  .recipes-listing-section {
    padding-top: 0.5rem;
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  /* In-feed: anúncio ocupa a largura total entre as duas metades da grade */
  .recipes-feed-ad {
    max-width: 720px;
    margin: 2.5rem auto;
  }
  
  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }
  
  .empty-icon {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  
  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }
  
  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  
  /* Recipe Card Enhancements */
  .recipe-card {
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .recipe-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 45%, transparent), transparent 40%, color-mix(in srgb, var(--color-accent-secondary) 40%, transparent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  
  .recipe-card:hover::before {
    opacity: 1;
  }
  
  .recipe-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow), 0 8px 32px rgba(0, 0, 0, 0.35);
  }
  
  .recipe-image-wrapper {
    position: relative;
    overflow: hidden;
  }
  
  .recipe-image {
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.4s ease;
  }
  
  .recipe-card:hover .recipe-image {
    transform: scale(1.08);
    filter: brightness(0.9);
  }
  
  .recipe-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(10,8,5,0.5) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  
  .recipe-card:hover .recipe-overlay {
    opacity: 1;
  }
  
  .recipe-card:hover .recipe-save-btn {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  
  .recipe-save-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-glass-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px) scale(0.9);
    transition: opacity var(--transition), transform var(--transition), background-color var(--transition), color var(--transition), border-color var(--transition);
  }
  
  .recipe-save-btn:hover {
    background: var(--color-accent);
    color: var(--color-btn-text);
    border-color: var(--color-accent);
  }
  
  .recipe-save-btn.saved {
    background: var(--color-accent);
    color: var(--color-btn-text);
    border-color: var(--color-accent);
  }
  
  .recipe-save-btn svg {
    width: 18px;
    height: 18px;
    stroke-width: 2.5;
  }
  
  .recipe-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .recipe-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  
  .recipe-category {
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    font-weight: 500;
    font-family: var(--font-sans);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .recipe-difficulty {
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    font-weight: 600;
    text-transform: capitalize;
    font-family: var(--font-sans);
  }
  
  .recipe-difficulty.facil {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }
  
  .recipe-difficulty.media {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }
  
  .recipe-difficulty.dificil {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }
  
  .recipe-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0.25rem 0;
  }
  
  .recipe-excerpt {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .recipe-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-bg-card-border);
  }
  
  .recipe-stats {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
  
  .recipe-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .recipe-stat svg {
    width: 14px;
    height: 14px;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .recipe-card,
    .recipe-image,
    .recipe-overlay,
    .recipe-save-btn {
      transition: none !important;
    }
    .recipe-card:hover .recipe-image {
      transform: none;
    }
  }
</style>