---
import Base from '../../layouts/Base.astro'
import RecipeCard from '../../components/RecipeCard.astro'
import { getRecipes, getRecipeCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const categories = await getRecipeCategories()
const recipesResponse = await getRecipes(1, 1000)
const recipes = recipesResponse.data
const totalRecipes = recipesResponse.total || recipes.length
---

<Base title="Receitas — Artigo com Café" description={`${totalRecipes} receitas práticas para acompanhar sua pausa para o conhecimento: café, bebidas, acompanhamentos, sobremesas e muito mais.`} canonical="/receitas/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Receitas', slug: '/receitas/' }]}>
  <section class="section receitas-header">
    <div class="container">
      <div class="receitas-header-content" data-reveal>
        <span class="section-label">Receitas</span>
        <h1 class="section-title">Café, Pausa e Prática</h1>
        <p class="section-subtitle">
          {totalRecipes} receitas passo a passo para colocar em prática — do café coado perfeito às sobremesas, pratos principais e bebidas de todo o mundo.
        </p>
      </div>

      <div class="receitas-filters" data-reveal>
        <form class="search-form" role="search" aria-label="Filtrar receitas">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="search"
            name="busca"
            placeholder={`Buscar entre ${totalRecipes} receitas…`}
            class="search-input"
            aria-label="Buscar receitas"
          />
        </form>

        <div class="categories-filter" aria-label="Filtrar por categoria">
          <button type="button" class="cat-chip" data-cat="" aria-pressed="true">Todas</button>
          {categories.map(cat => (
            <button type="button" class="cat-chip" data-cat={cat.slug} aria-pressed="false">
              {cat.icon && <span aria-hidden="true">{cat.icon}</span>}
              {cat.name}
              <span class="cat-count">{cat.recipes_count}</span>
            </button>
          ))}
        </div>
        <div class="tag-filter-bar" hidden>
          <span>Filtrando por tag:</span>
          <button type="button" class="tag-filter-chip" id="clear-tag">limpar filtro</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="recipes-grid" id="recipes-grid">
        {recipes.map((recipe, i) => (
          <div
            class="recipe-card-wrap"
            data-cat={recipe.category?.slug || ''}
            data-tags={(recipe.tags || []).map(t => t.slug).join(' ')}
            data-search={(recipe.title + ' ' + (recipe.excerpt || '') + ' ' + (recipe.category?.name || '') + ' ' + (recipe.tags || []).map(t => t.name).join(' ')).toLowerCase()}
          >
            <RecipeCard recipe={recipe} revealDelay={`delay-${(i % 4) + 1}`} />
          </div>
        ))}
      </div>
      <div class="empty-state" id="empty-state" hidden>
        <div class="empty-icon">☕</div>
        <h2 class="empty-title">Nenhuma receita encontrada</h2>
        <p class="empty-desc">Tente ajustar a busca ou escolher outra categoria.</p>
        <button type="button" class="btn-primary" id="clear-filters">Ver todas as receitas</button>
      </div>
    </div>
  </section>

  <script>
    const grid = document.getElementById('recipes-grid')
    const cards = Array.from(grid ? grid.querySelectorAll('.recipe-card-wrap') : [])
    const chips = Array.from(document.querySelectorAll('.cat-chip[data-cat]'))
    const searchInput = document.querySelector('.search-input')
    const emptyState = document.getElementById('empty-state')
    const clearTagBtn = document.getElementById('clear-tag')
    const tagBar = document.querySelector('.tag-filter-bar')
    const clearFiltersBtn = document.getElementById('clear-filters')

    const params = new URL(window.location.href).searchParams
    let activeCat = params.get('categoria') || ''
    let activeTag = params.get('tag') || ''
    let query = params.get('busca') || ''

    const normalize = s => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')

    function apply() {
      const q = normalize(query)
      let visible = 0
      cards.forEach(card => {
        const okCat = !activeCat || card.dataset.cat === activeCat
        const okTag = !activeTag || (card.dataset.tags || '').split(' ').includes(activeTag)
        const okSearch = !q || normalize(card.dataset.search).includes(q)
        const show = okCat && okTag && okSearch
        card.classList.toggle('hidden', !show)
        if (show) visible++
      })
      chips.forEach(chip => {
        const active = chip.dataset.cat === activeCat
        chip.classList.toggle('active', active)
        chip.setAttribute('aria-pressed', String(active))
      })
      if (searchInput) searchInput.value = query
      if (tagBar) tagBar.hidden = !activeTag
      if (emptyState) emptyState.hidden = visible > 0
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeCat = chip.dataset.cat
        apply()
      })
    })

    searchInput?.addEventListener('input', e => {
      query = e.target.value
      apply()
    })

    searchInput?.addEventListener('keydown', e => {
      if (e.key === 'Enter') e.preventDefault()
    })

    clearTagBtn?.addEventListener('click', () => {
      activeTag = ''
      apply()
    })

    clearFiltersBtn?.addEventListener('click', () => {
      activeCat = ''
      activeTag = ''
      query = ''
      apply()
    })

    apply()
  </script>
</Base>

<style>
  .receitas-header {
    padding-bottom: 1rem;
  }

  .receitas-header-content {
    margin-bottom: 2rem;
  }

  .receitas-header-content .section-subtitle {
    margin: 0;
  }

  .receitas-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-form {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-form .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.3s;
  }

  .search-form .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-form .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s;
  }

  .cat-chip:hover,
  .cat-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .tag-filter-bar span {
    color: var(--color-text-muted);
  }

  .tag-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.25s;
  }

  .tag-filter-chip:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .recipe-card-wrap {
    min-width: 0;
  }

  .recipe-card-wrap.hidden {
    display: none;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>
