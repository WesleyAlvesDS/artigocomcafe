---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import AchievementsPage from '../components/AchievementsPage.tsx'
---

<Base title="Conquistas — Artigo com Café" description="Suas conquistas no Artigo com Café" canonical="/conquistas/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }, { name: 'Conquistas', slug: '/conquistas/' }]}>
  <section class="min-h-screen py-20 px-4" aria-label="Conquistas">
    <div class="max-w-5xl mx-auto">
      <LoggedAreaNav current="conquistas" crumb="Conquistas" />
      <AchievementsPage client:visible />
    </div>
  </section>
</Base>
