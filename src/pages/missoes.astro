---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import MissionsPage from '../components/MissionsPage'
---

<Base
  title="Missões — Artigo com Café"
  description="Complete missões diárias e semanais para ganhar recompensas exclusivas."
  canonical="/missoes/"
  breadcrumbs={[
    { name: 'Início', slug: '/' },
    { name: 'Área do leitor', slug: '/dashboard/' },
    { name: 'Missões', slug: '/missoes/' }
  ]}
>
  <section class="min-h-screen py-20 px-4" aria-label="Missões">
    <div class="max-w-5xl mx-auto">
      <LoggedAreaNav current="missoes" crumb="Missões" />
      <MissionsPage client:visible />
    </div>
  </section>

</Base>
