---
import Base from '../../layouts/Base.astro'
import PostBrowser from '../../components/PostBrowser'
import ArticleCard from '../../components/ArticleCard.astro'
import Pagination from '../../components/Pagination.astro'
import SidebarWidgets from '../../components/SidebarWidgets.astro'
import ScrollAnimations from '../../components/ScrollAnimations.astro'
import AdSterraBanner from '../../components/AdSterraBanner.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSenseSlot from '../../components/AdSenseSlot.astro'
import { getPosts, getCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const url = new URL(Astro.request.url)
const currentPage = Number(url.searchParams.get('page')) || 1
const search = url.searchParams.get('busca') || ''
const categorySlug = url.searchParams.get('categoria') || ''
const tagSlug = url.searchParams.get('tag') || ''

const categories = await getCategories()

const { posts, pagination } = await getPosts(currentPage, 9, categorySlug || undefined, search || undefined, tagSlug || undefined)
---

<Base title="Blog — Artigo com Café" description="Artigos aprofundados sobre o universo do café: cultura, história, métodos e curiosidades." canonical="/blog/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Blog', slug: '/blog/' }]}>
  {/* Paginação agora é client-side (island PostBrowser) — sem rel next/prev */}
  <section class="section blog-header">
    <div class="container">
      <div class="blog-header-content" data-scroll-reveal="fade">
        <span class="section-label">Blog</span>
        <h1 class="section-title">Todos os Artigos</h1>
        <p class="section-subtitle">
          Conteúdo autoral sobre cultura, história e métodos do café — para ler com calma e aprender.
        </p>
      </div>

      {/* Busca + filtros + grade ficam no island PostBrowser (client-side).
          O site é estático: query strings nunca re-renderizam no servidor. */}
    </div>
  </section>

  <section class="section blog-listing-section">
    <div class="container">
      <div class="blog-layout">
        <div class="blog-main">
          {/* Navegador client-side: busca, categoria e tag funcionam no site
              estático (cards SSG como estado inicial). */}
          <PostBrowser client:visible categories={categories} initialPosts={posts} initialPagination={pagination} />
          {posts.length > 4 && (
            <>
              {/* In-feed: anúncio nativo após a grade */}
              <AdSterraNative lazy className="blog-feed-ad" label="Publicidade" />
              {/* Slot reservado para o Google AdSense */}
              <AdSenseSlot />
            </>
          )}
        </div>

        <SidebarWidgets
          cafeDoDia={true}
          receitaDoDia={true}
          newsletter={true}
          clima={false}
          cambio={false}
          nativeAd={false}
        />
      </div>

      {/* Fallback sem JavaScript: lista SSG da página 1. */}
      <noscript>
        <form class="blog-filters" method="GET" action="/blog">
          <div class="search-form">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" name="busca" value={search} placeholder="Buscar artigos…" class="search-input" aria-label="Buscar artigos" />
          </div>
        </form>
        {posts.length > 0 ? (
          <>
            <div class="articles-grid">
              {posts.map((post, i) => (
                <ArticleCard post={post} index={i} />
              ))}
            </div>
            {pagination.totalPages > 1 && (
              <Pagination currentPage={currentPage} totalPages={pagination.totalPages} basePath="/blog" />
            )}
          </>
        ) : (
          <div class="empty-state">
            <h2 class="empty-title">Nenhum artigo encontrado</h2>
            <p class="empty-desc">Ative o JavaScript para usar busca e filtros avançados.</p>
          </div>
        )}
      </noscript>
    </div>
  </section>

  <section class="section blog-leaderboard" data-scroll-reveal="fade">
    <div class="container" style="max-width: 760px;">
      <AdSterraBanner key="a2885857c5978b578e5340115924dbb1" width={728} height={90} lazy />
    </div>
  </section>

  <ScrollAnimations />
</Base>

<style>
  .blog-header {
    padding-bottom: 1rem;
  }

  .blog-header-content {
    margin-bottom: 2rem;
  }

  .blog-header-content .section-subtitle {
    margin: 0;
  }

  .blog-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-form {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-form .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.3s;
  }

  .search-form .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-form .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cat-chip:hover,
  .cat-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .tag-filter-bar span {
    color: var(--color-text-muted);
  }

  .tag-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-mono);
    text-decoration: none;
    transition: all 0.25s;
  }

  .tag-filter-chip:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .blog-listing-section {
    padding-top: 0.5rem;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 2.5rem;
    align-items: start;
  }

  .blog-main {
    min-width: 0;
  }

  @media (max-width: 1100px) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .sidebar-widgets {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }

  /* Grade editorial em 3 colunas (queixa: blocos muito grandes).
     Em telas médias e NO CELULAR vira 2 colunas (pedido: 2 blocos no mobile). */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (max-width: 1100px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem;
    }
  }

  /* In-feed: anúncio ocupa a largura total entre as duas metades da grade */
  .blog-feed-ad {
    max-width: 720px;
    margin: 2.5rem auto;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>