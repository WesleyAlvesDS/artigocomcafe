---
import Base from '../../layouts/Base.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import Pagination from '../../components/Pagination.astro'
import ExchangeRateWidget from '../../components/ExchangeRateWidget'
import ScrollAnimations from '../../components/ScrollAnimations.astro'
import { getPosts, getCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const url = new URL(Astro.request.url)
const currentPage = Number(url.searchParams.get('page')) || 1
const search = url.searchParams.get('busca') || ''
const categorySlug = url.searchParams.get('categoria') || ''
const tagSlug = url.searchParams.get('tag') || ''

const categories = await getCategories()

const { posts, pagination } = await getPosts(currentPage, 9, categorySlug || undefined, search || undefined, tagSlug || undefined)
---

<Base title="Blog — Artigo com Café" description="Artigos aprofundados sobre o universo do café: cultura, história, métodos e curiosidades." canonical="/blog/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Blog', slug: '/blog/' }]}>
  {pagination.totalPages > 1 && currentPage < pagination.totalPages && (
    <link rel="next" href={`/blog?page=${currentPage + 1}${categorySlug ? `&categoria=${categorySlug}` : ''}${search ? `&busca=${encodeURIComponent(search)}` : ''}${tagSlug ? `&tag=${tagSlug}` : ''}`} />
  )}
  {pagination.totalPages > 1 && currentPage > 1 && (
    <link rel="prev" href={`/blog?page=${currentPage - 1}${categorySlug ? `&categoria=${categorySlug}` : ''}${search ? `&busca=${encodeURIComponent(search)}` : ''}${tagSlug ? `&tag=${tagSlug}` : ''}`} />
  )}
  <section class="section blog-header">
    <div class="container">
      <div class="blog-header-content" data-scroll-reveal="fade">
        <span class="section-label">Blog</span>
        <h1 class="section-title">Todos os Artigos</h1>
        <p class="section-subtitle">
          Conteúdo autoral sobre cultura, história e métodos do café — para ler com calma e aprender.
        </p>
      </div>

      <div class="blog-filters" data-scroll-reveal="fade" data-scroll-delay="100">
        <form class="search-form" method="GET" action="/blog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            name="busca"
            value={search}
            placeholder="Buscar artigos…"
            class="search-input"
            aria-label="Buscar artigos"
          />
          {categorySlug && <input type="hidden" name="categoria" value={categorySlug} />}
          {tagSlug && <input type="hidden" name="tag" value={tagSlug} />}
        </form>

        <div class="categories-filter" data-stagger data-stagger-delay="60" data-stagger-start="0">
          <a href="/blog" class={`cat-chip ${!categorySlug && !tagSlug ? 'active' : ''}`} data-stagger-item>Todos</a>
          {categories.slice(0, 12).map(cat => (
            <a
              href={`/blog?categoria=${cat.slug}${search ? `&busca=${search}` : ''}${tagSlug ? `&tag=${tagSlug}` : ''}`}
              class={`cat-chip ${categorySlug === cat.slug ? 'active' : ''}`}
              data-stagger-item
            >
              {cat.name}
              <span class="cat-count">{cat.articles_count}</span>
            </a>
          ))}
        </div>
        {tagSlug && (
          <div class="tag-filter-bar" data-scroll-reveal="fade" data-scroll-delay="200">
            <span>Filtrando por tag:</span>
            <a href="/blog" class="tag-filter-chip">#{tagSlug}</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section" data-scroll-reveal="fade" style="padding-top: 0.5rem; padding-bottom: 0;">
    <div class="container">
      <ExchangeRateWidget client:visible compact={true} maxRates={5} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <>
          <div class="articles-grid" data-stagger data-stagger-delay="80" data-stagger-start="100">
            {posts.map((post, i) => (
              <ArticleCard post={post} index={i} />
            ))}
          </div>
          {pagination.totalPages > 1 && (
            <Pagination
              currentPage={currentPage}
              totalPages={pagination.totalPages}
              basePath="/blog"
              queryParams={{
                ...(categorySlug ? { categoria: categorySlug } : {}),
                ...(search ? { busca: search } : {}),
              }}
            />
          )}
        </>
      ) : (
        <div class="empty-state" data-scroll-reveal="scale">
          <div class="empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h2 class="empty-title">Nenhum artigo encontrado</h2>
          <p class="empty-desc">
            {search ? `Nenhum resultado para "${search}".` : 'Nenhum artigo publicado nesta categoria ainda.'}
          </p>
          <a href="/blog" class="btn-primary">Ver todos os artigos</a>
        </div>
      )}
    </div>
  </section>

  <ScrollAnimations />
</Base>

<style>
  .blog-header {
    padding-bottom: 1rem;
  }

  .blog-header-content {
    margin-bottom: 2rem;
  }

  .blog-header-content .section-subtitle {
    margin: 0;
  }

  .blog-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-form {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-form .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.3s;
  }

  .search-form .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-form .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cat-chip:hover,
  .cat-chip.active {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .tag-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .tag-filter-bar span {
    color: var(--color-text-muted);
  }

  .tag-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-mono);
    text-decoration: none;
    transition: all 0.25s;
  }

  .tag-filter-chip:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>