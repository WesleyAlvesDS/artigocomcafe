---
import Base from '../../layouts/Base.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import Pagination from '../../components/Pagination.astro'
import SearchModal from '../../components/SearchModal'
import { getPosts, getCategories } from '../../lib/laravel'

export async function getStaticPaths() {
  return [{ params: { page: undefined } }]
}

const url = new URL(Astro.request.url)
const currentPage = Number(url.searchParams.get('page')) || 1
const search = url.searchParams.get('busca') || ''
const categorySlug = url.searchParams.get('categoria') || ''

const categories = await getCategories()

let categoryId = ''
if (categorySlug) {
  const found = categories.find(c => c.slug === categorySlug)
  if (found) categoryId = String(found.id)
}

const { posts, pagination } = await getPosts(currentPage, 9, categoryId || undefined, search || undefined)
---

<Base title="Blog — Artigo com Café" description="Artigos sobre cafeteria digital, tecnologia, experiência do usuário e monetização." canonical="/blog/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Blog', slug: '/blog/' }]}>
  {pagination.totalPages > 1 && currentPage < pagination.totalPages && (
    <link rel="next" href={`/blog?page=${currentPage + 1}${categorySlug ? `&categoria=${categorySlug}` : ''}`} />
  )}
  {pagination.totalPages > 1 && currentPage > 1 && (
    <link rel="prev" href={`/blog?page=${currentPage - 1}${categorySlug ? `&categoria=${categorySlug}` : ''}`} />
  )}
  <section class="section blog-header">
    <div class="container">
      <div class="blog-header-content" data-reveal>
        <span class="section-label">Blog</span>
        <h1 class="section-title">Todos os Artigos</h1>
        <p class="section-subtitle">
          Conteúdo autoral sobre cafeteria digital, tecnologia e tendências do mercado.
        </p>
      </div>

      <div class="blog-filters" data-reveal>
        <form class="search-form" method="GET" action="/blog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <input
            type="text"
            name="busca"
            value={search}
            placeholder="Buscar artigos…"
            class="search-input"
            aria-label="Buscar artigos"
          />
          {categorySlug && <input type="hidden" name="categoria" value={categorySlug} />}
        </form>

        <div class="categories-filter">
          <a href="/blog" class={`cat-chip ${!categorySlug ? 'active' : ''}`}>Todos</a>
          {categories.slice(0, 12).map(cat => (
            <a
              href={`/blog?categoria=${cat.slug}${search ? `&busca=${search}` : ''}`}
              class={`cat-chip ${categorySlug === cat.slug ? 'active' : ''}`}
            >
              {cat.name}
              <span class="cat-count">{cat.articles_count}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <>
          <div class="articles-grid">
            {posts.map(post => (
              <ArticleCard post={post} />
            ))}
          </div>
          {pagination.totalPages > 1 && (
            <Pagination
              currentPage={currentPage}
              totalPages={pagination.totalPages}
              basePath="/blog"
            />
          )}
        </>
      ) : (
        <div class="empty-state" data-reveal>
          <div class="empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
          </div>
          <h2 class="empty-title">Nenhum artigo encontrado</h2>
          <p class="empty-desc">
            {search ? `Nenhum resultado para "${search}".` : 'Nenhum artigo publicado nesta categoria ainda.'}
          </p>
          <a href="/blog" class="btn-primary">Ver todos os artigos</a>
        </div>
      )}
    </div>
  </section>

  <SearchModal client:load />
</Base>

<style>
  .blog-header {
    padding-bottom: 1rem;
  }

  .blog-header-content {
    margin-bottom: 2rem;
  }

  .blog-header-content .section-subtitle {
    margin: 0;
  }

  .blog-filters {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .search-form {
    position: relative;
    max-width: 400px;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-form .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 12px;
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9rem;
    font-family: var(--font-sans);
    outline: none;
    transition: border-color 0.3s;
  }

  .search-form .search-input:focus {
    border-color: var(--color-accent);
  }

  .search-form .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .categories-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
  }

  .cat-chip:hover,
  .cat-chip.active {
    background: rgba(212, 163, 115, 0.12);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .cat-count {
    font-size: 0.7rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
</style>
