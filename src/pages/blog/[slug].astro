---
import Base from '../../layouts/Base.astro'
import ReadingTracker from '../../components/ReadingTracker'
import ReaderAssistant from '../../components/ReaderAssistant'
import ArticleCard from '../../components/ArticleCard.astro'
import ArticleActions from '../../components/ArticleActions'
import ArticleToc from '../../components/ArticleToc'
import ScrollAnimations from '../../components/ScrollAnimations.astro'
import SmartSidebar from '../../components/SmartSidebar.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import AdSterraSmartLink from '../../components/AdSterraSmartLink.astro'
import AdSterraBanner from '../../components/AdSterraBanner.astro'
import AdSenseSlot from '../../components/AdSenseSlot.astro'
import { formatDate } from '../../lib/utils'
import { getPost, getAllSlugs } from '../../lib/laravel'
import type { BlogPost } from '../../lib/types'

interface NavPost {
  slug: string
  title: string
}

export async function getStaticPaths() {
  const slugs = await getAllSlugs()
  const withProps = slugs.map((slug, i) => ({
    params: { slug },
    props: {
      prevSlug: i > 0 ? slugs[i - 1] : null,
      nextSlug: i < slugs.length - 1 ? slugs[i + 1] : null,
    },
  }))
  return withProps
}

const { slug } = Astro.params
const { prevSlug, nextSlug } = Astro.props as { prevSlug: string | null; nextSlug: string | null }
let post: BlogPost | null = null
let related: BlogPost[] = []
let prev: NavPost | null = null
let next: NavPost | null = null
let error = false

try {
  const result = await getPost(slug!)
  if (result) {
    post = result.post
    related = result.related
  } else {
    error = true
  }
} catch {
  error = true
}

// For prev/next titles, fetch the two neighbor posts (only when present)
if (post && (prevSlug || nextSlug)) {
  try {
    const promises: Promise<{ post: BlogPost } | null>[] = []
    if (prevSlug) promises.push(getPost(prevSlug))
    if (nextSlug) promises.push(getPost(nextSlug))
    const results = await Promise.all(promises)
    if (prevSlug) prev = results[0] ? { slug: prevSlug, title: results[0].post.title } : { slug: prevSlug, title: prevSlug.replace(/-/g, ' ') }
    if (nextSlug) next = results[1] ? { slug: nextSlug, title: results[1].post.title } : { slug: nextSlug, title: nextSlug.replace(/-/g, ' ') }
  } catch {
    prev = prevSlug ? { slug: prevSlug, title: prevSlug } : null
    next = nextSlug ? { slug: nextSlug, title: nextSlug } : null
  }
}

// Build TOC from content headings
const tocHeadings: { id: string; text: string; level: number }[] = []
if (post) {
  const hRegex = /<(h2|h3)([^>]*)>([\s\S]*?)<\/\1>/gi
  let m
  while ((m = hRegex.exec(post.content)) !== null) {
    const text = m[3].replace(/<[^>]+>/g, '').trim()
    if (text) {
      const id = text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
      tocHeadings.push({ id: id || 'section-' + tocHeadings.length, text, level: m[1] === 'h2' ? 2 : 3 })
    }
  }
}
---

{error ? (
  <Base title="Artigo não encontrado — Artigo com Café">
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Artigo não encontrado</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          O artigo que você procura não está disponível ou foi removido.
        </p>
        <a href="/blog" class="btn-primary">Voltar para o Blog</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${post!.title} — Artigo com Café`}
    description={(post!.excerpt || post!.content.substring(0, 160)).replace(/<[^>]+>/g, '').substring(0, 160)}
    image={`/og/${post!.slug}.png.ts`}
    type="article"
    canonical={`/blog/${post!.slug}/`}
    breadcrumbs={[
      { name: 'Início', slug: '/' },
      { name: 'Blog', slug: '/blog/' },
      { name: post!.title, slug: `/blog/${post!.slug}/` }
    ]}
    transitionName="article-page"
  >
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post!.title,
      "description": (post!.excerpt || post!.content.substring(0, 160)).replace(/<[^>]+>/g, ''),
      "image": post!.featuredImage,
      "datePublished": post!.date,
      "author": {
        "@type": "Organization",
        "name": "Artigo com Café"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Artigo com Café"
      }
    })} />

    <article class="article-page" transition:name="article-content" transition:animate="fade">
      <div class="article-header-section" transition:name="article-header-bg" transition:animate="none">
        <div class="article-header-bg">
          <div class="article-header-sphere a-hs-1"></div>
          <div class="article-header-sphere a-hs-2"></div>
        </div>
        <div class="container">
          <div class="article-header" data-scroll-reveal="slide-up" transition:name="article-header-text">
            <div class="article-meta">
              {post!.categories.length > 0 && (
                <a href={`/blog?categoria=${post!.categories[0].slug}`} class="article-category" transition:name={`article-category-${post!.slug}`} transition:animate="slide">
                  {post!.categories[0].name}
                </a>
              )}
              <span class="article-date">{formatDate(post!.date)}</span>
              <span class="article-reading">☕ {post!.readingTime} min de leitura</span>
            </div>
            <h1 class="article-title" transition:name={`article-title-${post!.slug}`} transition:animate="fade">{post!.title}</h1>
            <p class="article-excerpt-header">{post!.excerpt}</p>
            {post!.tags.length > 0 && (
              <div class="article-tags" transition:name={`article-tags-${post!.slug}`} transition:animate="slide">
                {post!.tags.map(tag => (
                  <a href={`/blog?tag=${tag.slug}`} class="tag">#{tag.name}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {post!.featuredImage && (
        <div class="article-cover" data-scroll-reveal="fade" transition:name={`article-cover-${post!.slug}`} transition:animate="morph">
          <div class="container">
            <div class="cover-frame">
              <img
                src={post!.featuredImage}
                alt={post!.featuredImageAlt}
                class="cover-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <div class="cover-shine"></div>
              <div class="cover-gradient"></div>
            </div>
          </div>
        </div>
      )}

      <div class="article-content-section" transition:name="article-body" transition:animate="fade">
        <div class="container">
          <div class="article-layout">
            <div class="article-main">
              <div class="article-content prose" set:html={post!.content.replace(/<h1([^>]*)>/gi, '<h2$1>').replace(/<\/h1>/gi, '</h2>')} />

              <AdSterraNative className="ad-article-inline" lazy />

              {/* Slot reservado para o Google AdSense inline (desabilitado até criar a unidade) */}
              <AdSenseSlot />

              {/* Author box */}
              <div class="article-author" data-scroll-reveal="fade">
                <div class="author-avatar">&#9749;</div>
                <div class="author-info">
                  <span class="author-label">Escrito por</span>
                  <strong class="author-name">Artigo com Café</strong>
                  <p class="author-bio">
                    Conteúdo autoral sobre o universo do café — sempre acompanhado de uma boa xícara.
                  </p>
                </div>
                <a href="/sobre" class="author-link">Conheça o projeto →</a>
              </div>

              <AdSterraSmartLink
                variant="card"
                text="Já leu o artigo por inteiro? Confira seleções e experiências recomendadas para acompanhar sua próxima xícara."
                className="ad-article-smartlink"
              />

              <AdSterraBanner key="36c0e766cf3f9f800adf45b24d6e2815" width={320} height={50} className="ad-article-mobile" lazy />

              {/* Prev / Next navigation */}
              <nav class="article-nav" aria-label="Navegação entre artigos">
                {prev ? (
                  <a href={`/blog/${prev.slug}/`} class="article-nav-card prev" data-scroll-reveal="slide-left">
                    <span class="article-nav-label">← Anterior</span>
                    <span class="article-nav-title">{prev.title}</span>
                  </a>
                ) : <div />}
                {next ? (
                  <a href={`/blog/${next.slug}/`} class="article-nav-card next" data-scroll-reveal="slide-right">
                    <span class="article-nav-label">Próximo →</span>
                    <span class="article-nav-title">{next.title}</span>
                  </a>
                ) : <div />}
              </nav>
            </div>

            <aside class="article-sidebar smart-sidebar">
              <SmartSidebar
                articleTitle={post!.title}
                articleUrl={`https://artigocomcafe.com/blog/${post!.slug}`}
                tocHeadings={tocHeadings}
                categories={post!.categories}
                tags={post!.tags}
                readingTime={post!.readingTime}
              />
              <AdSterraBanner key="b479d95fee71af96353fa4bbcc5b72b5" width={160} height={300} className="ad-article-skyscraper" lazy />
            </aside>
          </div>
        </div>
      </div>
    </article>

{/* Related Articles - Lazy Loaded */}
    <section class="section related-articles-section" id="related-articles-section">
      <div class="container">
        <div class="section-header" data-scroll-reveal="slide-up">
          <span class="section-label">Continue Lendo</span>
          <h2 class="section-title">Artigos Relacionados</h2>
        </div>
        <div class="articles-grid" data-stagger data-stagger-delay="80" data-stagger-start="100" id="related-articles-grid">
          <div class="related-skeleton" aria-hidden="true">
            <div class="related-skeleton-item"></div>
            <div class="related-skeleton-item"></div>
            <div class="related-skeleton-item"></div>
            <div class="related-skeleton-item"></div>
          </div>
        </div>
      </div>
    </section>

    <ScrollAnimations />

    <script is:inline define:vars={{ relatedData: related.slice(0, 4).map(r => ({
      slug: r.slug,
      title: r.title,
      excerpt: r.excerpt,
      featuredImage: r.featuredImage,
      featuredImageAlt: r.featuredImageAlt,
      date: r.date,
      readingTime: r.readingTime,
      categories: r.categories
    })) }}>
      // Sistema inteligente de artigos relacionados:
      // só carrega quando o leitor realmente rolar até o fim do artigo.
      (function() {
        const grid = document.getElementById('related-articles-grid');
        const section = document.getElementById('related-articles-section');
        if (!grid || !section) return;

        function renderRelated() {
          if (grid.dataset.loaded === 'true') return;
          grid.dataset.loaded = 'true';

          const skeleton = grid.querySelector('.related-skeleton');
          if (skeleton) skeleton.remove();

          if (!relatedData.length) {
            section.classList.add('loaded');
            section.style.display = 'none';
            return;
          }

          relatedData.forEach((post, i) => {
            const card = document.createElement('a');
            card.href = `/blog/${post.slug}/`;
            card.className = 'article-card glass-card lazy-related-loaded';
            card.style.setProperty('--stagger-delay', `${i * 80}ms`);
            card.innerHTML = `
              ${post.featuredImage ? `
                <div class="article-image-wrapper">
                  <img src="${post.featuredImage}" alt="${post.featuredImageAlt}" class="article-image" loading="lazy" decoding="async" />
                  <div class="image-overlay"></div>
                </div>
              ` : ''}
              <div class="article-body">
                <div class="article-meta">
                  ${post.categories.length > 0 ? `<span class="article-category">${post.categories[0].name}</span>` : ''}
                  <span class="article-date">${new Date(post.date).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' })}</span>
                  <span class="article-reading">${post.readingTime} min de leitura</span>
                </div>
                <h2 class="article-title">${post.title}</h2>
                <p class="article-excerpt">${post.excerpt}</p>
                <span class="article-read-more">
                  Ler artigo
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </div>
              <div class="card-glow"></div>
            `;
            grid.appendChild(card);
          });

          requestAnimationFrame(() => {
            section.classList.add('loaded');
          });
        }

        // Gatilho 1: o leitor rolou até o fim do artigo (seção entra na viewport)
        const sectionObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              renderRelated();
              sectionObserver.disconnect();
            }
          });
        }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
        sectionObserver.observe(section);

        // Gatilho 2: progresso de leitura >= 65% (sistema antecipado e inteligente)
        function checkProgress() {
          const article = document.querySelector('.article-content');
          if (!article) return;
          const rect = article.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
          if (progress >= 0.65) {
            renderRelated();
            document.removeEventListener('scroll', checkProgress);
            window.removeEventListener('resize', checkProgress);
          }
        }
        document.addEventListener('scroll', checkProgress, { passive: true });
        window.addEventListener('resize', checkProgress, { passive: true });

        // Gatilho 3: fallback manual disparado pela sidebar
        document.addEventListener('load-related', () => {
          if (grid.dataset.loaded !== 'true') renderRelated();
        });

        // Fallback final: mesmo sem scroll, após 45s o conteúdo aparece
        setTimeout(() => {
          if (grid.dataset.loaded !== 'true') renderRelated();
        }, 45000);
      })();
    </script>

    <ReadingTracker articleId={post!.id} articleTitle={post!.title} client:load />
    <ReaderAssistant client:visible />
  </Base>
)}

