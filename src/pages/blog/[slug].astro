---
import Base from '../../layouts/Base.astro'
import ReadingTracker from '../../components/ReadingTracker'
import ReaderAssistant from '../../components/ReaderAssistant'
import ArticleCard from '../../components/ArticleCard.astro'
import ArticleActions from '../../components/ArticleActions'
import ArticleToc from '../../components/ArticleToc'
import { ToastProvider } from '../../components/Toast'
import { formatDate } from '../../lib/utils'
import { getPost, getAllSlugs } from '../../lib/laravel'
import type { BlogPost } from '../../lib/types'

interface NavPost {
  slug: string
  title: string
}

export async function getStaticPaths() {
  const slugs = await getAllSlugs()
  const withProps = slugs.map((slug, i) => ({
    params: { slug },
    props: {
      prevSlug: i > 0 ? slugs[i - 1] : null,
      nextSlug: i < slugs.length - 1 ? slugs[i + 1] : null,
    },
  }))
  return withProps
}

const { slug } = Astro.params
const { prevSlug, nextSlug } = Astro.props as { prevSlug: string | null; nextSlug: string | null }
let post: BlogPost | null = null
let related: BlogPost[] = []
let prev: NavPost | null = null
let next: NavPost | null = null
let error = false

try {
  const result = await getPost(slug!)
  if (result) {
    post = result.post
    related = result.related
  } else {
    error = true
  }
} catch {
  error = true
}

// For prev/next titles, fetch the two neighbor posts (only when present)
if (post && (prevSlug || nextSlug)) {
  try {
    const promises: Promise<{ post: BlogPost } | null>[] = []
    if (prevSlug) promises.push(getPost(prevSlug))
    if (nextSlug) promises.push(getPost(nextSlug))
    const results = await Promise.all(promises)
    if (prevSlug) prev = results[0] ? { slug: prevSlug, title: results[0].post.title } : { slug: prevSlug, title: prevSlug.replace(/-/g, ' ') }
    if (nextSlug) next = results[1] ? { slug: nextSlug, title: results[1].post.title } : { slug: nextSlug, title: nextSlug.replace(/-/g, ' ') }
  } catch {
    prev = prevSlug ? { slug: prevSlug, title: prevSlug } : null
    next = nextSlug ? { slug: nextSlug, title: nextSlug } : null
  }
}

// Build TOC from content headings
const tocHeadings: { id: string; text: string; level: number }[] = []
if (post) {
  const hRegex = /<(h2|h3)([^>]*)>([\s\S]*?)<\/\1>/gi
  let m
  while ((m = hRegex.exec(post.content)) !== null) {
    const text = m[3].replace(/<[^>]+>/g, '').trim()
    if (text) {
      const id = text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
      tocHeadings.push({ id: id || 'section-' + tocHeadings.length, text, level: m[1] === 'h2' ? 2 : 3 })
    }
  }
}
---

{error ? (
  <Base title="Artigo não encontrado — Artigo com Café">
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Artigo não encontrado</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          O artigo que você procura não está disponível ou foi removido.
        </p>
        <a href="/blog" class="btn-primary">Voltar para o Blog</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${post!.title} — Artigo com Café`}
    description={(post!.excerpt || post!.content.substring(0, 160)).replace(/<[^>]+>/g, '').substring(0, 160)}
    image={`/og/${post!.slug}.png.ts`}
    type="article"
    canonical={`/blog/${post!.slug}/`}
    breadcrumbs={[
      { name: 'Início', slug: '/' },
      { name: 'Blog', slug: '/blog/' },
      { name: post!.title, slug: `/blog/${post!.slug}/` }
    ]}
  >
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": post!.title,
      "description": (post!.excerpt || post!.content.substring(0, 160)).replace(/<[^>]+>/g, ''),
      "image": post!.featuredImage,
      "datePublished": post!.date,
      "author": {
        "@type": "Organization",
        "name": "Artigo com Café"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Artigo com Café"
      }
    })} />

    <article class="article-page">
      <div class="article-header-section">
        <div class="article-header-bg">
          <div class="article-header-sphere a-hs-1"></div>
          <div class="article-header-sphere a-hs-2"></div>
        </div>
        <div class="container">
          <div class="article-header" data-reveal>
            <div class="article-meta">
              {post!.categories.length > 0 && (
                <a href={`/blog?categoria=${post!.categories[0].slug}`} class="article-category">
                  {post!.categories[0].name}
                </a>
              )}
              <span class="article-date">{formatDate(post!.date)}</span>
              <span class="article-reading">☕ {post!.readingTime} min de leitura</span>
            </div>
            <h1 class="article-title">{post!.title}</h1>
            <p class="article-excerpt-header">{post!.excerpt}</p>
            {post!.tags.length > 0 && (
              <div class="article-tags">
                {post!.tags.map(tag => (
                  <a href={`/blog?tag=${tag.slug}`} class="tag">#{tag.name}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      {post!.featuredImage && (
        <div class="article-cover" data-reveal>
          <div class="container">
            <div class="cover-frame">
              <img
                src={post!.featuredImage}
                alt={post!.featuredImageAlt}
                class="cover-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <div class="cover-shine"></div>
            </div>
          </div>
        </div>
      )}

      <div class="article-content-section">
        <div class="container">
          <div class="article-layout">
            <div class="article-main">
              <div class="article-content prose" set:html={post!.content.replace(/<h1([^>]*)>/gi, '<h2$1>').replace(/<\/h1>/gi, '</h2>')} />

              {/* Author box */}
              <div class="article-author" data-reveal>
                <div class="author-avatar">&#9749;</div>
                <div class="author-info">
                  <span class="author-label">Escrito por</span>
                  <strong class="author-name">Artigo com Café</strong>
                  <p class="author-bio">
                    Conteúdo autoral sobre o universo do café — sempre acompanhado de uma boa xícara.
                  </p>
                </div>
                <a href="/sobre" class="author-link">Conheça o projeto →</a>
              </div>

              {/* Prev / Next navigation */}
              <nav class="article-nav" aria-label="Navegação entre artigos">
                {prev ? (
                  <a href={`/blog/${prev.slug}/`} class="article-nav-card prev" data-reveal>
                    <span class="article-nav-label">← Anterior</span>
                    <span class="article-nav-title">{prev.title}</span>
                  </a>
                ) : <div />}
                {next ? (
                  <a href={`/blog/${next.slug}/`} class="article-nav-card next" data-reveal>
                    <span class="article-nav-label">Próximo →</span>
                    <span class="article-nav-title">{next.title}</span>
                  </a>
                ) : <div />}
              </nav>
            </div>

            <aside class="article-sidebar">
              {/* Actions */}
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-title">Ações</h3>
                <ArticleActions articleId={post!.id} client:load />
              </div>

              {/* Table of contents */}
              {tocHeadings.length > 0 && (
                <div class="sidebar-card glass-card" data-reveal>
                  <h3 class="sidebar-title">Neste artigo</h3>
                  <ArticleToc client:load />
                </div>
              )}

              {post!.categories.length > 0 && (
                <div class="sidebar-card glass-card" data-reveal>
                  <h3 class="sidebar-title">Categorias</h3>
                  <div class="sidebar-tags">
                    {post!.categories.map(cat => (
                      <a href={`/blog?categoria=${cat.slug}`} class="sidebar-tag">{cat.name}</a>
                    ))}
                  </div>
                </div>
              )}
              {post!.tags.length > 0 && (
                <div class="sidebar-card glass-card" data-reveal>
                  <h3 class="sidebar-title">Tags</h3>
                  <div class="sidebar-tags">
                    {post!.tags.map(tag => (
                      <span class="sidebar-tag">{tag.name}</span>
                    ))}
                  </div>
                </div>
              )}
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-title">Compartilhar</h3>
                <div class="share-links">
                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post!.title)}&url=${encodeURIComponent(`https://artigocomcafe.com/blog/${post!.slug}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="share-link"
                    aria-label="Compartilhar no Twitter"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://artigocomcafe.com/blog/${post!.slug}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="share-link"
                    aria-label="Compartilhar no Facebook"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                  <a
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://artigocomcafe.com/blog/${post!.slug}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="share-link"
                    aria-label="Compartilhar no LinkedIn"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
                  <button
                    class="share-link"
                    id="copy-link"
                    aria-label="Copiar link"
                    data-url={`https://artigocomcafe.com/blog/${post!.slug}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  </button>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </article>

    {/* Related Articles */}
    {related.length > 0 && (
      <section class="section" data-reveal>
        <div class="container">
          <div class="section-header">
            <span class="section-label">Continue Lendo</span>
            <h2 class="section-title">Artigos Relacionados</h2>
          </div>
          <div class="articles-grid">
            {related.slice(0, 4).map((r, i) => (
              <ArticleCard post={r} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Back to top */}
    <button id="back-to-top" class="back-to-top" aria-label="Voltar ao topo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5" />
        <polyline points="5 12 12 5 19 12" />
      </svg>
    </button>

    <ToastProvider>
      <ReadingTracker articleId={post!.id} articleTitle={post!.title} client:load />
    </ToastProvider>
    <ReaderAssistant client:visible />

    <script>
      const copyBtn = document.getElementById('copy-link')
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const url = copyBtn.getAttribute('data-url')
          if (url) {
            try {
              await navigator.clipboard.writeText(url)
              const original = copyBtn.innerHTML
              copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
              copyBtn.style.color = 'var(--color-accent)'
              setTimeout(() => { copyBtn.innerHTML = original; copyBtn.style.color = '' }, 2000)
            } catch {}
          }
        })
      }

      const backToTop = document.getElementById('back-to-top')
      if (backToTop) {
        const onScroll = () => {
          if (window.scrollY > 600) {
            backToTop.classList.add('visible')
          } else {
            backToTop.classList.remove('visible')
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true })
        onScroll()
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })
      }
    </script>
  </Base>
)}

<style is:global>
  .article-page {
    padding-top: 64px;
  }

  .article-header-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 0 4rem;
    background: color-mix(in srgb, var(--color-bg-card) 40%, var(--color-bg-primary));
    border-bottom: 1px solid var(--color-bg-card-border);
  }

  .article-header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .article-header-sphere {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.7;
    animation: float-particle 12s ease-in-out infinite;
  }

  .a-hs-1 {
    width: 380px;
    height: 380px;
    top: -20%;
    left: -5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent);
  }

  .a-hs-2 {
    width: 300px;
    height: 300px;
    bottom: -30%;
    right: 5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-secondary) 18%, transparent), transparent);
    animation-delay: -5s;
  }

  .article-header {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .article-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    text-decoration: none;
    transition: all 0.3s;
  }

  .article-category:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .article-date,
  .article-reading {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .article-title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .article-excerpt-header {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 640px;
    margin-bottom: 1.5rem;
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.78rem;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.3s;
  }

  .tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .article-cover {
    padding: 3rem 0 1rem;
  }

  .cover-frame {
    position: relative;
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-bg-card-border);
  }

  .cover-image {
    width: 100%;
    height: clamp(260px, 40vw, 480px);
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cover-frame:hover .cover-image {
    transform: scale(1.02);
  }

  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, color-mix(in srgb, white 10%, transparent) 50%, transparent 60%);
    background-size: 200% 200%;
    animation: gradient-shift 10s ease infinite;
    pointer-events: none;
  }

  .article-content-section {
    padding: 2rem 0 4rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    align-items: start;
  }

  .article-main {
    min-width: 0;
  }

  .article-content {
    max-width: 100%;
  }

  .article-content h2,
  .article-content h3 {
    scroll-margin-top: 90px;
  }

  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-right: 2px;
  }

  .sidebar-card {
    padding: 1.25rem;
  }

  .sidebar-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }

  .sidebar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sidebar-tag {
    font-size: 0.78rem;
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.25s;
  }

  a.sidebar-tag:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .share-links {
    display: flex;
    gap: 0.5rem;
  }

  .share-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .share-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    margin-top: 3rem;
    border-radius: var(--radius-card-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    flex-wrap: wrap;
  }

  .author-avatar {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    color: var(--color-btn-text);
  }

  .author-info {
    flex: 1;
    min-width: 200px;
  }

  .author-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .author-name {
    display: block;
    font-size: 1.05rem;
    color: var(--color-text-primary);
    margin: 0.15rem 0 0.35rem;
  }

  .author-bio {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .author-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.25s;
  }

  .author-link:hover {
    opacity: 0.8;
  }

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .article-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .article-nav-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .article-nav-card.next {
    text-align: right;
  }

  .article-nav-label {
    font-size: 0.75rem;
