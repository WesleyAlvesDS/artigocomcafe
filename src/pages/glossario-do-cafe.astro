---
import Base from '../layouts/Base.astro'
import ScrollAnimations from '../components/ScrollAnimations.astro'
import SeoLandingPage from '../components/SeoLandingPage.astro'
import { seoLandings } from '../data/seoLanding'

const data = seoLandings.find(l => l.slug === 'glossario-do-cafe')!
---

<Base
  title={data.pageTitle}
  description={data.description}
  canonical={`/${data.slug}/`}
  fullWidth
  breadcrumbs={[{ name: 'Início', slug: '/' }, { name: data.h1, slug: `/${data.slug}/` }]}
>
  <SeoLandingPage data={data} />
  <ScrollAnimations />
</Base>
