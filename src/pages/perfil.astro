---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import ProfilePage from '../components/ProfilePage.tsx'
---

<Base title="Meu Perfil — Artigo com Café" description="Seu perfil e evolução no Artigo com Café" canonical="/perfil/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }, { name: 'Perfil', slug: '/perfil/' }]}>
  <section class="min-h-screen py-20 px-4" aria-label="Meu perfil">
    <div class="max-w-4xl mx-auto">
      <LoggedAreaNav current="perfil" crumb="Meu Perfil" />
      <ProfilePage client:visible />
    </div>
  </section>
</Base>
