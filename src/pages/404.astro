---
import Base from '../layouts/Base.astro'
---

<Base title="Página não encontrada — Artigo com Café" description="A página que você procura não existe." canonical="/404/">
  <section class="section" style="min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div class="container">
      <div class="not-found" data-reveal>
        <span class="not-found-code">404</span>
        <h1 class="section-title">Página não encontrada</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem; max-width: 500px;">
          A página que você procura pode ter sido removida, renomeada ou está temporariamente indisponível.
        </p>
        <div class="not-found-actions">
          <a href="/" class="btn-primary">Voltar ao Início</a>
          <a href="/blog" class="btn-ghost">Ver Artigos</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found-code {
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 800;
    font-family: var(--font-mono);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .not-found-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
