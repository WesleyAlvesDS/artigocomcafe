---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import DashboardPage from '../components/DashboardPage.tsx'
---

<Base title="Dashboard — Artigo com Café" description="Seu painel de controle e evolução no Artigo com Café. Acompanhe grãos, leituras, trilhas, clima e mais." canonical="/dashboard/" hideAiAssistant editorial={false} breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }]}>
  <section class="min-h-screen py-20 px-4" aria-label="Dashboard">
    <div class="max-w-6xl mx-auto">
      <LoggedAreaNav current="dashboard" crumb="Dashboard" />
      <DashboardPage client:load />
    </div>
  </section>
</Base>

<style is:global>
  /* Dashboard stagger animation */
  @keyframes dash-fade-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .glass-card {
    animation: dash-fade-in 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .glass-card:nth-child(1) { animation-delay: 0ms; }
  .glass-card:nth-child(2) { animation-delay: 50ms; }
  .glass-card:nth-child(3) { animation-delay: 100ms; }
  .glass-card:nth-child(4) { animation-delay: 150ms; }
  .glass-card:nth-child(5) { animation-delay: 200ms; }
  .glass-card:nth-child(6) { animation-delay: 250ms; }
  .glass-card:nth-child(7) { animation-delay: 300ms; }
  .glass-card:nth-child(8) { animation-delay: 350ms; }

  /* Floating glow orbs */
  @keyframes float-orb {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(10px, -10px) scale(1.1);
    }
    66% {
      transform: translate(-5px, 5px) scale(0.95);
    }
  }

  /* Pulse glow for active elements */
  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 20px var(--color-accent-glow);
    }
    50% {
      box-shadow: 0 0 30px var(--color-accent-glow);
    }
  }

  /* Dashboard-specific responsive fixes */
  @media (max-width: 640px) {
    .glass-card {
      animation: none;
    }
  }

  /* Stat card shimmer on hover */
  .stat-card-shimmer {
    position: relative;
    overflow: hidden;
  }

  .stat-card-shimmer::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      to right,
      transparent 0%,
      color-mix(in srgb, var(--color-accent) 5%, transparent) 50%,
      transparent 100%
    );
    transform: rotate(30deg);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .stat-card-shimmer:hover::after {
    opacity: 1;
    animation: shimmer 1.5s ease-in-out;
  }

  @keyframes shimmer {
    0% {
      transform: rotate(30deg) translateX(-100%);
    }
    100% {
      transform: rotate(30deg) translateX(100%);
    }
  }
</style>
