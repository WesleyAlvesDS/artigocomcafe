---
import Base from '../layouts/Base.astro'
import DashboardApp from '../components/DashboardApp'
import '../styles/dashboard-app.css'
---

<Base title="Dashboard — Artigo com Café" description="Seu painel de controle e evolução no Artigo com Café. Acompanhe grãos, leituras, trilhas, clima e mais." canonical="/dashboard/" hideAiAssistant editorial={false} breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }]}>
  <section class="dash-page" aria-label="Dashboard">
    <div class="dash-bg-mesh" aria-hidden="true">
      <div class="dash-orb dash-orb-1"></div>
      <div class="dash-orb dash-orb-2"></div>
      <div class="dash-orb dash-orb-3"></div>
    </div>
    <div class="max-w-6xl mx-auto relative z-10">
      <DashboardApp client:load />
    </div>
  </section>
</Base>
