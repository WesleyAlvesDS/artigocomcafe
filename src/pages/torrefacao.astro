---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import RoasteryPage from '../components/RoasteryPage'
---

<Base title="Torrefação — Artigo com Café" description="Transforme seus grãos em recompensas exclusivas na Torrefação do Artigo com Café" canonical="/torrefacao/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }, { name: 'Torrefação', slug: '/torrefacao/' }]}>
  <section class="min-h-screen py-20 px-4" aria-label="Torrefação">
    <div class="max-w-5xl mx-auto">
      <LoggedAreaNav current="torrefacao" crumb="Torrefação" />
      <RoasteryPage client:visible />
    </div>
  </section>
</Base>
