---
import Base from '../layouts/Base.astro'
import LoginForm from '../components/LoginForm.tsx'
---

<Base title="Entrar — Artigo com Café" description="Entre na sua conta do Artigo com Café" canonical="/entrar/" breadcrumbs={[
    { name: 'Início', slug: '/' },
    { name: 'Entrar', slug: '/entrar/' }
  ]}>
  <section class="section page-header">
    <div class="container">
      <div data-reveal>
        <span class="section-label">Acesso</span>
        <h1 class="section-title">Entrar</h1>
        <p class="section-subtitle">
          Acesse sua biblioteca e continue aprendendo
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper" data-reveal>
          <LoginForm client:load />
          <p class="form-footer">
            Ainda não tem conta?{' '}
            <a href="/cadastro" class="form-footer-link">Criar conta</a>
          </p>
        </div>

        <div class="contact-info" data-reveal="delay-2">
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(0,212,170,0.1); color: var(--color-accent);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </svg>
            </div>
            <h2 class="info-title">Bem-vindo de volta</h2>
            <p class="info-desc">Continue sua jornada de conhecimento do café.</p>
          </div>
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(124,58,237,0.1); color: var(--color-accent-secondary);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <h2 class="info-title">Esqueceu a senha?</h2>
            <p class="info-desc">Recupere seu acesso facilmente.</p>
            <div class="info-social">
              <a href="/recuperar-senha" class="info-social-link">Recuperar senha</a>
            </div>
          </div>
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </div>
            <h2 class="info-title">Newsletter</h2>
            <p class="info-desc">Receba os melhores conteúdos por email.</p>
            <div class="info-social">
              <a href="/newsletter" class="info-social-link">Inscrever-se</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-header {
    padding-bottom: 1rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    padding: 1.5rem;
  }

  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    margin-bottom: 0.75rem;
  }

  .info-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .info-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .info-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .info-social-link {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .info-social-link:hover {
    text-decoration: underline;
  }

  .form-footer {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .form-footer-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .form-footer-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }

  /* Form styles for LoginForm React component */
  .form-error {
    padding: 0.75rem;
    font-size: 0.8rem;
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid rgba(255, 107, 107, 0.3);
    border-radius: var(--radius-card);
  }

  .form-help-link {
    display: block;
    text-align: right;
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.25s;
  }

  .form-help-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  .form-submit {
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-button);
    border: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s, opacity 0.25s;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
