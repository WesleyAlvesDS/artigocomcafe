---
import Base from '../layouts/Base.astro'
import AdSterraBanner from '../components/AdSterraBanner.astro'
import AdSterraSmartLink from '../components/AdSterraSmartLink.astro'
import AdSenseSlot from '../components/AdSenseSlot.astro'
---

<Base title="Sobre — Artigo com Café" description="O café como analogia de um ambiente de leitura acolhedor e acessível a todos. Conheça o projeto Artigo com Café." canonical="/sobre/" breadcrumbs={[
    { name: 'Início', slug: '/' },
    { name: 'Sobre', slug: '/sobre/' }
  ]}>
  <section class="section page-header">
    <div class="container">
      <div data-reveal>
        <span class="section-label">Sobre</span>
        <h1 class="section-title">O Projeto</h1>
        <p class="section-subtitle">
          O café como analogia de um ambiente de leitura aberto a todos.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-content prose" data-reveal>
          <h2>O que é o Artigo com Café?</h2>
          <p>
            O <strong>Artigo com Café</strong> é um ambiente de leitura onde o café é uma 
            <strong>analogia</strong>: assim como uma boa xícara acompanha qualquer momento — 
            da pausa rápida ao mergulho profundo —, acreditamos que a leitura deve estar 
            presente na rotina de todas as pessoas, sem barreiras.
          </p>
          <p>
            Por isso o nome: o café representa o convite, o acolhimento e a leveza com que 
            apresentamos conhecimento de qualidade. Cultura, história, ciência, receitas e 
            histórias — sempre em um tom que faz você querer continuar lendo, a qualquer hora, 
            de qualquer lugar.
          </p>

          <h2>Nossa Filosofia</h2>
          <p>
            O café não é só a bebida — é a metáfora do nosso jeito de ensinar:
          </p>
          <ul>
            <li><strong>Como uma boa xícara, o conhecimento deve ser acessível</strong> — aberto a todos, sem exigir pré-requisitos.</li>
            <li><strong>Como o preparo perfeito, todo conteúdo é feito com cuidado</strong> — cada texto é pesquisado, revisado e escrito para ser compreendido.</li>
            <li><strong>Como a roda de conversa, a leitura é compartilhada</strong> — falamos com você, não "para" você.</li>
          </ul>

          <h2>O que você encontra aqui</h2>
          <ul>
            <li>Um ambiente de leitura completo: artigos, receitas, biblioteca e guias</li>
            <li>Conteúdo aprofundado sobre café como porta de entrada para outros saberes</li>
            <li>Uma experiência gamificada, com trilhas, conquistas e missões para manter o hábito</li>
            <li>Navegação simples e aberta — a maioria do conteúdo é acessível sem login</li>
          </ul>

          {/* Anúncio no meio do conteúdo (espaço vazio entre blocos) */}
          <div class="about-ad">
            <AdSterraBanner
              key="a2885857c5978b578e5340115924dbb1"
              width={728}
              height={90}
              label="Publicidade"
              lazy
            />
            {/* Slot reservado para o Google AdSense (desabilitado até criar a unidade) */}
            <AdSenseSlot />
          </div>

          <h2>Como você pode ajudar</h2>
          <p>
            Gostou do ambiente? Existem várias formas de apoiar: compartilhando os artigos,
            assinando a newsletter, enviando sugestões de temas e, claro, preparando uma
            boa xícara enquanto lê. Criar uma conta gratuita também ajuda — cada leitura
            rende grãos, nossa moeda de gamificação, conforme você avança na jornada.
          </p>
        </div>

        <aside class="about-sidebar" data-reveal="delay-2">
          <div class="sidebar-card glass-card">
            <div class="sidebar-avatar">
              <div class="avatar-placeholder">&#9749;</div>
            </div>
            <h3 class="sidebar-card-title">Quem está por trás</h3>
            <p class="sidebar-card-desc">
              Um espaço de leitura aberto a todos, criado com paixão por conhecimento, 
              tecnologia e design de experiência. O café é o nosso convite — a leitura é o nosso destino.
            </p>
            <div class="sidebar-social">
              <a href="/contato" class="sidebar-social-link" aria-label="Contato">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </a>
              <a href="/newsletter" class="sidebar-social-link" aria-label="Newsletter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </a>
            </div>
          </div>
          <div class="sidebar-card glass-card">
            <h3 class="sidebar-card-title">Newsletter</h3>
            <p class="sidebar-card-desc">
              Receba os melhores conteúdos diretamente no seu email.
            </p>
            <a href="/newsletter" class="btn-primary" style="width: 100%; justify-content: center;">
              Inscrever-se
            </a>
          </div>
          <AdSterraSmartLink
            variant="card"
            text="Descubra seleções e experiências para acompanhar seu café."
          />
        </aside>
      </div>
    </div>
  </section>

</Base>

<style>
  .page-header {
    padding-bottom: 1rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-content h2:first-child {
    margin-top: 0;
  }

  .about-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    padding: 1.5rem;
  }

  .about-ad {
    margin: 2.5rem 0;
  }

  .sidebar-avatar {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .avatar-placeholder {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-bg-card);
    border: 2px solid var(--color-bg-card-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .sidebar-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .sidebar-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
    text-align: center;
  }

  .sidebar-social {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .sidebar-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-bg-card-border);
    color: var(--color-text-muted);
    transition: all 0.3s;
    text-decoration: none;
  }

  .sidebar-social-link:hover {
    background: var(--color-accent);
    color: var(--color-btn-text);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-sidebar {
      position: static;
    }
  }
</style>
