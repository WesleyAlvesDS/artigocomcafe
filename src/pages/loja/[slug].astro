---
import Base from '../../layouts/Base.astro'
import ProductCard from '../../components/ProductCard.astro'
import CartDrawer from '../../components/CartDrawer.astro'
import AdSterraNative from '../../components/AdSterraNative.astro'
import ScrollAnimations from '../../components/ScrollAnimations.astro'
import {
  products,
  getProductBySlug,
  getRelatedProducts,
  typeLabels,
  typeIcons,
  typeDescriptions,
  categoryLabels,
  categoryDescriptions,
  formatBRL,
  discountPct,
  ratingFor,
} from '../../data/products'
import type { Product } from '../../data/products'

export function getStaticPaths() {
  return products.map(product => ({ params: { slug: product.slug } }))
}

const { slug } = Astro.params
const product = getProductBySlug(slug!)

const related = product ? getRelatedProducts(product, 4) : []

const rating = product ? ratingFor(product) : null
const discount = product ? discountPct(product) : null

const stockLabels: Record<Product['stock'], { label: string; class: string }> = {
  in: { label: 'Em estoque', class: 'stock-in' },
  low: { label: 'Poucas unidades', class: 'stock-low' },
  out: { label: 'Esgotado', class: 'stock-out' },
}

const schemaProduct = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      image: [`https://artigocomcafe.com${product.image}`],
      description: product.description,
      sku: product.slug,
      brand: { '@type': 'Brand', name: 'Artigo com Café' },
      category: categoryLabels[product.category],
      offers: {
        '@type': 'Offer',
        url: `https://artigocomcafe.com/loja/${product.slug}/`,
        priceCurrency: 'BRL',
        price: product.price.toFixed(2),
        availability:
          product.stock === 'out'
            ? 'https://schema.org/OutOfStock'
            : product.stock === 'low'
              ? 'https://schema.org/LimitedAvailability'
              : 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        seller: { '@type': 'Organization', name: 'Artigo com Café' },
      },
      ...(rating
        ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.rating.toFixed(1), reviewCount: rating.reviews } }
        : {}),
    }
  : null
---

{!product ? (
  <Base title="Produto não encontrado — Artigo com Café">
    <section class="section" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="container">
        <h1 class="section-title">Produto não encontrado</h1>
        <p class="section-subtitle" style="margin: 1rem auto 2rem;">
          O produto que você procura não está disponível ou foi removido da nossa seleção.
        </p>
        <a href="/loja" class="btn-primary">Ver todos os produtos</a>
      </div>
    </section>
  </Base>
) : (
  <Base
    title={`${product.name} — Loja Artigo com Café`}
    description={(product.description || '').substring(0, 160)}
    image={product.image}
    type="product"
    canonical={`/loja/${product.slug}/`}
    breadcrumbs={[
      { name: 'Início', slug: '/' },
      { name: 'Loja', slug: '/loja/' },
      { name: product.name, slug: `/loja/${product.slug}/` }
    ]}
  >
    {schemaProduct && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaProduct)} />
    )}

    <article class="product-page">
      <div class="product-header-section">
        <div class="product-header-spheres">
          <div class="p-hs-1"></div>
          <div class="p-hs-2"></div>
        </div>
        <div class="container">
          <div class="product-breadcrumb" data-reveal>
            <a href="/loja/">← Voltar para a loja</a>
          </div>

          <div class="product-layout">
            <div class="product-gallery" data-reveal>
              <div class="product-gallery-frame">
                <img
                  src={product.image}
                  alt={product.name}
                  class="product-gallery-image"
                  width="800"
                  height="800"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                {discount && <span class="product-discount-badge">-{discount}%</span>}
                {product.badge && <span class="product-badge-main">{product.badge}</span>}
              </div>
            </div>

            <div class="product-info" data-reveal>
              <div class="product-meta">
                <span class="product-category-chip">{categoryLabels[product.category]}</span>
                <span class="product-type-chip">{typeIcons[product.type]} {typeLabels[product.type]}</span>
                <span class:list={['product-stock', stockLabels[product.stock].class]}>
                  <span class="pulse-dot"></span> {stockLabels[product.stock].label}
                </span>
              </div>

              <h1 class="product-name">{product.name}</h1>

              {rating && (
                <div class="product-rating" aria-label={`Avaliação ${rating.rating.toFixed(1)} de 5`}>
                  <span class="stars" aria-hidden="true">{'★'.repeat(Math.round(rating.rating))}{'☆'.repeat(5 - Math.round(rating.rating))}</span>
                  <span class="rating-value">{rating.rating.toFixed(1)}</span>
                  <span class="rating-count">({rating.reviews} avaliações)</span>
                </div>
              )}

              <p class="product-short-desc">{product.description}</p>

              <div class="product-price-box">
                <span class="product-price-big">{formatBRL(product.price)}</span>
                {product.originalPrice && (
                  <span class="product-original">{formatBRL(product.originalPrice)}</span>
                )}
                {discount && <span class="product-save">Economize {formatBRL(product.originalPrice! - product.price)}</span>}
              </div>

              <div class="buy-box" data-buy-box>
                <div class="qty-stepper" aria-label="Quantidade">
                  <button type="button" class="qty-btn" data-qty-minus aria-label="Diminuir quantidade">−</button>
                  <span class="qty-value" data-product-qty>1</span>
                  <button type="button" class="qty-btn" data-qty-plus aria-label="Aumentar quantidade">+</button>
                </div>
                <button
                  type="button"
                  class="btn-primary buy-add-btn"
                  data-add-to-cart
                  data-slug={product.slug}
                  data-name={product.name}
                  data-price={product.price}
                  data-image={product.image}
                  data-open-cart="true"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                  </svg>
                  Adicionar ao carrinho
                </button>
                <button
                  type="button"
                  class="btn-ghost buy-now-btn"
                  data-buy-now
                  data-slug={product.slug}
                  data-name={product.name}
                  data-price={product.price}
                  data-image={product.image}
                >
                  Comprar agora
                </button>
              </div>

              <ul class="product-trust">
                <li>📦 {product.deliveryNote || 'Envio em até 7 dias úteis'}</li>
                <li>🚚 Frete grátis acima de {formatBRL(199)}</li>
                <li>🫘 Esta compra gera grãos na sua jornada</li>
                <li>💚 Você apoia a continuidade do Artigo com Café</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="product-content-section">
        <div class="container">
          <div class="product-content-layout">
            <div class="product-main">
              <section class="product-section" data-reveal>
                <h2 class="product-section-title">Sobre este produto</h2>
                {product.longDescription.map(p => <p class="product-paragraph">{p}</p>)}
              </section>

              <section class="product-section" data-reveal>
                <h2 class="product-section-title">Benefícios</h2>
                <ul class="benefits-list">
                  {product.benefits.map(b => (
                    <li class="benefit-item">
                      <span class="benefit-check" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                      </span>
                      {b}
                    </li>
                  ))}
                </ul>
              </section>

              <section class="product-section" data-reveal>
                <h2 class="product-section-title">Especificações</h2>
                <ul class="specs-list">
                  {product.specs.map(s => (
                    <li class="spec-item">
                      <span class="spec-dot" aria-hidden="true"></span>
                      {s}
                    </li>
                  ))}
                </ul>
              </section>

              <section class="product-section" data-reveal>
                <h2 class="product-section-title">Como funciona este tipo de produto</h2>
                <div class="how-type-card glass-card">
                  <div class="how-type-head">
                    <span class="how-type-icon" aria-hidden="true">{typeIcons[product.type]}</span>
                    <div>
                      <h3 class="how-type-title">{typeLabels[product.type]}</h3>
                      <p class="how-type-sub">{categoryDescriptions[product.category]}</p>
                    </div>
                  </div>
                  <p class="how-type-text">{typeDescriptions[product.type]}</p>
                </div>
              </section>

              {product.faq.length > 0 && (
                <section class="product-section" data-reveal>
                  <h2 class="product-section-title">Perguntas frequentes</h2>
                  <div class="faq-list">
                    {product.faq.map((f, i) => (
                      <details class="faq-item" open={i === 0}>
                        <summary class="faq-question">
                          {f.q}
                          <span class="faq-chevron" aria-hidden="true">▾</span>
                        </summary>
                        <p class="faq-answer">{f.a}</p>
                      </details>
                    ))}
                  </div>
                </section>
              )}

              <section class="product-section" data-reveal>
                <h2 class="product-section-title">Envio, trocas e apoio</h2>
                <div class="info-grid">
                  <div class="info-card">
                    <h3 class="info-title">📦 Envio</h3>
                    <p class="info-text">Produtos de parceiros são enviados em até 3 dias úteis. Itens sob demanda (POD) levam de 3 a 7 dias úteis de produção. Você acompanha o status pelo seu pedido.</p>
                  </div>
                  <div class="info-card">
                    <h3 class="info-title">↩️ Trocas</h3>
                    <p class="info-text">Você tem 7 dias corridos após o recebimento para solicitar troca ou devolução, conforme o Código de Defesa do Consumidor.</p>
                  </div>
                  <div class="info-card">
                    <h3 class="info-title">💚 Apoio</h3>
                    <p class="info-text">Cada compra é uma forma de apoiar o Artigo com Café e manter o projeto no ar. Obrigado por fazer parte dessa jornada.</p>
                  </div>
                </div>
              </section>

              <AdSterraNative lazy className="ad-product-inline" />
            </div>

            <aside class="product-sidebar">
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-card-title">Compartilhar</h3>
                <div class="share-links">
                  <a
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(product.name)}&url=${encodeURIComponent(`https://artigocomcafe.com/loja/${product.slug}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Twitter"
                  >𝕏</a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://artigocomcafe.com/loja/${product.slug}`)}`}
                    target="_blank" rel="noopener" class="share-link" aria-label="Compartilhar no Facebook"
                  >f</a>
                  <button class="share-link" id="copy-product-link" aria-label="Copiar link" data-url={`https://artigocomcafe.com/loja/${product.slug}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="sidebar-card glass-card" data-reveal>
                <h3 class="sidebar-card-title">Apoie o projeto ☕</h3>
                <p class="sidebar-card-text">
                  A loja existe para quem gosta do que encontra por aqui e quer apoiar a continuidade do Artigo com Café levando um pedacinho dessa experiência para casa.
                </p>
                <a href="/sobre" class="sidebar-card-link">Conheça a história →</a>
              </div>
              <AdSterraNative lazy className="ad-product-sidebar" />
            </aside>
          </div>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="section" data-reveal>
        <div class="container">
          <div class="section-header">
            <span class="section-label">Continue explorando</span>
            <h2 class="section-title">Você também pode gostar</h2>
          </div>
          <div class="products-grid products-grid-related">
            {related.map((r, i) => (
              <ProductCard product={r} revealDelay={`delay-${(i % 4) + 1}`} />
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section home-ad-section" data-scroll-reveal="fade">
      <div class="container" style="max-width: 720px;">
        <AdSterraNative lazy />
        <p class="home-ad-disclosure">
          Esta loja apoia o Artigo com Café. Produtos de parceiros (dropshipping) e produção sob demanda (POD).
          Saiba mais sobre <a href="/cookies/">como utilizamos cookies de publicidade</a>.
        </p>
      </div>
    </section>

    <CartDrawer />
    <ScrollAnimations />

    <script is:inline>
      (function () {
        var copyBtn = document.getElementById('copy-product-link')
        if (copyBtn) {
          copyBtn.addEventListener('click', async function () {
            var url = copyBtn.getAttribute('data-url')
            if (!url) return
            try {
              await navigator.clipboard.writeText(url)
              copyBtn.style.color = 'var(--color-accent)'
              setTimeout(function () { copyBtn.style.color = '' }, 2000)
            } catch (e) {}
          })
        }
      })()
    </script>
  </Base>
)}

<style is:global>
  .product-page { padding-top: 40px; }

  /* ── Cabeçalho do produto ── */
  .product-header-section {
    position: relative;
    overflow: hidden;
    padding: 2rem 0 4rem;
  }

  .product-header-spheres { position: absolute; inset: 0; pointer-events: none; }

  .p-hs-1, .p-hs-2 {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
    animation: float-particle 12s ease-in-out infinite;
  }

  .p-hs-1 {
    width: 360px; height: 360px;
    top: -10%; left: 10%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 20%, transparent), transparent);
  }

  .p-hs-2 {
    width: 300px; height: 300px;
    bottom: -25%; right: 0;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent-secondary) 16%, transparent), transparent);
    animation-delay: -5s;
  }

  .product-breadcrumb {
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .product-breadcrumb a {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-decoration: none;
    font-family: var(--font-mono);
    transition: color 0.25s;
  }

  .product-breadcrumb a:hover { color: var(--color-accent); }

  .product-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .product-layout { grid-template-columns: 1fr; gap: 2rem; }
  }

  .product-gallery-frame {
    position: relative;
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    border: 1px solid var(--color-bg-card-border);
    box-shadow: var(--shadow-card);
    background: var(--color-bg-secondary);
  }

  .product-gallery-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
  }

  .product-discount-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 800;
    background: linear-gradient(135deg, #f59e0b, #ef4444);
    color: #fff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .product-badge-main {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
    color: var(--color-btn-text);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .product-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .product-category-chip,
  .product-type-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-accent);
  }

  .product-type-chip { text-transform: none; letter-spacing: 0.02em; font-family: var(--font-sans); }

  .product-stock {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #22c55e;
  }

  .product-stock .pulse-dot { width: 6px; height: 6px; background: #22c55e; }
  .product-stock.stock-low { background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.35); color: #f59e0b; }
  .product-stock.stock-low .pulse-dot { background: #f59e0b; }
  .product-stock.stock-out { background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.35); color: #ef4444; }
  .product-stock.stock-out .pulse-dot { background: #ef4444; }

  .product-name {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.9rem;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .stars { color: #f59e0b; font-size: 1rem; letter-spacing: 0.1em; }

  .rating-value { font-weight: 700; color: var(--color-text-primary); font-size: 0.9rem; }
  .rating-count { color: var(--color-text-muted); font-size: 0.82rem; }

  .product-short-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 560px;
  }

  .product-price-box {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .product-price-big {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    font-family: var(--font-display);
    background: linear-gradient(135deg, var(--color-text-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .product-original {
    font-size: 1.05rem;
    text-decoration: line-through;
    color: var(--color-text-muted);
  }

  .product-save {
    font-size: 0.8rem;
    font-weight: 700;
    color: #22c55e;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    font-family: var(--font-mono);
  }

  .buy-box {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .qty-stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-button);
    border: 1px solid var(--color-bg-card-border);
    background: var(--color-bg-card);
  }

  .qty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: none;
    border-radius: 9px;
    background: var(--color-bg-card-hover);
    color: var(--color-text-primary);
    font-size: 1.05rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .qty-btn:hover { background: color-mix(in srgb, var(--color-accent) 18%, transparent); color: var(--color-accent); }

  .qty-value {
    min-width: 2rem;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .buy-add-btn, .buy-now-btn { flex: 1; min-width: 200px; }

  .buy-now-btn { text-align: center; }

  .product-trust {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.6rem;
  }

  .product-trust li {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-bg-card) 70%, transparent);
    border: 1px solid var(--color-bg-card-border);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    line-height: 1.4;
  }

  /* ── Conteúdo ── */
  .product-content-section { padding: 2rem 0 4rem; }

  .product-content-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 1100px) {
    .product-content-layout { grid-template-columns: minmax(0, 1fr); }
  }

  .product-main { min-width: 0; }

  .product-section { margin-bottom: 3rem; }

