---
import Base from '../layouts/Base.astro'
import LoggedAreaNav from '../components/LoggedAreaNav.astro'
import GrainsPage from '../components/GrainsPage.tsx'
---

<Base title="Meus Grãos — Artigo com Café" description="Seus grãos de conhecimento" canonical="/graos/" breadcrumbs={[{ name: 'Início', slug: '/' }, { name: 'Área do leitor', slug: '/dashboard/' }, { name: 'Grãos', slug: '/graos/' }]}>
  <section class="min-h-screen py-20 px-4" aria-label="Meus grãos">
    <div class="max-w-5xl mx-auto">
      <LoggedAreaNav current="graos" crumb="Meus Grãos" />
      <GrainsPage client:visible />
    </div>
  </section>
</Base>
