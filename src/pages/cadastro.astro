---
import Base from '../layouts/Base.astro'
import '../styles/auth-pages.css'
import RegisterForm from '../components/RegisterForm.tsx'
---

<Base title="Criar Conta — Artigo com Café" description="Crie sua conta no Artigo com Café e comece sua jornada de aprendizado" canonical="/cadastro/" fullWidth breadcrumbs={[
    { name: 'Início', slug: '/' },
    { name: 'Criar Conta', slug: '/cadastro/' }
  ]}>
  <div class="auth-page">
  <section class="section page-header">
    <div class="container">
      <div data-reveal>
        <span class="section-label">Acesso</span>
        <h1 class="section-title">Criar Conta</h1>
        <p class="section-subtitle">
          Comece sua jornada de conhecimento hoje
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper" data-reveal>
          <RegisterForm client:visible />
          
          <div class="social-login">
            <div class="social-login-divider">
              <span>ou cadastre-se com</span>
            </div>
            <div class="social-login-buttons">
              <a href="/auth/google" class="social-btn social-google">
                <svg width="20" height="20" viewBox="0 0 24 24">
                  <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                  <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Google
              </a>
              <a href="/auth/github" class="social-btn social-github">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>
          
          <p class="form-footer">
            Já tem conta?{' '}
            <a href="/entrar" class="form-footer-link">Entrar</a>
          </p>
        </div>

        <div class="contact-info" data-reveal="delay-2">
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(0,212,170,0.1); color: var(--color-accent);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5" />
                <path d="M2 12l10 5 10-5" />
              </svg>
            </div>
            <h2 class="info-title">Escolha sua identidade</h2>
            <p class="info-desc">Sua identidade define cores, ícones e vocabulário do site.</p>
          </div>
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(124,58,237,0.1); color: var(--color-accent-secondary);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h2 class="info-title">Jornada personalizada</h2>
            <p class="info-desc">Missões, grãos e trilhas adaptados ao seu tema.</p>
          </div>
          <div class="info-card glass-card">
            <div class="info-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
              </svg>
            </div>
            <h2 class="info-title">Newsletter</h2>
            <p class="info-desc">Receba os melhores conteúdos por email.</p>
            <div class="info-social">
              <a href="/newsletter" class="info-social-link">Inscrever-se</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>


