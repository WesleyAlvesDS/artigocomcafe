---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CookieConsent from '../components/CookieConsent.astro'
import PwaInstallPrompt from '../components/PwaInstallPrompt'
import SearchModal from '../components/SearchModal'
import AIFloatingWidget from '../components/AIFloatingWidget'
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
  canonical?: string
  breadcrumbs?: Array<{ name: string; slug: string }>
  disableTransitions?: boolean
  hideAiAssistant?: boolean
  transitionName?: string
  editorial?: boolean
}

const {
  title = 'Artigo com Café — Blog de Cafeteria Digital',
  description = 'Blog autoral sobre o universo do café: cultura, história e conhecimento. Conteúdo aprofundado para quem ama aprender e se inspirar.',
  image = '/images/og-default.svg',
  type = 'website',
  canonical,
  breadcrumbs = [],
  disableTransitions = false,
  hideAiAssistant = false,
  transitionName = 'page-root',
  editorial = true
} = Astro.props

const siteUrl = 'https://artigocomcafe.com'
const fullTitle = title.includes('Artigo com Café') ? title : `${title} — Artigo com Café`
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl
const ogImage = image.startsWith('http')
  ? image
  : image.endsWith('.png.ts')
    ? `${siteUrl}${image.replace('.ts', '')}`
    : `${siteUrl}${image}`

const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': crumb.name,
    'item': `${siteUrl}${crumb.slug}`
  }))
} : null

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Artigo com Café',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`,
  'description': 'Plataforma de conhecimento sobre café. Cultura, tecnologia e experiências de aprendizado em torno de cada xícara.'
}
---

<!doctype html>
<html lang="pt-BR" data-ecpn="ryhkx4gd?key=1c1fb12053a54c089ff2c5a6c46c3ef1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0805" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="robots" content="index, follow" />

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Café" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Café" />

    <meta name="apple-mobile-web-app-status-bar" content="black-translucent" />

    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Artigo com Café" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Artigo com Café - Feed RSS" href="/feed.xml" />
    <meta name="google-adsense-account" content="ca-pub-4516147510474933" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4516147510474933"
     crossorigin="anonymous"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..500&family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />

    <link rel="preconnect" href="https://back.artigocomcafe.com" crossorigin />
    <link rel="dns-prefetch" href="https://back.artigocomcafe.com" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#d4a373" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="msapplication-TileColor" content="#0a0805" />
    <meta name="msapplication-TileImage" content="/favicon-144x144.png" />
    <meta name="msapplication-config" content="none" />

    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.__enableAnalytics = function() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TMDJNM49Q6';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-TMDJNM49Q6');
      };
      (function() {
        try {
          var consent = JSON.parse(localStorage.getItem('cookie-consent') || 'null');
          if (consent && consent.analytics) window.__enableAnalytics();
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://www.effectivecpmnetwork.com">

    {!disableTransitions && (
      <>
        <meta name="astro-view-transitions-enabled" content="true" />
        <ClientRouter fallback="animate" />
      </>
    )}

    <style is:inline>
      .skip-to-content {
        position: fixed;
        top: -100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        padding: 0.75rem 1.5rem;
        background: var(--color-accent);
        color: var(--color-btn-text);
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 0 0 12px 12px;
        text-decoration: none;
        transition: top 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .skip-to-content:focus {
        top: 0;
      }

      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                    transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

      [data-reveal].revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .ai-floating-widget {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 9999;
        width: 380px;
        max-width: calc(100vw - 2rem);
        height: min(580px, calc(100dvh - 2.5rem));
        display: flex;
        flex-direction: column;
        background: var(--color-bg-primary);
        border: 1px solid var(--color-bg-card-border);
        border-radius: 1.25rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.05);
        overflow: hidden;
        transform-origin: bottom right;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s;
        animation: ai-panel-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .ai-floating-widget.open {
        transform: translateY(0) scale(1);
        opacity: 1;
        pointer-events: auto;
      }
      @keyframes ai-panel-in {
        from { opacity: 0; transform: translateY(24px) scale(0.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      .ai-launcher {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 9998;
        width: 60px;
        height: 60px;
        border: none;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        color: var(--color-btn-text);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 34px color-mix(in srgb, var(--color-accent) 45%, transparent);
        transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s;
        animation: ai-launcher-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .ai-launcher:hover {
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 14px 44px color-mix(in srgb, var(--color-accent) 55%, transparent);
      }
      .ai-launcher:active { transform: scale(0.96); }
      @keyframes ai-launcher-in {
        from { opacity: 0; transform: translateY(20px) scale(0.5); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      .ai-launcher-inner { display: flex; align-items: center; justify-content: center; position: relative; }
      .ai-launcher-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
        animation: ai-ring-pulse 2.4s infinite ease-out;
      }
      @keyframes ai-ring-pulse {
        0% { transform: scale(0.8); opacity: 1; }
        100% { transform: scale(1.5); opacity: 0; }
      }
      .ai-badge {
        position: absolute;
        top: -4px;
        right: -6px;
        font-size: 0.6rem;
        padding: 0.12rem 0.42rem;
        border-radius: 100px;
        background: var(--color-bg-primary);
        color: var(--color-accent);
        font-weight: 800;
        box-shadow: 0 2px 8px rgba(0,0,0,0.25);
      }

      .ai-welcome-bubble {
        position: fixed;
        right: 1.25rem;
        bottom: 9.5rem;
        z-index: 9997;
        width: min(320px, calc(100vw - 2rem));
        padding: 1rem;
        background: var(--color-glass-bg);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid var(--color-glass-border);
        border-radius: 1rem;
        box-shadow: var(--shadow-card);
        animation: ai-welcome-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      @keyframes ai-welcome-in {
        from { opacity: 0; transform: translateY(16px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      .ai-welcome-close {
        position: absolute;
        top: 0.4rem;
        right: 0.5rem;
        background: none;
        border: none;
        color: var(--color-text-muted);
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
      }
      .ai-welcome-close:hover { color: var(--color-text-primary); }
      .ai-welcome-body { display: flex; gap: 0.6rem; margin-bottom: 0.75rem; }
      .ai-welcome-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        color: var(--color-btn-text);
      }
      .ai-welcome-text {
        font-size: 0.82rem;
        line-height: 1.5;
        color: var(--color-text-secondary);
        margin: 0;
      }
      .ai-welcome-text strong { color: var(--color-text-primary); }
      .ai-welcome-start {
        width: 100%;
        padding: 0.6rem;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        color: var(--color-btn-text);
        font-weight: 600;
        font-size: 0.82rem;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .ai-welcome-start:hover { transform: translateY(-1px); box-shadow: var(--shadow-glow); }

      .ai-floating-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 1rem;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        color: var(--color-btn-text);
      }
      .ai-floating-title { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.9rem; }
      .ai-status-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 8px #22c55e; animation: pulse 2s infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

      .ai-floating-actions { display: flex; gap: 0.25rem; }
      .ai-floating-btn-icon {
        display: flex; align-items: center; justify-content: center;
        width: 30px; height: 30px;
        border: none; background: rgba(255,255,255,0.15);
        border-radius: 8px; color: var(--color-btn-text);
        cursor: pointer; transition: background 0.2s;
      }
      .ai-floating-btn-icon:hover { background: rgba(255,255,255,0.3); }

      .ai-floating-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
      .ai-floating-tabs {
        display: flex; background: var(--color-bg-card);
        border-bottom: 1px solid var(--color-bg-card-border);
      }
      .ai-floating-tab {
        flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.4rem;
        padding: 0.7rem; background: none; border: none;
        color: var(--color-text-muted); font-size: 0.8rem; font-weight: 500;
        cursor: pointer; transition: all 0.2s; border-bottom: 2px solid transparent;
      }
      .ai-floating-tab:hover { color: var(--color-text-primary); background: var(--color-bg-card-hover); }
      .ai-floating-tab.active {
        color: var(--color-accent); border-bottom-color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      }

      .ai-floating-panel { flex: 1; overflow-y: auto; padding: 1rem; }

      .ai-chat-panel { display: flex; flex-direction: column; height: 100%; }
      .ai-chat-messages { flex: 1; overflow-y: auto; padding: 0.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
      .ai-message { max-width: 85%; padding: 0.75rem 1rem; border-radius: 14px; font-size: 0.85rem; line-height: 1.6; }
      .ai-message-bot { align-self: flex-start; background: var(--color-bg-card); border: 1px solid var(--color-bg-card-border); border-bottom-left-radius: 4px; }
      .ai-message-content { white-space: pre-wrap; }
      .ai-message.loading .ai-typing { display: flex; gap: 3px; }
      .ai-typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); animation: typing 1.4s infinite ease-in-out both; }
      .ai-typing span:nth-child(1) { animation-delay: -0.32s; }
      .ai-typing span:nth-child(2) { animation-delay: -0.16s; }
      @keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }
      .ai-message-error { align-self: center; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; text-align: center; }
      .ai-chat-input { display: flex; gap: 0.5rem; padding-top: 0.75rem; border-top: 1px solid var(--color-bg-card-border); }
      .ai-chat-input-field { flex: 1; padding: 0.6rem 0.9rem; border: 1px solid var(--color-bg-card-border); border-radius: 10px; background: var(--color-bg-card); color: var(--color-text-primary); font-size: 0.85rem; outline: none; transition: border-color 0.2s; }
      .ai-chat-input-field:focus { border-color: var(--color-accent); }
      .ai-chat-send { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: none; background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary)); border-radius: 10px; color: var(--color-btn-text); cursor: pointer; transition: transform 0.2s, opacity 0.2s; }
      .ai-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
      .ai-chat-send:hover:not(:disabled) { transform: scale(1.05); }

      .ai-tools-post-selector { margin-bottom: 1rem; }
      .ai-tools-post-selector label { display: block; font-size: 0.75rem; font-weight: 600; color: var(--color-text-secondary); margin-bottom: 0.4rem; }
      .ai-select { width: 100%; padding: 0.6rem 0.9rem; border: 1px solid var(--color-bg-card-border); border-radius: 10px; background: var(--color-bg-card); color: var(--color-text-primary); font-size: 0.85rem; outline: none; }
      .ai-selected-post { margin-top: 0.5rem; padding: 0.5rem; background: color-mix(in srgb, var(--color-accent) 10%, transparent); border-radius: 8px; font-size: 0.8rem; }
      .ai-selected-post strong { display: block; color: var(--color-text-primary); }
      .ai-selected-post span { color: var(--color-text-muted); font-size: 0.7rem; }

      .ai-tools-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
      .ai-tool-btn {
        display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
        padding: 0.75rem; border: 1px solid var(--color-bg-card-border); border-radius: 12px;
        background: var(--color-bg-card); color: var(--color-text-primary); font-size: 0.75rem; font-weight: 500; cursor: pointer; transition: all 0.2s;
      }
      .ai-tool-btn:hover:not(:disabled) { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, transparent); transform: translateY(-2px); }
      .ai-tool-btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .ai-tool-icon { font-size: 1.25rem; }
      .ai-tool-name { text-align: center; }

      .ai-loading { text-align: center; padding: 1.5rem; color: var(--color-text-muted); font-size: 0.85rem; }
      .ai-error { margin-top: 1rem; padding: 0.75rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; color: #ef4444; font-size: 0.8rem; }
      .ai-result { margin-top: 1rem; border: 1px solid var(--color-bg-card-border); border-radius: 12px; background: var(--color-bg-card); overflow: hidden; }
      .ai-result-header { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-bg-card-border); }
      .ai-close-result { background: none; border: none; color: var(--color-text-muted); font-size: 1.25rem; cursor: pointer; line-height: 1; }
      .ai-result-content { padding: 1rem; font-size: 0.8rem; line-height: 1.6; white-space: pre-wrap; }

      .ai-posts-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--color-bg-card-border); }
      .ai-posts-count { font-size: 0.75rem; color: var(--color-text-muted); }
      .ai-posts-list { display: flex; flex-direction: column; gap: 0.5rem; max-height: 300px; overflow-y: auto; }
      .ai-post-item { padding: 0.75rem; background: var(--color-bg-card); border: 1px solid var(--color-bg-card-border); border-radius: 10px; cursor: pointer; transition: all 0.2s; }
      .ai-post-item:hover { border-color: var(--color-accent); transform: translateX(4px); }
      .ai-post-title { font-weight: 600; font-size: 0.85rem; color: var(--color-text-primary); margin-bottom: 0.35rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      .ai-post-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.7rem; color: var(--color-text-muted); }
      .ai-status { padding: 0.1rem 0.5rem; border-radius: 100px; font-weight: 600; text-transform: capitalize; }
      .ai-status-published { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
      .ai-status-draft { background: rgba(107, 114, 128, 0.15); color: #6b7280; }
      .ai-status-review { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
      .ai-status-scheduled { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
      .ai-status-archived { background: rgba(107, 114, 128, 0.15); color: #6b7280; }
      .ai-empty { text-align: center; padding: 2rem; color: var(--color-text-muted); font-size: 0.85rem; }

      @media (max-width: 480px) {
        .ai-floating-widget { width: calc(100vw - 2rem); max-width: 100vw; right: 1rem; bottom: 1rem; }
        .ai-launcher { right: 1rem; bottom: 1rem; }
        .ai-welcome-bubble { right: 1rem; bottom: 8.5rem; }
      }
    </style>
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body data-api-base="https://back.artigocomcafe.com/api" class:list={[editorial && 'body-editorial']}>
    <div class="app-aurora" aria-hidden="true"></div>
    <div class="app-grid-overlay" aria-hidden="true"></div>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo</a>

    {/* Botão voltar-ao-topo com anel de progresso de leitura */}
    <button id="back-to-top" class="back-to-top" type="button" aria-label="Voltar ao topo da página" title="Voltar ao topo">
      <svg width="30" height="30" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="btt-ring-bg" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.25" />
        <circle class="btt-ring-fg" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" transform="rotate(-90 24 24)" />
        <polyline points="18 28 24 22 30 28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme')
        if (theme === 'light') { document.documentElement.classList.add('light') }
        else if (theme === 'dark' || !window.matchMedia('(prefers-color-scheme: light)').matches) { document.documentElement.classList.remove('light') }
        else { document.documentElement.classList.add('light') }
      })()
    </script>

    <script is:inline>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('revealed')
        })
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' })

      function revealAll() {
        document.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('revealed'))
      }

      function initReveal() {
        if (prefersReducedMotion) {
          revealAll()
          return
        }
        document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el))
        const main = document.getElementById('main-content')
        if (main && !main.hasAttribute('tabindex')) {
          main.setAttribute('tabindex', '-1')
        }
      }

      document.addEventListener('astro:page-load', initReveal)

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal)
      } else {
        initReveal()
      }

      window.addEventListener('load', () => {
        setTimeout(revealAll, 2500)
      })
    </script>

    <script is:inline>
      (function () {
        var bar = document.getElementById('scroll-progress')
        if (!bar) return
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var ticking = false
        function update() {
          var doc = document.documentElement
          var max = doc.scrollHeight - window.innerHeight
          var pct = max > 0 ? (window.pageYOffset / max) * 100 : 0
          bar.style.width = pct + '%'
          ticking = false
        }
        function request() { if (!ticking) { requestAnimationFrame(update); ticking = true } }
        window.addEventListener('scroll', request, { passive: true })
        window.addEventListener('resize', request, { passive: true })
        update()
      })()
    </script>

    <script is:inline>
      // ── Micro-interações futuristas: spotlight, tilt 3D, magnético ──
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var isPointerFine = window.matchMedia('(pointer: fine)').matches
        if (!isPointerFine) return

        var ticking = false

        // Spotlight: segue o mouse dentro de cada card marcado
        function initSpotlight(root) {
          var cards = root.querySelectorAll('.spotlight-card')
          cards.forEach(function (card) {
            if (card.dataset.mxSpotlight === '1') return
            card.dataset.mxSpotlight = '1'
            card.addEventListener('pointermove', function (e) {
              var rect = card.getBoundingClientRect()
              var x = ((e.clientX - rect.left) / rect.width) * 100
              var y = ((e.clientY - rect.top) / rect.height) * 100
              card.style.setProperty('--spot-x', x + '%')
              card.style.setProperty('--spot-y', y + '%')
            })
          })
        }

        // Tilt 3D: rotação sutil em perspectiva no hover
        function initTilt(root) {
          var cards = root.querySelectorAll('.tilt-card')
          cards.forEach(function (card) {
            if (card.dataset.mxTilt === '1') return
            card.dataset.mxTilt = '1'
            card.addEventListener('pointermove', function (e) {
              if (ticking) return
              ticking = true
              requestAnimationFrame(function () {
                var rect = card.getBoundingClientRect()
                var px = (e.clientX - rect.left) / rect.width
                var py = (e.clientY - rect.top) / rect.height
                var rx = (0.5 - py) * 7
                var ry = (px - 0.5) * 9
                card.style.transform = 'perspective(900px) rotateX(' + rx.toFixed(2) + 'deg) rotateY(' + ry.toFixed(2) + 'deg) translateY(-2px)'
                ticking = false
              })
            })
            card.addEventListener('pointerleave', function () {
              card.style.transform = ''
            })
          })
        }

        // Magnético: botões se aproximam do cursor (com volta suave)
        function initMagnetic(root) {
          var els = root.querySelectorAll('.magnetic')
          els.forEach(function (el) {
            if (el.dataset.mxMagnetic === '1') return
            el.dataset.mxMagnetic = '1'
            el.addEventListener('pointermove', function (e) {
              var rect = el.getBoundingClientRect()
              var dx = e.clientX - (rect.left + rect.width / 2)
              var dy = e.clientY - (rect.top + rect.height / 2)
              var strength = el.dataset.magneticStrength ? parseFloat(el.dataset.magneticStrength) : 0.28
              el.style.transform = 'translate(' + (dx * strength).toFixed(1) + 'px, ' + (dy * strength).toFixed(1) + 'px)'
            })
            el.addEventListener('pointerleave', function () {
              el.style.transform = ''
            })
          })
        }

        function initAll() {
          initSpotlight(document)
          initTilt(document)
          initMagnetic(document)
        }

        document.addEventListener('astro:page-load', initAll)
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAll)
        } else {
          initAll()
        }
      })()
    </script>

    <script is:inline>
      // ── Imersão no scroll: hero recua (zoom-out) e desvanece ao rolar ──
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var ticking = false

        function update() {
          var hero = document.querySelector('[data-hero]')
          if (!hero) { ticking = false; return }
          var y = window.pageYOffset
          var vh = window.innerHeight
          // Primeiros 60% da viewport de rolagem do hero
          var max = vh * 0.6
          var p = Math.min(1, y / max)
          // Zoom-out + recuo + desvanecimento suave
          hero.style.transform = 'scale(' + (1 - p * 0.06).toFixed(4) + ') translateY(' + (p * 40).toFixed(1) + 'px)'
          hero.style.opacity = String(Math.max(0, 1 - p * 0.35))
          hero.style.filter = p > 0 ? 'blur(' + (p * 2.5).toFixed(2) + 'px)' : ''
          ticking = false
        }

        function request() {
          if (!ticking) { requestAnimationFrame(update); ticking = true }
        }
        window.addEventListener('scroll', request, { passive: true })
        window.addEventListener('resize', request, { passive: true })
      })()
    </script>

    <script is:inline>
      // ── Navegação inteligente: botão voltar-ao-topo com anel de progresso ──
      (function () {
        var CIRC = 2 * Math.PI * 20
        var ticking = false

        function update() {
          var btn = document.getElementById('back-to-top')
          if (!btn) return
          var ring = btn.querySelector('.btt-ring-fg')
          var doc = document.documentElement
          var max = doc.scrollHeight - window.innerHeight
          var pct = max > 0 ? Math.min(1, Math.max(0, window.pageYOffset / max)) : 0
          btn.classList.toggle('visible', window.pageYOffset > 480)
          if (ring) ring.style.strokeDashoffset = String(CIRC * (1 - pct))
          ticking = false
        }

        function request() { if (!ticking) { requestAnimationFrame(update); ticking = true } }
        window.addEventListener('scroll', request, { passive: true })
        window.addEventListener('resize', request, { passive: true })

        // Delegação de clique: sobrevive à navegação SPA (botão recriado no swap)
        document.addEventListener('click', function (e) {
          if (e.target && e.target.closest && e.target.closest('#back-to-top')) {
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
            window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' })
          }
        })

        update()
      })()
    </script>

    <script is:inline>
      // ── Experiência de leitura: lightbox de imagens do artigo ──
      (function () {
        var lightbox = null
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        function makeLightbox() {
          // Em navegação SPA o overlay anterior pode ter sido removido do DOM;
          // recria se a referência estiver desconectada.
          if (lightbox && lightbox.isConnected) return
          if (lightbox) lightbox.remove()
          lightbox = document.createElement('div')
          lightbox.className = 'img-lightbox'
          lightbox.setAttribute('role', 'dialog')
          lightbox.setAttribute('aria-modal', 'true')
          lightbox.setAttribute('aria-label', 'Imagem ampliada')
          lightbox.innerHTML = '<button type="button" class="img-lightbox-close" aria-label="Fechar imagem">✕</button>'
          document.body.appendChild(lightbox)
          lightbox.addEventListener('click', close)
          lightbox.querySelector('.img-lightbox-close').addEventListener('click', function (e) {
            e.stopPropagation()
            close()
          })
        }

        function open(src, alt) {
          makeLightbox()
          var img = lightbox.querySelector('img')
          if (img) img.remove()
          img = document.createElement('img')
          img.src = src
          img.alt = alt || ''
          img.loading = 'eager'
          lightbox.appendChild(img)
          lightbox.classList.add('open')
          document.body.style.overflow = 'hidden'
        }

        function close() {
          if (!lightbox) return
          lightbox.classList.remove('open')
          document.body.style.overflow = ''
        }

        function initImages() {
          document.querySelectorAll('.article-content img, .recipe-description img').forEach(function (img) {
            if (img.classList.contains('zoomable')) return
            if (!img.src) return
            img.classList.add('zoomable')
            img.setAttribute('title', 'Clique para ampliar')
            img.addEventListener('click', function () {
              open(img.src, img.alt || '')
            })
          })
        }

        document.addEventListener('astro:page-load', initImages)
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') close()
        })
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initImages)
        } else {
          initImages()
        }
      })()
    </script>

    <Header transition:persist="site-header" />
    <main id="main-content" tabindex="-1" transition:name={transitionName} transition:animate="fade">
      <slot />
    </main>
    <Footer transition:persist="site-footer" />
    
    <CookieConsent />
    <PwaInstallPrompt client:visible />
    <SearchModal client:load />
    {!hideAiAssistant && <AIFloatingWidget client:load />}

    {!disableTransitions && (
      <script is:inline>
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.style.setProperty('--page-transition-duration', '350ms')
        })

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {})
          })
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault()
          window.__deferredPrompt = e
          window.dispatchEvent(new CustomEvent('pwa-install-ready'))
        })

        window.addEventListener('appinstalled', () => {
          window.__deferredPrompt = null
          window.dispatchEvent(new CustomEvent('pwa-installed'))
        })

        document.addEventListener('astro:after-swap', () => {
          const main = document.getElementById('main-content')
          if (main && !main.hasAttribute('tabindex')) {
            main.setAttribute('tabindex', '-1')
          }
        })
      </script>
    )}
  </body>
</html>