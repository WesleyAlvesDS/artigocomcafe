---
import '../styles/global.css'
import '../styles/hero.css'
import '../styles/ai-widget.css'
import TopBar from '../components/TopBar.astro'
import LeftSidebar from '../components/LeftSidebar.astro'
import RightSidebar from '../components/RightSidebar.astro'
import MaintenanceBar from '../components/MaintenanceBar.astro'
import Footer from '../components/Footer.astro'
import CookieConsent from '../components/CookieConsent.astro'
import ErrorBoundary from '../components/ErrorBoundary'
import PwaInstallPrompt from '../components/PwaInstallPrompt'
import SearchModal from '../components/SearchModal'
import AIFloatingWidget from '../components/AIFloatingWidget'
import ToastMount from '../components/ToastMount'
import { ClientRouter } from 'astro:transitions';
export interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
  canonical?: string
  breadcrumbs?: Array<{ name: string; slug: string }>
  disableTransitions?: boolean
  hideAiAssistant?: boolean
  transitionName?: string
  editorial?: boolean
  robots?: string
  sidebar?: boolean
  showLogin?: boolean
  fullWidth?: boolean
}

const {
  title = 'Artigo com Café — Blog de Cafeteria Digital',
  description = 'Artigo com Café — um ambiente de leitura aberto a todos, onde o café é uma analogia do acolhimento. Artigos, receitas, biblioteca e conhecimento para ler com calma.',
  image = '/images/og-default.svg',
  type = 'website',
  canonical,
  breadcrumbs = [],
  disableTransitions = false,
  hideAiAssistant = false,
  transitionName = 'page-root',
  editorial = true,
  robots = 'index, follow',
  sidebar = false,
  showLogin = false,
  fullWidth = false,
} = Astro.props

const siteUrl = 'https://artigocomcafe.com'
const fullTitle = title.includes('Artigo com Café') ? title : `${title} — Artigo com Café`
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl
const ogImage = image.startsWith('http')
  ? image
  : image.endsWith('.png.ts')
    ? `${siteUrl}${image.replace('.ts', '')}`
    : `${siteUrl}${image}`

const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': crumb.name,
    'item': `${siteUrl}${crumb.slug}`
  }))
} : null

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Artigo com Café',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`,
  'description': 'Plataforma de conhecimento onde o café é a analogia de um ambiente de leitura aberto a todos. Cultura, tecnologia e experiências de aprendizado em torno de cada xícara.'
}
---

<!doctype html>
<html lang="pt-BR" data-ecpn="ryhkx4gd?key=1c1fb12053a54c089ff2c5a6c46c3ef1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0805" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="robots" content={robots} />

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Café" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Café" />

    <meta name="apple-mobile-web-app-status-bar" content="black-translucent" />

    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Artigo com Café" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Artigo com Café - Feed RSS" href="/feed.xml" />
    <meta name="google-adsense-account" content="ca-pub-4516147510474933" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4516147510474933"
     crossorigin="anonymous"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fontes carregadas de forma NÃO bloqueante (media=print onload): o texto
        renderiza com fallback imediatamente e troca para a fonte real quando
        baixar (display=swap). Reduz o tempo até a primeira pintura. */}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..500&family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..500&family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..500&family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" /></noscript>

    <link rel="preconnect" href="https://back.artigocomcafe.com" crossorigin />
    <link rel="dns-prefetch" href="https://back.artigocomcafe.com" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#d4a373" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="msapplication-TileColor" content="#0a0805" />
    <meta name="msapplication-TileImage" content="/favicon-144x144.png" />
    <meta name="msapplication-config" content="none" />

    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.__enableAnalytics = function() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TMDJNM49Q6';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-TMDJNM49Q6');
      };
      (function() {
        try {
          var consent = JSON.parse(localStorage.getItem('cookie-consent') || 'null');
          if (consent && consent.analytics) window.__enableAnalytics();
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://www.effectivecpmnetwork.com">

    {!disableTransitions && (
      <>
        <meta name="astro-view-transitions-enabled" content="true" />
        <ClientRouter fallback="animate" />
      </>
    )}

    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                    transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

      [data-reveal].revealed {
        opacity: 1;
        transform: translateY(0);
      }

    </style>
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body data-api-base="https://back.artigocomcafe.com/api" class:list={[editorial && 'body-editorial']}>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo</a>

    {/* Botão voltar-ao-topo com anel de progresso de leitura */}
    <button id="back-to-top" class="back-to-top" type="button" aria-label="Voltar ao topo da página" title="Voltar ao topo">
      <svg width="30" height="30" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="btt-ring-bg" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.25" />
        <circle class="btt-ring-fg" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" transform="rotate(-90 24 24)" />
        <polyline points="18 28 24 22 30 28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme')
        if (theme === 'light') { document.documentElement.classList.add('light') }
        else if (theme === 'dark' || !window.matchMedia('(prefers-color-scheme: light)').matches) { document.documentElement.classList.remove('light') }
        else { document.documentElement.classList.add('light') }
      })()
    </script>

    <script>
      import { initScrollReveal } from '../scripts/scroll-reveal';
      import { initScrollProgress } from '../scripts/scroll-progress';
      import { initMicroInteractions } from '../scripts/micro-interactions';
      import { initBackToTop } from '../scripts/back-to-top';
      import { initSwipeNav } from '../scripts/swipe-nav';
      import { initLightbox } from '../scripts/lightbox';

      initScrollReveal();
      initScrollProgress();
      initMicroInteractions();
      initBackToTop();
      initSwipeNav();
      initLightbox();
    </script>

    <MaintenanceBar />
    <LeftSidebar />
    <TopBar />
    <div class:list={['app-shell', fullWidth && 'full-width']}>
      <main id="main-content" tabindex="-1" class="app-main" transition:name={transitionName} transition:animate="fade">
        <slot />
      </main>
      <RightSidebar />
    </div>
    <Footer />
    
    <CookieConsent />
    <ErrorBoundary name="PWA Install">
      <PwaInstallPrompt client:visible />
    </ErrorBoundary>
    <ErrorBoundary name="Search">
      <SearchModal client:idle />
    </ErrorBoundary>
    {!hideAiAssistant && (
      <ErrorBoundary name="AI Assistant">
        <AIFloatingWidget client:idle />
      </ErrorBoundary>
    )}
    <ErrorBoundary name="Toast">
      <ToastMount client:idle transition:persist="toast-mount" />
    </ErrorBoundary>

    {!disableTransitions && (
      <script is:inline>
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.style.setProperty('--page-transition-duration', '350ms')
        })
      </script>
    )}

    <script>
      import { initPwa } from '../scripts/pwa';
      initPwa();
    </script>

    <style>
      /* ═══════════════════════════════════════════════════════════════
         APP SHELL — Layout 3 Colunas (Facebook/Reddit Style)
         ═══════════════════════════════════════════════════════════════ */
      :root {
        --sidebar-left-width: 260px;
        --sidebar-right-width: 320px;
        --topbar-height: 56px;
      }

      /* Body ganha margem para o sidebar fixo */
      body {
        padding-left: var(--sidebar-left-width);
        padding-top: calc(var(--topbar-height) + var(--maintenance-bar-h, 0px));
        min-height: 100vh;
      }

      /* ═══ App Shell: feed central + sidebar direita ═══ */
      .app-shell {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem 3rem;
        min-height: calc(100vh - var(--topbar-height));
      }

      .app-main {
        flex: 1;
        max-width: 700px;
        min-width: 0;
      }

      /* ═══ Responsive ═══ */
      @media (max-width: 1200px) {
        :root {
          --sidebar-left-width: 72px;
        }
        .app-shell {
          padding: 1rem 1.25rem 3rem;
        }
      }

      @media (max-width: 900px) {
        .app-shell {
          padding: 1rem 1rem 2rem;
        }
      }

      @media (max-width: 768px) {
        :root {
          --sidebar-left-width: 0px;
          --topbar-height: 52px;
        }
        body {
          padding-left: 0;
        }
        .app-shell {
          padding: 0.75rem 0.75rem 2rem;
          gap: 0;
        }
      }

      @media (max-width: 640px) {
        .app-shell {
          padding: 0.5rem 0.5rem 2rem;
        }
      }

      /* ═══ Fix para páginas que usam largura total ═══ */
      .app-shell.full-width .app-main {
        max-width: none;
      }
    </style>
  </body>
</html>