---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import CookieConsent from '../components/CookieConsent.astro'
import PwaInstallPrompt from '../components/PwaInstallPrompt'
import SearchModal from '../components/SearchModal'
import AIFloatingWidget from '../components/AIFloatingWidget'

export interface Props {
  title?: string
  description?: string
  image?: string
  type?: string
  canonical?: string
  breadcrumbs?: Array<{ name: string; slug: string }>
  disableTransitions?: boolean
}

const {
  title = 'Artigo com Café — Blog de Cafeteria Digital',
  description = 'Blog autoral sobre o universo do café: cultura, história e conhecimento. Conteúdo aprofundado para quem ama aprender e se inspirar.',
  image = '/images/og-default.svg',
  type = 'website',
  canonical,
  breadcrumbs = [],
  disableTransitions = false
} = Astro.props

const siteUrl = 'https://artigocomcafe.com'
const fullTitle = title.includes('Artigo com Café') ? title : `${title} — Artigo com Café`
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl
// Dynamic OG image: if image path ends with .png.ts or is og-default, rewrite
// Otherwise use the provided image as-is (supports external URLs and local paths)
const ogImage = image.startsWith('http') 
  ? image 
  : image.endsWith('.png.ts') 
    ? `${siteUrl}${image.replace('.ts', '')}`
    : `${siteUrl}${image}`

// Build breadcrumb JSON-LD
const breadcrumbJsonLd = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': crumb.name,
    'item': `${siteUrl}${crumb.slug}`
  }))
} : null

// Organization JSON-LD (present on all pages)
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Artigo com Café',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`,
  'description': 'Plataforma de conhecimento sobre café. Cultura, tecnologia e experiências de aprendizado em torno de cada xícara.'
}
---

<!doctype html>
<html lang="pt-BR" data-ecpn="ryhkx4gd?key=1c1fb12053a54c089ff2c5a6c46c3ef1">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0805" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="robots" content="index, follow" />

    <!-- iOS PWA Support -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Café" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Café" />

    <!-- PWA Status Bar -->
    <meta name="apple-mobile-web-app-status-bar" content="black-translucent" />

    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Artigo com Café" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Artigo com Café - Feed RSS" href="/feed.xml" />
    <meta name="google-adsense-account" content="ca-pub-4516147510474933" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=JetBrains+Mono:wght@400..500&display=swap" rel="stylesheet" />

    <!-- API / imagens dos artigos -->
    <link rel="preconnect" href="https://back.artigocomcafe.com" crossorigin />
    <link rel="dns-prefetch" href="https://back.artigocomcafe.com" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#d4a373" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Windows Tiles -->
    <meta name="msapplication-TileColor" content="#0a0805" />
    <meta name="msapplication-TileImage" content="/favicon-144x144.png" />
    <meta name="msapplication-config" content="none" />

    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.__enableAnalytics = function() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TMDJNM49Q6';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-TMDJNM49Q6');
      };
      (function() {
        try {
          var consent = JSON.parse(localStorage.getItem('cookie-consent') || 'null');
          if (consent && consent.analytics) window.__enableAnalytics();
        } catch (e) {}
      })();
    </script>

    <!-- Effective CPM Network (publisher key on <html>) -->
    <link rel="preconnect" href="https://www.effectivecpmnetwork.com">

    {!disableTransitions && (
      <meta name="astro-view-transitions-enabled" content="true" />
    )}

    <style is:inline>
      /* Skip-to-content link - hidden until focused */
      .skip-to-content {
        position: fixed;
        top: -100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10000;
        padding: 0.75rem 1.5rem;
        background: var(--color-accent);
        color: var(--color-btn-text);
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 0 0 12px 12px;
        text-decoration: none;
        transition: top 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .skip-to-content:focus {
        top: 0;
      }

      /* Smooth view transitions */
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      /* Focus visible for keyboard navigation */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* Smooth reveal animation guard */
      [data-reveal] {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                    transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }

[data-reveal].revealed {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Floating AI Widget */
    .ai-floating-widget {
      position: fixed;
      z-index: 9999;
      width: 380px;
      max-height: 520px;
      background: var(--color-bg-primary);
      border: 1px solid var(--color-bg-card-border);
      border-radius: var(--radius-card-lg);
      box-shadow: 0 20px 60px rgba(0,0,0,0.3), 0 0 0 1px rgba(255,255,255,0.05);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s;
      transform: translateX(calc(100% + 20px)) scale(0.95);
      opacity: 0;
      pointer-events: none;
    }
    .ai-floating-widget.open {
      transform: translateX(0) scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    .ai-floating-minimized {
      position: fixed;
      z-index: 9998;
      transition: transform 0.2s;
    }

    .ai-floating-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      border: none;
      border-radius: 50px;
      color: var(--color-btn-text);
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      box-shadow: 0 8px 30px color-mix(in srgb, var(--color-accent) 40%, transparent);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .ai-floating-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 40px color-mix(in srgb, var(--color-accent) 50%, transparent);
    }
    .ai-badge {
      font-size: 0.65rem;
      padding: 0.1rem 0.4rem;
      border-radius: 100px;
      background: rgba(255,255,255,0.2);
      font-weight: 700;
    }

    .ai-floating-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      color: var(--color-btn-text);
      cursor: move;
    }
    .ai-floating-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .ai-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e;
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    .ai-floating-actions {
      display: flex;
      gap: 0.25rem;
    }
    .ai-floating-btn-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border: none;
      background: rgba(255,255,255,0.15);
      border-radius: 8px;
      color: var(--color-btn-text);
      cursor: pointer;
      transition: background 0.2s;
    }
    .ai-floating-btn-icon:hover {
      background: rgba(255,255,255,0.3);
    }

    .ai-floating-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .ai-floating-tabs {
      display: flex;
      background: var(--color-bg-card);
      border-bottom: 1px solid var(--color-bg-card-border);
    }
    .ai-floating-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.7rem;
      background: none;
      border: none;
      color: var(--color-text-muted);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      border-bottom: 2px solid transparent;
    }
    .ai-floating-tab:hover {
      color: var(--color-text-primary);
      background: var(--color-bg-card-hover);
    }
    .ai-floating-tab.active {
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }

    .ai-floating-panel {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
    }

    /* Chat Panel */
    .ai-chat-panel {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .ai-chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .ai-message {
      max-width: 85%;
      padding: 0.75rem 1rem;
      border-radius: 14px;
      font-size: 0.85rem;
      line-height: 1.6;
    }
    .ai-message-bot {
      align-self: flex-start;
      background: var(--color-bg-card);
      border: 1px solid var(--color-bg-card-border);
      border-bottom-left-radius: 4px;
    }
    .ai-message-content {
      white-space: pre-wrap;
    }
    .ai-message.loading .ai-typing {
      display: flex;
      gap: 3px;
    }
    .ai-typing span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-accent);
      animation: typing 1.4s infinite ease-in-out both;
    }
    .ai-typing span:nth-child(1) { animation-delay: -0.32s; }
    .ai-typing span:nth-child(2) { animation-delay: -0.16s; }
    @keyframes typing {
      0%, 80%, 100% { transform: scale(0); }
      40% { transform: scale(1); }
    }
    .ai-message-error {
      align-self: center;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #ef4444;
      text-align: center;
    }
    .ai-chat-input {
      display: flex;
      gap: 0.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-bg-card-border);
    }
    .ai-chat-input-field {
      flex: 1;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--color-bg-card-border);
      border-radius: 10px;
      background: var(--color-bg-card);
      color: var(--color-text-primary);
      font-size: 0.85rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .ai-chat-input-field:focus {
      border-color: var(--color-accent);
    }
    .ai-chat-send {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: none;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      border-radius: 10px;
      color: var(--color-btn-text);
      cursor: pointer;
      transition: transform 0.2s, opacity 0.2s;
    }
    .ai-chat-send:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .ai-chat-send:hover:not(:disabled) {
      transform: scale(1.05);
    }

    /* Tools Panel */
    .ai-tools-post-selector {
      margin-bottom: 1rem;
    }
    .ai-tools-post-selector label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      margin-bottom: 0.4rem;
    }
    .ai-select {
      width: 100%;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--color-bg-card-border);
      border-radius: 10px;
      background: var(--color-bg-card);
      color: var(--color-text-primary);
      font-size: 0.85rem;
      outline: none;
    }
    .ai-selected-post {
      margin-top: 0.5rem;
      padding: 0.5rem;
      background: color-mix(in srgb, var(--color-accent) 10%, transparent);
      border-radius: 8px;
      font-size: 0.8rem;
    }
    .ai-selected-post strong { display: block; color: var(--color-text-primary); }
    .ai-selected-post span { color: var(--color-text-muted); font-size: 0.7rem; }

    .ai-tools-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .ai-tool-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      padding: 0.75rem;
      border: 1px solid var(--color-bg-card-border);
      border-radius: 12px;
      background: var(--color-bg-card);
      color: var(--color-text-primary);
      font-size: 0.75rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }
    .ai-tool-btn:hover:not(:disabled) {
      border-color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      transform: translateY(-2px);
    }
    .ai-tool-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .ai-tool-icon { font-size: 1.25rem; }
    .ai-tool-name { text-align: center; }

    .ai-loading {
      text-align: center;
      padding: 1.5rem;
      color: var(--color-text-muted);
      font-size: 0.85rem;
    }
    .ai-error {
      margin-top: 1rem;
      padding: 0.75rem;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 8px;
      color: #ef4444;
      font-size: 0.8rem;
    }
    .ai-result {
      margin-top: 1rem;
      border: 1px solid var(--color-bg-card-border);
      border-radius: 12px;
      background: var(--color-bg-card);
      overflow: hidden;
    }
    .ai-result-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--color-bg-card-border);
    }
    .ai-close-result {
      background: none;
      border: none;
      color: var(--color-text-muted);
      font-size: 1.25rem;
      cursor: pointer;
      line-height: 1;
    }
    .ai-result-content {
      padding: 1rem;
      font-size: 0.8rem;
      line-height: 1.6;
      white-space: pre-wrap;
    }

    /* Posts Panel */
    .ai-posts-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--color-bg-card-border);
    }
    .ai-posts-count {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }
    .ai-posts-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-height: 300px;
      overflow-y: auto;
    }
    .ai-post-item {
      padding: 0.75rem;
      background: var(--color-bg-card);
      border: 1px solid var(--color-bg-card-border);
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .ai-post-item:hover {
      border-color: var(--color-accent);
      transform: translateX(4px);
    }
    .ai-post-title {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--color-text-primary);
      margin-bottom: 0.35rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ai-post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.7rem;
      color: var(--color-text-muted);
    }
    .ai-status {
      padding: 0.1rem 0.5rem;
      border-radius: 100px;
      font-weight: 600;
      text-transform: capitalize;
    }
    .ai-status-published { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
    .ai-status-draft { background: rgba(107, 114, 128, 0.15); color: #6b7280; }
    .ai-status-review { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .ai-status-scheduled { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .ai-status-archived { background: rgba(107, 114, 128, 0.15); color: #6b7280; }
    .ai-empty {
      text-align: center;
      padding: 2rem;
      color: var(--color-text-muted);
      font-size: 0.85rem;
    }

    @media (max-width: 480px) {
      .ai-floating-widget {
        width: calc(100vw - 32px);
        max-width: 100vw;
        left: 16px !important;
        right: 16px !important;
      }
    }
    </style>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body data-api-base="https://back.artigocomcafe.com/api">
    <div class="app-aurora" aria-hidden="true"></div>
    <div class="app-grid-overlay" aria-hidden="true"></div>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a href="#main-content" class="skip-to-content">
      Pular para o conteúdo
    </a>

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme')
        if (theme === 'light') {
          document.documentElement.classList.add('light')
        } else if (theme === 'dark' || !window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('light')
        } else {
          document.documentElement.classList.add('light')
        }
      })()
    </script>

    <script is:inline>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('revealed')
        })
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' })

      function revealAll() {
        document.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('revealed'))
      }

      function initReveal() {
        document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el))
        // Re-focus skip link target after page transition
        const main = document.getElementById('main-content')
        if (main && !main.hasAttribute('tabindex')) {
          main.setAttribute('tabindex', '-1')
        }
      }

      document.addEventListener('astro:page-load', initReveal)

      // Static site without ClientRouter: astro:page-load never fires on
      // first load, so observe right away once the DOM is ready.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal)
      } else {
        initReveal()
      }

      // Safety fallback: if the reveal animation script fails or the page
      // loads with JavaScript blocked/broken, force everything visible so
      // the site never stays "off"/hidden. Runs once after hydration window.
      window.addEventListener('load', () => {
        setTimeout(revealAll, 2500)
      })
    </script>

    <script is:inline>
      // Barra de progresso de scroll (usa transform via rAF, custo mínimo)
      (function () {
        var bar = document.getElementById('scroll-progress')
        if (!bar) return
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        var ticking = false
        function update() {
          var doc = document.documentElement
          var max = doc.scrollHeight - window.innerHeight
          var pct = max > 0 ? (window.pageYOffset / max) * 100 : 0
          bar.style.width = pct + '%'
          ticking = false
        }
        function request() {
          if (!ticking) { requestAnimationFrame(update); ticking = true }
        }
        window.addEventListener('scroll', request, { passive: true })
        window.addEventListener('resize', request, { passive: true })
        update()
      })()
    </script>

    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <CookieConsent />
    <PwaInstallPrompt client:visible />
    <SearchModal client:load />
    <AIFloatingWidget client:load />

    {!disableTransitions && (
      <script is:inline>
        // Add smooth page transition observer
        document.addEventListener('astro:before-swap', () => {
          document.documentElement.style.setProperty('--page-transition-duration', '300ms')
        })

        // Register service worker if supported
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {})
          })
        }

        // Detect PWA installability - store prompt on window for components
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault()
          window.__deferredPrompt = e
          window.dispatchEvent(new CustomEvent('pwa-install-ready'))
        })

        window.addEventListener('appinstalled', () => {
          window.__deferredPrompt = null
          window.dispatchEvent(new CustomEvent('pwa-installed'))
        })
      </script>
    )}
  </body>
</html>
